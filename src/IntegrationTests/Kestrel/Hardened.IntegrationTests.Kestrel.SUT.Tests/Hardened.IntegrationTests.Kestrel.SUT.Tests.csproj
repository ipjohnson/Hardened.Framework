<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3.mtp-off"/>
    </ItemGroup>

    <!--
      The application is referenced so it is built before these tests and in the same
      configuration, and nothing else: its output runs as a process of its own, not loaded here.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Hardened.IntegrationTests.Kestrel.SUT\Hardened.IntegrationTests.Kestrel.SUT.csproj"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
