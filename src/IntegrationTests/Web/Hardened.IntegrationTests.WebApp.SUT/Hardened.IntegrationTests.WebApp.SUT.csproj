<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <!-- A test fixture, not a shipped package. Without this it packs and
             publishes to the feed on every main build. -->
        <IsPackable>false</IsPackable>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DependencyModules_AutoGenerateModule>false</DependencyModules_AutoGenerateModule>

        <!-- Writes what the generators emitted to obj/…/generated, so the routing table and the
             per-handler classes can be read directly. This app exercises the widest set of
             generator features in the repository, which makes it the useful one to inspect. -->
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  
    <!--
      Deliberately not set. The doc comments on this project's handlers reach its published document
      either way - XmlDocumentation falls back to reading the raw /// trivia where the parse options
      did not build structured trivia - and this project is the test that it does.
    -->
  </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="DependencyModules_AutoGenerateModule"/>
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj" />
      <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj" />
      <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Caching.Memory\Hardened.Requests.Caching.Memory.csproj" />
      <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Testing\Hardened.Requests.Testing.csproj" />
      <ProjectReference Include="..\..\..\Shared\Hardened.Shared.Runtime\Hardened.Shared.Runtime.csproj" />
      <ProjectReference Include="..\..\..\SourceGenerators\Hardened.Library.SourceGenerator\Hardened.Library.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
      <ProjectReference Include="..\..\..\SourceGenerators\Hardened.Web.SourceGenerator\Hardened.Web.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
      <ProjectReference Include="..\..\..\SourceGenerators\Hardened.Validation.SourceGenerator\Hardened.Validation.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
      <ProjectReference Include="..\..\..\Web\Hardened.Web.AspNetCore.Runtime\Hardened.Web.AspNetCore.Runtime.csproj" />
      <ProjectReference Include="..\..\..\Web\Hardened.Web.Runtime\Hardened.Web.Runtime.csproj" />
      <ProjectReference Include="..\Hardened.IntegrationTests.Web.SUT\Hardened.IntegrationTests.Web.SUT.csproj" />
      <ProjectReference Include="..\..\..\SourceGenerators\Hardened.DependencyModules.SourceGenerator\Hardened.DependencyModules.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Views\" />
    </ItemGroup>

    <!--
        The document export, in-repo. <HardenedOpenApiOutput> writes the document this application
        serves to a tracked file after every compile, which is what the export tests compare against
        /openapi.json and what a client generator reads. The package does this through
        build/*.targets; here the task assembly is the one this build produces, selected on
        $(MSBuildRuntimeType) as the package's targets select it, and the ProjectReference only
        orders the build.
    -->
    <PropertyGroup>
        <HardenedOpenApiOutput>openapi/Application.json</HardenedOpenApiOutput>
        <_HardenedOpenApiDocumentTaskTfm Condition="'$(MSBuildRuntimeType)' == 'Core'">net8.0</_HardenedOpenApiDocumentTaskTfm>
        <_HardenedOpenApiDocumentTaskTfm Condition="'$(MSBuildRuntimeType)' != 'Core'">net472</_HardenedOpenApiDocumentTaskTfm>
        <HardenedOpenApiDocumentTaskAssembly>$(MSBuildThisFileDirectory)..\..\..\SourceGenerators\Hardened.OpenApiDocument.BuildTask\bin\$(Configuration)\$(_HardenedOpenApiDocumentTaskTfm)\Hardened.OpenApiDocument.BuildTask.dll</HardenedOpenApiDocumentTaskAssembly>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\SourceGenerators\Hardened.OpenApiDocument.BuildTask\Hardened.OpenApiDocument.BuildTask.csproj"
                          ReferenceOutputAssembly="false"
                          SetTargetFramework="TargetFramework=$(_HardenedOpenApiDocumentTaskTfm)"/>
    </ItemGroup>

    <!-- The package carries this in build/, which a ProjectReference to the generator does not
         import; the fixture imports it from the task's own project instead. -->
    <Import Project="..\..\..\SourceGenerators\Hardened.OpenApiDocument.BuildTask\Package\Hardened.OpenApiDocument.targets"/>

</Project>
