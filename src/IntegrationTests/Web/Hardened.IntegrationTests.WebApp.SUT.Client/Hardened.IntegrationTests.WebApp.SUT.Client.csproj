<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The generated client for the Web integration application, and the proof that the document the
    export writes is one a client generator can consume. There is no hand-written code here: Kiota
    writes the client from ../Hardened.IntegrationTests.WebApp.SUT/openapi/Application.json - the
    tracked file the application's build wrote from what it serves - into obj/ on every build that
    needs it, and this project compiles that output. Nothing generated is committed.

    The MSBuild is the hardened-web template's src/Hardened1.Client project with the names
    changed, deliberately: what the template ships is what runs here, against the application that
    carries the widest route surface in the repository, and GeneratedClientTests in the test
    project next door drive the result through the pipeline. The diagnostic codes are the
    template's for the same reason. A test fixture, not a package, so the rule that no Hardened
    package names a generator holds.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Hardened.IntegrationTests.WebApp.SUT.Client</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>false</IsPackable>

    <!--
      The Kiota runtime the generated client compiles against. Pinned beside the tool that
      generates it - microsoft.openapi.kiota in the repository's .config/dotnet-tools.json - and
      the two move together, with the template's pair: the generated code and the runtime come
      from matching Kiota releases, and CheckKiotaPins below fails naming both when they disagree.
      scripts/verify-templates.sh holds all four to one release.
    -->
    <KiotaBundleVersion>2.0.0</KiotaBundleVersion>

    <KiotaSpec>../Hardened.IntegrationTests.WebApp.SUT/openapi/Application.json</KiotaSpec>
    <KiotaToolManifest>$(MSBuildThisFileDirectory)../../../../.config/dotnet-tools.json</KiotaToolManifest>

    <!--
      Under obj/, and spelled with BaseIntermediateOutputPath rather than IntermediateOutputPath:
      the latter is set by the SDK's targets, which are imported after this file, so it is still
      empty here and the client would land beside the csproj. Output in the project folder is
      also the wrong place for another reason - the SDK's **/*.cs glob is evaluated before any
      target runs, so files a target writes into the folder are missed on the first build and
      compiled twice on the second. IncludeClient below adds them inside a target instead.
    -->
    <KiotaOutput>$(BaseIntermediateOutputPath)kiota/</KiotaOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="$(KiotaBundleVersion)" />

    <!--
      Ordering only: the application's build writes the document this project reads, so it has to
      build first. ReferenceOutputAssembly="false" keeps the application, and its host with it,
      out of the client.
    -->
    <ProjectReference Include="../Hardened.IntegrationTests.WebApp.SUT/Hardened.IntegrationTests.WebApp.SUT.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!--
    The tool is restored inside the build, which is what lets a fresh clone build with no
    instruction beyond `dotnet build`. It is idempotent and fast once the package is cached; the
    first restore on a machine needs network, and .config/dotnet-tools.json holds the pin.
  -->
  <Target Name="RestoreKiota" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet tool restore"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="low"
          ContinueOnError="true"
          EnvironmentVariables="DOTNET_NOLOGO=1">
      <Output TaskParameter="ExitCode" PropertyName="_KiotaRestoreExitCode" />
    </Exec>

    <Error Condition="'$(_KiotaRestoreExitCode)' != '0'"
           Code="HTPL002"
           Text="The Kiota tool could not be restored, so the client cannot be generated. The pin is microsoft.openapi.kiota in .config/dotnet-tools.json; a fresh machine needs network for the first restore, and `dotnet tool restore` in the repository root shows what NuGet said." />
  </Target>

  <!--
    The two pins have to agree. `kiota info` reports the bundle version the tool expects, so a
    bump of one without the other is caught here rather than as a compile error inside generated
    code. Both pin files are inputs of the generate target below, so changing either runs this again.
  -->
  <Target Name="CheckKiotaPins" DependsOnTargets="RestoreKiota" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet kiota info --language CSharp --json"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          EnvironmentVariables="KIOTA_OFFLINE_ENABLED=true;KIOTA_TUTORIAL_ENABLED=false;DOTNET_NOLOGO=1">
      <Output TaskParameter="ConsoleOutput" PropertyName="_KiotaInfo" />
    </Exec>

    <PropertyGroup>
      <_KiotaExpectedBundle>$([System.Text.RegularExpressions.Regex]::Replace('$(_KiotaInfo)', '(?s)^.*?"Microsoft\.Kiota\.Bundle"[^0-9]*?([0-9][0-9A-Za-z.\-]*).*$', '$1'))</_KiotaExpectedBundle>
    </PropertyGroup>

    <Error Condition="'$(_KiotaExpectedBundle)' != '$(KiotaBundleVersion)'"
           Code="HTPL003"
           Text="The Kiota tool and the Kiota bundle disagree: microsoft.openapi.kiota in .config/dotnet-tools.json expects Microsoft.Kiota.Bundle $(_KiotaExpectedBundle), and KiotaBundleVersion in $(MSBuildProjectFile) is $(KiotaBundleVersion). The two move together; set both to one Kiota release." />
  </Target>

  <!--
    kiota-lock.json is Kiota's own record of the generation and doubles as the up-to-date stamp:
    an unchanged document skips this, a changed one - or a changed pin - runs it. The output is
    cleaned first because it is nobody's but Kiota's; backward-compatible members are excluded
    because a new client has nothing to be compatible with; and the log level is warning so a
    code-first document with no server entry, which Kiota mentions, does not fail a warning-free
    build. Kiota's own warning lines are shown, not counted, for the same reason.
  -->
  <Target Name="GenerateClient"
          DependsOnTargets="RestoreKiota;CheckKiotaPins"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(KiotaSpec);$(KiotaToolManifest);$(MSBuildProjectFullPath)"
          Outputs="$(KiotaOutput)kiota-lock.json">
    <Exec Command="dotnet kiota generate --language CSharp --openapi &quot;$(KiotaSpec)&quot; --class-name WebAppClient --namespace-name $(RootNamespace) --output &quot;$(KiotaOutput)&quot; --clean-output --exclude-backward-compatible --log-level warning"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"
          EnvironmentVariables="KIOTA_OFFLINE_ENABLED=true;KIOTA_TUTORIAL_ENABLED=false;DOTNET_NOLOGO=1" />
  </Target>

  <!--
    Added inside a target, after generation, for the glob reason above. Runs after GenerateClient
    whether or not that target had anything to do, so an up-to-date client is still compiled.
  -->
  <Target Name="IncludeClient" AfterTargets="GenerateClient" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(KiotaOutput)**/*.cs" />
    </ItemGroup>
  </Target>

  <Target Name="CleanClient" AfterTargets="CoreClean">
    <RemoveDir Directories="$(KiotaOutput)" />
  </Target>

</Project>
