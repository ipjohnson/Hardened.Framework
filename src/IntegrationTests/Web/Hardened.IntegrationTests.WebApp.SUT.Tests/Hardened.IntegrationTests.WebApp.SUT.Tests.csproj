<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\Web\Hardened.Web.Testing\Hardened.Web.Testing.csproj" />
      <ProjectReference Include="..\Hardened.IntegrationTests.WebApp.SUT\Hardened.IntegrationTests.WebApp.SUT.csproj" />
      <!-- The Kiota client generated from the exported document, driven through the pipeline in
           Transport/GeneratedClientTests. -->
      <ProjectReference Include="..\Hardened.IntegrationTests.WebApp.SUT.Client\Hardened.IntegrationTests.WebApp.SUT.Client.csproj" />
      <!-- The two client testing packages: the route that builds each kind of client for a test
           parameter, and Returns<T>() over it. Transport/KiotaReturnsTests and RefitReturnsTests. -->
      <ProjectReference Include="..\..\..\Clients\Hardened.Kiota.Testing\Hardened.Kiota.Testing.csproj" />
      <ProjectReference Include="..\..\..\Clients\Hardened.Refit.Testing\Hardened.Refit.Testing.csproj" />
          <!-- The runner: [HardenedTest] and the running-test seam, for xUnit. -->
      <ProjectReference Include="..\..\..\Shared\Hardened.Shared.Testing.xUnit\Hardened.Shared.Testing.xUnit.csproj"/>
          <!-- The Kestrel test host: [KestrelHost] on the socket smoke tests. -->
      <ProjectReference Include="..\..\..\Web\Hardened.Web.Kestrel.Testing\Hardened.Web.Kestrel.Testing.csproj" />
      <!-- The ASP.NET Core test host: [AspNetCoreHost] on the socket smoke tests. -->
      <ProjectReference Include="..\..\..\Web\Hardened.Web.AspNetCore.Testing\Hardened.Web.AspNetCore.Testing.csproj" />
    </ItemGroup>

    <!--
        The document the application's build exported, beside the tests that compare it with the
        one the application serves. Copied at build time, which is after the application built and
        wrote it; the indented-JSON writer is linked in so the comparison is against the same
        indentation the export task applied rather than against a second writer's idea of it.
    -->
    <ItemGroup>
        <Content Include="..\Hardened.IntegrationTests.WebApp.SUT\openapi\Application.json" Link="openapi\Application.json" CopyToOutputDirectory="PreserveNewest" Visible="false"/>
        <Compile Include="..\..\..\SourceGenerators\Hardened.Generation.Shared\Document\JsonTree.cs" Link="Document\JsonTree.cs"/>
        <Compile Include="..\..\..\SourceGenerators\Hardened.Generation.Shared\Document\JsonTreeWriter.cs" Link="Document\JsonTreeWriter.cs"/>
    </ItemGroup>

</Project>
