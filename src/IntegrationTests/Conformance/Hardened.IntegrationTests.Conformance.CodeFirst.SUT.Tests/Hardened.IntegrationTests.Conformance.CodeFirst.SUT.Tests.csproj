<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Web\Hardened.Web.Testing\Hardened.Web.Testing.csproj"/>
        <ProjectReference Include="..\Hardened.IntegrationTests.Conformance.CodeFirst.SUT\Hardened.IntegrationTests.Conformance.CodeFirst.SUT.csproj"/>
          <!-- [ModuleTest] and the running-test seam, for xUnit v3. -->
      <ProjectReference Include="..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit\DependencyModules.xUnit.csproj"
                        Condition="Exists('..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit\DependencyModules.xUnit.csproj')"/>
      <PackageReference Include="DependencyModules.xUnit"
                        Condition="!Exists('..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit\DependencyModules.xUnit.csproj')"/>
    </ItemGroup>

    <!-- See the remarks on PetstoreConformanceTests for why this is linked source and not a
         ProjectReference to a shared assembly. -->
    <ItemGroup>
        <Compile Include="..\Shared\*.cs" Link="Conformance\%(FileName)%(Extension)"/>
    </ItemGroup>

</Project>
