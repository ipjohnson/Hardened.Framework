<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Web\Hardened.Web.Testing\Hardened.Web.Testing.csproj"/>
        <ProjectReference Include="..\Hardened.IntegrationTests.Conformance.CodeFirst.SUT\Hardened.IntegrationTests.Conformance.CodeFirst.SUT.csproj"/>
          <!-- The runner: [HardenedTest] and the running-test seam, for xUnit. -->
      <ProjectReference Include="..\..\..\Shared\Hardened.Shared.Testing.xUnit\Hardened.Shared.Testing.xUnit.csproj"/>
    </ItemGroup>

    <!-- See the remarks on PetstoreConformanceTests for why this is linked source and not a
         ProjectReference to a shared assembly. -->
    <ItemGroup>
        <Compile Include="..\Shared\*.cs" Link="Conformance\%(FileName)%(Extension)"/>
    </ItemGroup>

</Project>
