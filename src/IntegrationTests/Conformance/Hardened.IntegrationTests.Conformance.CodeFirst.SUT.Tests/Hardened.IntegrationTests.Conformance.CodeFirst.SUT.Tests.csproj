<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Web\Hardened.Web.Testing\Hardened.Web.Testing.csproj"/>
        <ProjectReference Include="..\Hardened.IntegrationTests.Conformance.CodeFirst.SUT\Hardened.IntegrationTests.Conformance.CodeFirst.SUT.csproj"/>
          <!-- [ModuleTest] and the running-test seam, for xunit.v3 4.x. -->
      <ProjectReference Include="..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj"
                        Condition="Exists('..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj')"/>
      <PackageReference Include="DependencyModules.xUnit4"
                        Condition="!Exists('..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj')"/>
    </ItemGroup>

    <!-- See the remarks on PetstoreConformanceTests for why this is linked source and not a
         ProjectReference to a shared assembly. -->
    <ItemGroup>
        <Compile Include="..\Shared\*.cs" Link="Conformance\%(FileName)%(Extension)"/>
    </ItemGroup>

</Project>
