{
  "openapi": "3.2.0",
  "info": {
    "title": "Pet Store",
    "version": "2024-01-01"
  },
  "tags": [
    {
      "name": "Bank"
    },
    {
      "name": "PetStore"
    }
  ],
  "paths": {
    "/": {
      "post": {
        "tags": [
          "Bank"
        ],
        "operationId": "getBalance",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetBalanceInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/x-amz-json-1.0": {
                "schema": {
                  "$ref": "#/components/schemas/GetBalanceOutput"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountNotFound"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Bank"
        ],
        "operationId": "transfer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/x-amz-json-1.0": {
                "schema": {
                  "$ref": "#/components/schemas/TransferOutput"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountNotFound"
                }
              }
            }
          }
        }
      }
    },
    "/pets": {
      "get": {
        "tags": [
          "PetStore"
        ],
        "operationId": "listPets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "dog",
                "cat",
                "other"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListPetsOutput"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "PetStore"
        ],
        "operationId": "createPet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePetInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "description": "Where the created pet can be read. Bound to a header, so it leaves the body.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePetOutput"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetNotFound"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pets/secured": {
      "get": {
        "tags": [
          "PetStore"
        ],
        "operationId": "getSecuredPet",
        "description": "Requires an authenticated caller.",
        "security": [
          {
            "httpBearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSecuredPetOutput"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "headers": {
              "WWW-Authenticate": {
                "description": "The challenge naming the scheme to authenticate with.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "tags": [
          "PetStore"
        ],
        "operationId": "getPet",
        "description": "Fetch one pet by id.",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          {
            "name": "verbose",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "X-Trace-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPetOutput"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetNotFound"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Throttled"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountNotFound": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "__type": {
            "type": "string",
            "default": "com.example.bank#AccountNotFound",
            "description": "The shape id identifying this error, as the protocol requires."
          }
        },
        "required": [
          "message"
        ]
      },
      "Attribute": {
        "type": "object"
      },
      "CreatePetInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "$ref": "#/components/schemas/PetKind"
          },
          "tags": {
            "type": [
              "string",
              "null"
            ]
          },
          "birthday": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "photo_bytes": {
            "type": [
              "string",
              "null"
            ],
            "format": "byte"
          }
        },
        "required": [
          "name"
        ]
      },
      "CreatePetOutput": {
        "type": "object",
        "properties": {
          "pet": {
            "$ref": "#/components/schemas/Pet"
          },
          "location": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the created pet can be read. Bound to a header, so it leaves the body."
          }
        },
        "required": [
          "pet"
        ]
      },
      "ErrorModel": {
        "type": "object",
        "description": "How a refused or failed request is answered when the contract declared no body for it.",
        "required": [
          "type",
          "message",
          "details"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      },
      "GetBalanceInput": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          }
        },
        "required": [
          "accountId"
        ]
      },
      "GetBalanceOutput": {
        "type": "object",
        "properties": {
          "balanceCents": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "balanceCents"
        ]
      },
      "GetPetOutput": {
        "type": "object",
        "properties": {
          "pet": {
            "$ref": "#/components/schemas/Pet"
          }
        },
        "required": [
          "pet"
        ]
      },
      "GetSecuredPetOutput": {
        "type": "object",
        "properties": {
          "pet": {
            "$ref": "#/components/schemas/Pet"
          }
        },
        "required": [
          "pet"
        ]
      },
      "ListPetsOutput": {
        "type": "object",
        "properties": {
          "pets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pet"
            }
          },
          "nextToken": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "pets"
        ]
      },
      "Pet": {
        "type": "object",
        "description": "A pet.",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PetKind"
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ]
          },
          "attributes": {
            "$ref": "#/components/schemas/Attribute"
          },
          "metadata": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "PetKind": {
        "type": "string",
        "enum": [
          "dog",
          "cat",
          "other"
        ]
      },
      "PetNotFound": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "RequestValidationError": {
        "type": "object",
        "description": "How a request that failed validation is answered.",
        "required": [
          "type",
          "message",
          "errors"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "code",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Throttled": {
        "type": "object",
        "properties": {
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryAfterSeconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "TransferInput": {
        "type": "object",
        "properties": {
          "fromAccount": {
            "type": "string"
          },
          "toAccount": {
            "type": "string"
          },
          "amountCents": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "required": [
          "fromAccount",
          "toAccount",
          "amountCents"
        ]
      },
      "TransferOutput": {
        "type": "object",
        "properties": {
          "transferId": {
            "type": "string"
          }
        },
        "required": [
          "transferId"
        ]
      }
    },
    "securitySchemes": {
      "httpBearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
