{
  "openapi": "3.2.0",
  "info": {
    "title": "Pet Store",
    "version": "2024-01-01"
  },
  "tags": [
    {
      "name": "Bank"
    },
    {
      "name": "PetStore"
    }
  ],
  "paths": {
    "/": {
      "post": {
        "tags": [
          "Bank"
        ],
        "operationId": "GetBalance",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-amz-json-1.0": {
              "schema": {
                "$ref": "#/components/schemas/GetBalanceInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/x-amz-json-1.0": {
                "schema": {
                  "$ref": "#/components/schemas/GetBalanceOutput"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/x-amz-json-1.0": {
                "schema": {
                  "$ref": "#/components/schemas/AccountNotFound"
                }
              }
            }
          },
          "415": {
            "description": "The request body is in a media type or content coding this operation does not read.",
            "headers": {
              "Accept": {
                "description": "The media types this operation reads, when the Content-Type was refused.",
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Encoding": {
                "description": "The content codings this operation decodes, when the Content-Encoding was refused.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/x-amz-json-1.0": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Bank"
        ],
        "operationId": "Transfer",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-amz-json-1.0": {
              "schema": {
                "$ref": "#/components/schemas/TransferInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/x-amz-json-1.0": {
                "schema": {
                  "$ref": "#/components/schemas/TransferOutput"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/x-amz-json-1.0": {
                "schema": {
                  "$ref": "#/components/schemas/AccountNotFound"
                }
              }
            }
          },
          "415": {
            "description": "The request body is in a media type or content coding this operation does not read.",
            "headers": {
              "Accept": {
                "description": "The media types this operation reads, when the Content-Type was refused.",
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Encoding": {
                "description": "The content codings this operation decodes, when the Content-Encoding was refused.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/x-amz-json-1.0": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/pets": {
      "get": {
        "tags": [
          "PetStore"
        ],
        "operationId": "ListPets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "dog",
                "cat",
                "other"
              ]
            }
          },
          {
            "name": "nextToken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListPetsOutput"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "PetStore"
        ],
        "operationId": "CreatePet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePetInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "description": "Where the created pet can be read. Bound to a header, so it leaves the body.",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePetOutput"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetNotFound"
                }
              }
            }
          },
          "415": {
            "description": "The request body is in a media type or content coding this operation does not read.",
            "headers": {
              "Accept": {
                "description": "The media types this operation reads, when the Content-Type was refused.",
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Encoding": {
                "description": "The content codings this operation decodes, when the Content-Encoding was refused.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/pets/secured": {
      "get": {
        "tags": [
          "PetStore"
        ],
        "operationId": "GetSecuredPet",
        "description": "Requires an authenticated caller.",
        "security": [
          {
            "httpBearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSecuredPetOutput"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "headers": {
              "WWW-Authenticate": {
                "description": "The challenge naming the scheme to authenticate with.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "tags": [
          "PetStore"
        ],
        "operationId": "GetPet",
        "description": "Fetch one pet by id.",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          {
            "name": "verbose",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "X-Trace-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPetOutput"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetNotFound"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Throttled"
                }
              }
            }
          },
          "504": {
            "description": "The operation did not finish inside its budget.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        },
        "x-hardened-timeout": 2000
      }
    },
    "/pets/{petId}/events": {
      "get": {
        "tags": [
          "PetStore"
        ],
        "operationId": "PetEvents",
        "description": "The pet's history, one event at a time.",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PetEventStream"
                  }
                },
                "itemSchema": {
                  "$ref": "#/components/schemas/PetEventStream"
                }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}/photo": {
      "put": {
        "tags": [
          "PetStore"
        ],
        "operationId": "PutPetPhoto",
        "description": "Replaces a pet's photo, sent as the whole request body.",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PutPetPhotoOutput"
                }
              }
            }
          },
          "415": {
            "description": "The request body is in a media type or content coding this operation does not read.",
            "headers": {
              "Accept-Encoding": {
                "description": "The content codings this operation decodes, when the Content-Encoding was refused.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountNotFound": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "__type": {
            "type": "string",
            "default": "com.example.bank#AccountNotFound",
            "description": "The shape id identifying this error, as the protocol requires."
          }
        },
        "required": [
          "message"
        ]
      },
      "Attribute": {
        "oneOf": [
          {
            "type": "number",
            "format": "double"
          },
          {
            "type": "string"
          }
        ]
      },
      "CreatePetInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "$ref": "#/components/schemas/PetKind"
          },
          "tags": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "birthday": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "photo_bytes": {
            "type": [
              "string",
              "null"
            ],
            "format": "byte"
          }
        },
        "required": [
          "name"
        ]
      },
      "CreatePetOutput": {
        "type": "object",
        "properties": {
          "pet": {
            "$ref": "#/components/schemas/Pet"
          }
        },
        "required": [
          "pet"
        ]
      },
      "ErrorModel": {
        "type": "object",
        "description": "How a refused or failed request is answered when the contract declared no body for it: a problem details document.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "GetBalanceInput": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          }
        },
        "required": [
          "accountId"
        ]
      },
      "GetBalanceOutput": {
        "type": "object",
        "properties": {
          "balanceCents": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "balanceCents"
        ]
      },
      "GetPetOutput": {
        "type": "object",
        "properties": {
          "pet": {
            "$ref": "#/components/schemas/Pet"
          }
        },
        "required": [
          "pet"
        ]
      },
      "GetSecuredPetOutput": {
        "type": "object",
        "properties": {
          "pet": {
            "$ref": "#/components/schemas/Pet"
          }
        },
        "required": [
          "pet"
        ]
      },
      "ListPetsOutput": {
        "type": "object",
        "properties": {
          "pets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pet"
            }
          },
          "nextToken": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "pets"
        ]
      },
      "Pet": {
        "type": "object",
        "description": "A pet.",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PetKind"
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ]
          },
          "attributes": {
            "$ref": "#/components/schemas/Attribute"
          },
          "metadata": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "PetAdopted": {
        "type": "object",
        "description": "One event in a pet's history: it was adopted.",
        "properties": {
          "petId": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        },
        "required": [
          "petId",
          "by"
        ]
      },
      "PetEventStream": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PetAdopted"
          },
          {
            "$ref": "#/components/schemas/PetWeighed"
          }
        ],
        "description": "Smithy's own spelling for an event stream: a union under @streaming, one member per kind of\nevent. The generated interface returns IAsyncEnumerable<PetEventStream>, the response is framed\nas server-sent events, and the member name is written as the event: field beside each item."
      },
      "PetKind": {
        "type": "string",
        "enum": [
          "dog",
          "cat",
          "other"
        ]
      },
      "PetNotFound": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "PetWeighed": {
        "type": "object",
        "description": "One event in a pet's history: it was weighed.",
        "properties": {
          "petId": {
            "type": "string"
          },
          "grams": {
            "type": "integer"
          }
        },
        "required": [
          "petId",
          "grams"
        ]
      },
      "PutPetPhotoOutput": {
        "type": "object",
        "properties": {
          "byteCount": {
            "type": "integer"
          }
        },
        "required": [
          "byteCount"
        ]
      },
      "RequestValidationError": {
        "type": "object",
        "description": "How a request that failed validation is answered: a problem details document whose errors member names each field that failed.",
        "required": [
          "errors",
          "type",
          "title",
          "status"
        ],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "code",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Throttled": {
        "type": "object",
        "properties": {
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryAfterSeconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "TransferInput": {
        "type": "object",
        "properties": {
          "fromAccount": {
            "type": "string"
          },
          "toAccount": {
            "type": "string"
          },
          "amountCents": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "required": [
          "fromAccount",
          "toAccount",
          "amountCents"
        ]
      },
      "TransferOutput": {
        "type": "object",
        "properties": {
          "transferId": {
            "type": "string"
          }
        },
        "required": [
          "transferId"
        ]
      }
    },
    "securitySchemes": {
      "httpBearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
