@using Hardened.IntegrationTests.Benchmark.SUT.Models
@inherits global::Hardened.IntegrationTests.Benchmark.SUT.BenchmarkTestAppRazorTemplate<Hardened.IntegrationTests.Benchmark.SUT.Models.FortunePage>
@*
    The markup TechEmpower specifies for the Fortunes test type, exactly. @fortune.Message is
    written through RazorBlade's HTML encoder, which is what turns the eleventh row's <script> tag
    into text rather than a tag - the requirement the test type exists to check.
*@
<!DOCTYPE html>
<html>
<head><title>Fortunes</title></head>
<body>
<table>
<tr><th>id</th><th>message</th></tr>
@*
    A generated link, in the one place it pays off. RazorBlade copies @ expressions verbatim and
    emits #line directives with exact spans, so renaming the route or its handler breaks this
    template at compile time, reported here rather than when someone loads the page.
*@
<tr><td colspan="2"><a href="@Links.Benchmark.Fortunes()">reload</a></td></tr>
@foreach (var fortune in Model.Fortunes)
{<tr><td>@fortune.Id</td><td>@fortune.Message</td></tr>
}</table>
</body>
</html>
