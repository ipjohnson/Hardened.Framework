<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Web\Hardened.Web.Testing\Hardened.Web.Testing.csproj" />
        <ProjectReference Include="..\Hardened.IntegrationTests.OpenApi.SUT\Hardened.IntegrationTests.OpenApi.SUT.csproj" />
    </ItemGroup>

    <!-- The shared front-end conformance suite. Linked rather than referenced - see the remarks on
         PetstoreConformanceTests for why a shared assembly cannot work with this harness. -->
    <ItemGroup>
        <Compile Include="..\..\Conformance\Shared\*.cs" Link="Conformance\%(FileName)%(Extension)"/>
    </ItemGroup>

    <!--
        The document the application's build exported, beside the tests that compare it with the
        one the application serves. Copied at build time, which is after the application built and
        wrote it; the indented-JSON writer is linked in so the comparison is against the same
        indentation the export task applied rather than against a second writer's idea of it.
    -->
    <ItemGroup>
        <Content Include="..\Hardened.IntegrationTests.OpenApi.SUT\openapi\OpenApiTestApp.json" Link="openapi\OpenApiTestApp.json" CopyToOutputDirectory="PreserveNewest" Visible="false"/>
        <Compile Include="..\..\..\SourceGenerators\Hardened.Generation.Shared\Document\JsonTree.cs" Link="Document\JsonTree.cs"/>
        <Compile Include="..\..\..\SourceGenerators\Hardened.Generation.Shared\Document\JsonTreeWriter.cs" Link="Document\JsonTreeWriter.cs"/>
    </ItemGroup>

</Project>
