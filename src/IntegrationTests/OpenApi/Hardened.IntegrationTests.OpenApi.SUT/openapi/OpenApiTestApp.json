{
  "openapi": "3.2.0",
  "info": {
    "title": "Petstore API",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Pet",
      "description": "Everything about the pets in the store."
    },
    {
      "name": "Account"
    },
    {
      "name": "Secured"
    },
    {
      "name": "Guarded"
    },
    {
      "name": "Order"
    },
    {
      "name": "Store"
    }
  ],
  "paths": {
    "/accounts": {
      "post": {
        "tags": [
          "Account"
        ],
        "operationId": "createAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Account"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account as stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/guarded/by-attribute": {
      "get": {
        "tags": [
          "Guarded"
        ],
        "operationId": "guardedByAttribute",
        "responses": {
          "200": {
            "description": "Allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "tags": [
          "Order"
        ],
        "operationId": "placeOrder",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The order as accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderRequest"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pets": {
      "get": {
        "tags": [
          "Pet"
        ],
        "operationId": "listPets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of pets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pet"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pet"
        ],
        "operationId": "createPet",
        "summary": "Add a pet to the store",
        "description": "The prose a description carries, into the document the application publishes. This reached the generated C# and stopped there until the handler model carried it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePetRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pet created",
            "headers": {
              "Location": {
                "description": "Where the created pet can be read.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pets/names": {
      "get": {
        "tags": [
          "Pet"
        ],
        "operationId": "listPetNames",
        "responses": {
          "200": {
            "description": "Just the names"
          }
        }
      }
    },
    "/pets/plain": {
      "get": {
        "tags": [
          "Pet"
        ],
        "operationId": "petsAsPlainText",
        "responses": {
          "200": {
            "description": "The pets, one per line",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/pets/search": {
      "get": {
        "tags": [
          "Pet"
        ],
        "operationId": "searchPets",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 20,
              "pattern": "^[a-zA-Z ]+$"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "available",
                "pending",
                "sold"
              ]
            }
          },
          {
            "name": "species",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "dog",
                "cat",
                "guinea-pig"
              ]
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "enum": [
                "1",
                "5",
                "25"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching pets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pet"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "delete": {
        "tags": [
          "Pet"
        ],
        "operationId": "deletePet",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Pet deleted"
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Pet"
        ],
        "operationId": "getPet",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "description": "The pet's identifier, as assigned by the server.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A single pet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          },
          "404": {
            "description": "No pet with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "The caller is being throttled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Pet"
        ],
        "operationId": "updatePet",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pet updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Pet"
        ],
        "operationId": "replacePet",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pet replaced",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}/label": {
      "get": {
        "tags": [
          "Pet"
        ],
        "operationId": "getPetLabel",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "copies",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The pet's cage label, one line per copy",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No pet with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/secured/either": {
      "get": {
        "tags": [
          "Secured"
        ],
        "operationId": "securedEither",
        "security": [
          {
            "petstoreOAuth": [
              "pets:read"
            ]
          },
          {
            "petstoreApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "headers": {
              "WWW-Authenticate": {
                "description": "The challenge naming the scheme to authenticate with.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/secured/owned/{ownerId}": {
      "get": {
        "tags": [
          "Secured"
        ],
        "operationId": "securedOwned",
        "security": [
          {
            "petstoreOAuth": [
              "pets:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "ownerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The caller owns it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not the owner."
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "headers": {
              "WWW-Authenticate": {
                "description": "The challenge naming the scheme to authenticate with.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/secured/scoped": {
      "get": {
        "tags": [
          "Secured"
        ],
        "operationId": "securedScoped",
        "security": [
          {
            "petstoreOAuth": [
              "pets:read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "headers": {
              "WWW-Authenticate": {
                "description": "The challenge naming the scheme to authenticate with.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/stores": {
      "get": {
        "tags": [
          "Store"
        ],
        "operationId": "listStores",
        "responses": {
          "200": {
            "description": "A list of stores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Store"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Assigned by the server."
          },
          "email": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "CreatePetRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "tag": {
            "type": "string",
            "maxLength": 50,
            "pattern": "^[a-zA-Z0-9-]*$"
          }
        },
        "required": [
          "name"
        ]
      },
      "ErrorModel": {
        "type": "object",
        "description": "How a refused or failed request is answered when the contract declared no body for it.",
        "required": [
          "type",
          "message",
          "details"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      },
      "OrderLine": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "unitPrice": {
            "type": "number",
            "format": "decimal",
            "minimum": 0.01
          },
          "discount": {
            "type": "string",
            "format": "number",
            "minimum": 0.1
          }
        },
        "required": [
          "sku"
        ]
      },
      "OrderRequest": {
        "type": "object",
        "properties": {
          "species": {
            "$ref": "#/components/schemas/PetSpecies"
          },
          "weightGrams": {
            "type": "integer",
            "format": "int32"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            }
          }
        },
        "required": [
          "species",
          "weightGrams",
          "lines"
        ]
      },
      "Pet": {
        "type": "object",
        "description": "A pet in the store, as the store knows it.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Assigned by the store when the pet is created."
          },
          "name": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "pending",
              "sold"
            ]
          },
          "species": {
            "$ref": "#/components/schemas/PetSpecies"
          },
          "size": {
            "$ref": "#/components/schemas/PetSize"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "PetSize": {
        "type": "string",
        "enum": [
          "1",
          "5",
          "25"
        ]
      },
      "PetSpecies": {
        "type": "string",
        "enum": [
          "dog",
          "cat",
          "guinea-pig"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "RequestValidationError": {
        "type": "object",
        "description": "How a request that failed validation is answered.",
        "required": [
          "type",
          "message",
          "errors"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "code",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Store": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "UpdatePetRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "securitySchemes": {
      "petstoreApiKey": {
        "type": "apiKey",
        "name": "X-Api-Key",
        "in": "header"
      },
      "petstoreOAuth": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://example.invalid/token",
            "scopes": {
              "pets:read": "Read pets.",
              "pets:write": "Create and change pets."
            }
          }
        }
      }
    }
  }
}
