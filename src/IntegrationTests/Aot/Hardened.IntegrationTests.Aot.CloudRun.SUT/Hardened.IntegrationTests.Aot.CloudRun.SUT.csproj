<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The Cloud Run third of the AOT proof, beside the Kestrel and Lambda ones. The Kestrel binary
      proves a native binary serves a web route; the Lambda one proves an invocation reaches a
      handler through an adapter. A Cloud Run service is both at once on one socket: the front door
      ahead of routing recognises a Pub/Sub push, unwraps it into a trigger request, the composite
      dispatch hands that to the function path and a plain GET to the web path. Every one of those
      hand-offs resolves through metadata a trimmer could remove, and the decorator that composes
      the dispatch is a static field initializer a generator emitted.

      Firestore as well as Pub/Sub, on purpose. Google.Events.Protobuf is the one Google dependency
      in the line, and the analyzers can only say that this repository's code is trim-safe; whether
      Google.Protobuf survives ILC is answered by decoding a document event in the native binary,
      which the CI probe does.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DependencyModules_AutoGenerateModule>false</DependencyModules_AutoGenerateModule>

        <!--
          On for the ordinary build too, not only when publishing. PublishAot alone turns the
          analyzers on at publish time, which is the wrong moment to find out: the point is that
          `dotnet build` fails on a trim-unsafe call, in the same run as everything else.
        -->
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="DependencyModules_AutoGenerateModule"/>
    </ItemGroup>

    <!--
      The trigger property declarations and the three bindings this service uses, imported from the
      source tree because a project reference carries no build assets. A consuming application
      gets all of them from buildTransitive/ inside the packages: [Queue] binds through the Pub/Sub
      adapter's, [Change] through the Firestore adapter's and [Get] through the host's.
    -->
    <Import Project="..\..\..\Functions\Hardened.Functions.Runtime\Package\Hardened.Functions.Runtime.targets"/>
    <Import Project="..\..\..\Web\Hardened.Web.Runtime\Package\Hardened.Web.Runtime.targets"/>
    <Import Project="..\..\..\Clouds\Gcp\Hardened.Gcp.CloudRun.PubSub\Package\Hardened.Gcp.CloudRun.PubSub.targets"/>
    <Import Project="..\..\..\Clouds\Gcp\Hardened.Gcp.CloudRun.Firestore\Package\Hardened.Gcp.CloudRun.Firestore.targets"/>
    <Import Project="..\..\..\Clouds\Gcp\Hardened.Gcp.CloudRun.Runtime\Package\Hardened.Gcp.CloudRun.Runtime.targets"/>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Console"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj"/>
        <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\Shared\Hardened.Shared.Runtime\Hardened.Shared.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\Functions\Hardened.Functions.Runtime\Hardened.Functions.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\Web\Hardened.Web.Runtime\Hardened.Web.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\Web\Hardened.Web.Kestrel.Runtime\Hardened.Web.Kestrel.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\Clouds\Gcp\Hardened.Gcp.CloudRun.Runtime\Hardened.Gcp.CloudRun.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\Clouds\Gcp\Hardened.Gcp.CloudRun.PubSub\Hardened.Gcp.CloudRun.PubSub.csproj"/>
        <ProjectReference Include="..\..\..\Clouds\Gcp\Hardened.Gcp.CloudRun.Firestore\Hardened.Gcp.CloudRun.Firestore.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\SourceGenerators\Hardened.DependencyModules.SourceGenerator\Hardened.DependencyModules.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\..\SourceGenerators\Hardened.Library.SourceGenerator\Hardened.Library.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\..\SourceGenerators\Hardened.Function.SourceGenerator\Hardened.Function.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\..\SourceGenerators\Hardened.Web.SourceGenerator\Hardened.Web.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
