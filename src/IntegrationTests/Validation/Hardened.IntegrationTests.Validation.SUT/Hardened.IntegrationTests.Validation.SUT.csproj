<Project Sdk="Microsoft.NET.Sdk">

    <!--
        A Hardened application whose validators come from ValidationModules.SourceGenerator and are
        registered into its [HardenedModule] entry point.
    -->
    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj"/>
        <!-- What turns [HardenedModule] into an IDependencyModule keyed on DependencyRegistry<Application>. -->
        <ProjectReference Include="..\..\..\SourceGenerators\Hardened.DependencyModules.SourceGenerator\Hardened.DependencyModules.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <Import Project="..\..\..\SourceGenerators\ValidationModulesGenerator.props"/>

</Project>
