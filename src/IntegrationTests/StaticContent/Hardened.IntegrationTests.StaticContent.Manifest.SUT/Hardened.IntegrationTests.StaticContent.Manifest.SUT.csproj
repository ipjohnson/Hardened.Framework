<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <!-- A test fixture, not a shipped package. -->
        <IsPackable>false</IsPackable>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DependencyModules_AutoGenerateModule>false</DependencyModules_AutoGenerateModule>
        <RootNamespace>Hardened.IntegrationTests.StaticContent.Manifest.SUT</RootNamespace>

        <!--
          The build task lives in this repository and is built by the same build that consumes it,
          so the task host would hold an assembly the next build needs to overwrite. Out of process
          is right for a consumer; in process is right here.
        -->
        <HardenedStaticContentInProcessTask>true</HardenedStaticContentInProcessTask>
        <HardenedStaticContentTaskAssembly>$(MSBuildThisFileDirectory)..\..\..\Web\Hardened.Web.StaticContent.BuildTask\bin\$(Configuration)\net8.0\Hardened.Web.StaticContent.BuildTask.dll</HardenedStaticContentTaskAssembly>

        <!-- The fixture ships a .env on purpose, to prove the scan reports it. -->
        <NoWarn>$(NoWarn);HSTATIC003</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="DependencyModules_AutoGenerateModule"/>
    </ItemGroup>

    <!--
      The same content the file system fixture serves, linked rather than copied so the two SUTs
      cannot drift: a test asserting one source behaves like the other is worth nothing if they are
      reading different files.
    -->
    <ItemGroup>
        <Content Include="..\Hardened.IntegrationTests.StaticContent.SUT\wwwroot\**"
                 Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!--
      The same route, so the two fixtures differ only in where their content comes from. A test that
      the mount is consulted after routing has to run against both, and it cannot if only one has a
      route to be shadowed by.
    -->
    <ItemGroup>
        <Compile Include="..\Hardened.IntegrationTests.StaticContent.SUT\Controllers\RouteWinsController.cs"
                 Link="Controllers\RouteWinsController.cs"/>
    </ItemGroup>

    <!-- What turns the manifest on. Everything below this line is the point of the fixture. -->
    <ItemGroup>
        <HardenedStaticContent Include="..\Hardened.IntegrationTests.StaticContent.SUT\wwwroot"
                               RoutePrefix="/"
                               FallBackFile="index.html"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj" />
      <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj" />
      <ProjectReference Include="..\..\..\Shared\Hardened.Shared.Runtime\Hardened.Shared.Runtime.csproj" />
      <ProjectReference Include="..\..\..\SourceGenerators\Hardened.DependencyModules.SourceGenerator\Hardened.DependencyModules.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
      <ProjectReference Include="..\..\..\SourceGenerators\Hardened.Library.SourceGenerator\Hardened.Library.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
      <ProjectReference Include="..\..\..\SourceGenerators\Hardened.Validation.SourceGenerator\Hardened.Validation.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
      <ProjectReference Include="..\..\..\SourceGenerators\Hardened.Web.SourceGenerator\Hardened.Web.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
      <ProjectReference Include="..\..\..\Web\Hardened.Web.AspNetCore.Runtime\Hardened.Web.AspNetCore.Runtime.csproj" />
      <ProjectReference Include="..\..\..\Web\Hardened.Web.Runtime\Hardened.Web.Runtime.csproj" />
      <ProjectReference Include="..\..\..\Web\Hardened.Web.StaticContent\Hardened.Web.StaticContent.csproj" />
      <ProjectReference Include="..\..\..\Web\Hardened.Web.StaticContent.BuildTask\Hardened.Web.StaticContent.BuildTask.csproj"
                        ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" PrivateAssets="all"
                        SetTargetFramework="TargetFramework=net8.0"/>
    </ItemGroup>

    <!--
      Imported by hand because this project references the source, not the package - a consumer gets
      it automatically from build/$(PackageId).targets. Below the item group above, which the
      targets file's own HSTATIC006 check exists to enforce.
    -->
    <Import Project="..\..\..\Web\Hardened.Web.StaticContent\Package\Hardened.Web.StaticContent.targets"/>

</Project>
