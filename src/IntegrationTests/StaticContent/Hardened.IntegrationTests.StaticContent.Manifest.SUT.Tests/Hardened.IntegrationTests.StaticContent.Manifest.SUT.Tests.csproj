<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <!--
      The same assertions, against the other source. Linked rather than copied because the whole
      claim is that the two behave alike, and two copies of the suite would drift into asserting
      two different contracts - which is the thing this exists to prevent.
    -->
    <ItemGroup>
        <Compile Include="..\Hardened.IntegrationTests.StaticContent.SUT.Tests\StaticContentTests.cs"
                 Link="StaticContentTests.cs"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\Web\Hardened.Web.Testing\Hardened.Web.Testing.csproj" />
      <ProjectReference Include="..\Hardened.IntegrationTests.StaticContent.Manifest.SUT\Hardened.IntegrationTests.StaticContent.Manifest.SUT.csproj" />
          <!-- [ModuleTest] and the running-test seam, for xunit.v3 4.x. -->
      <ProjectReference Include="..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj"
                        Condition="Exists('..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj')"/>
      <PackageReference Include="DependencyModules.xUnit4"
                        Condition="!Exists('..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj')"/>
    </ItemGroup>

</Project>
