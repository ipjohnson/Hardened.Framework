<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <!--
          Deliberately not IsAotCompatible, for the reason Hardened.Aws.Lambda.Testing gives: a test
          harness serializes whatever type a test hands it, and a testing package is referenced by
          test projects, which are never published ahead of time.
        -->
        <Description>Raises the fidelity of a Hardened function test on Azure: delivers the trigger data the isolated worker would bind - Service Bus messages, Event Hubs events, change feed documents, blobs, timers, CloudEvents and HTTP requests - through the real invocation handler, so the adapter and the batch fan-out are exercised too.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>Hardened.Azure.Functions.Testing</PackageId>
        <PackageTags>Hardened;Hardened.Framework;azure;functions;serverless;testing</PackageTags>
    </PropertyGroup>

    <!--
      Optional. A project testing its own handlers needs only Hardened.Functions.Testing, whose
      delivery names no cloud; this is for a project that also wants what the worker binds to be
      what the adapter reads.

      The meta package rather than the seven, and this is the one place that is the right
      reference: a test project has no deployment to keep small, and the delivery builds the
      trigger data for every family whether or not the application under test serves them all.
      Hardened.Web.Testing is for the HTTP host, which is the same seam [WebTesting] runs through.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\Functions\Hardened.Functions.Testing\Hardened.Functions.Testing.csproj"/>
        <ProjectReference Include="..\Hardened.Azure.Functions\Hardened.Azure.Functions.csproj"/>
        <ProjectReference Include="..\..\..\Web\Hardened.Web.Testing\Hardened.Web.Testing.csproj"/>
    </ItemGroup>

</Project>
