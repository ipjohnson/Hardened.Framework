<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../SourceGenerators/CSharpAuthor.props"/>
    <Import Project="../../../SourceGenerators/SourceGenerator.props"/>

    <PropertyGroup>
        <Description>Source generator for Hardened applications hosted in the Azure Functions isolated worker: writes a [Function] shim per trigger handler, and the metadata provider and executor the worker indexes and invokes them through.</Description>
        <IsPackable>True</IsPackable>
        <PackageTags>Hardened;Hardened.Framework;azure;functions;serverless;source-generator</PackageTags>
        <IsRoslynComponent>true</IsRoslynComponent>
    </PropertyGroup>

    <!--
        PrivateAssets, because the compiler supplies Roslyn to a generator. A reference that flows
        into the package puts Roslyn in the build output of every application that uses it.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Primitives" PrivateAssets="all"/>
        <PackageReference Include="System.Memory" PrivateAssets="all"/>
    </ItemGroup>

    <PropertyGroup>
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>

    <!--
      Hardened.SourceGenerator compiled in from source, the way Hardened.Function.SourceGenerator
      does it: this generator reads the same handler model the function generator reads, through
      FunctionModelGenerator and TriggerModuleGenerator.Triggers, and a generator can take no
      assembly dependency. The link list is the function generator's, because the model it needs
      is the one that generator builds.
    -->
    <ItemGroup>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Configuration/**/*">
            <Link>Configuration\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/DependencyInjection/**/*">
            <Link>DependencyInjection\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Models/**/*">
            <Link>Models\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Module/**/*">
            <Link>Module\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/OpenApiDocument/**/*">
            <Link>OpenApiDocument\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Requests/**/*">
            <Link>Requests\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Shared/**/*">
            <Link>Shared\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Function/**/*">
            <Link>Function\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Validation/**/*">
            <Link>Validation\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <!--
            Two files rather than Web/Routing/**, which brings the route tree and everything it
            binds against. A function has no routes; the document writer these two serve is shared
            with the hosts that do, and it reads a token's constraint to decide whether binding can
            still refuse the value.
        -->
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Web/Routing/RouteConstraintFacts.cs">
            <Link>Web\Routing\RouteConstraintFacts.cs</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Web/Routing/RouteTemplate.cs">
            <Link>Web\Routing\RouteTemplate.cs</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
    </ItemGroup>

    <Import Project="../../../SourceGenerators/ValidationModulesImpl.props"/>

    <PropertyGroup>
        <HardenedGenerationScope>Model</HardenedGenerationScope>
    </PropertyGroup>

    <Import Project="../../../SourceGenerators/Hardened.Generation.Shared/Hardened.Generation.Shared.props"/>

</Project>
