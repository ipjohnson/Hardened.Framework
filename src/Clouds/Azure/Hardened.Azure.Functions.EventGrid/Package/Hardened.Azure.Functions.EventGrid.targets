<Project>
    <!--
        Which module serves this package's trigger. One property, because one trigger is served by
        exactly one adapter package on a given provider; see Hardened.Aws.Lambda.Sqs's targets for
        the whole argument. The property is declared by Hardened.Functions.Runtime's targets, and
        Hardened.Azure.Functions.SourceGenerator reads it to write the Event Grid function.
    -->
    <PropertyGroup>
        <HardenedEventModule Condition="'$(HardenedEventModule)' == ''">Hardened.Azure.Functions.EventGrid.EventGridModule</HardenedEventModule>
    </PropertyGroup>

    <!-- Kept whole under Native AOT, for the reason Hardened.Azure.Functions.Runtime's targets give:
         the worker constructs the extension's converters by reflection. -->
    <ItemGroup Condition="'$(PublishAot)' == 'true' Or '$(PublishTrimmed)' == 'true'">
        <TrimmerRootAssembly Include="Microsoft.Azure.Functions.Worker.Extensions.EventGrid" />
    </ItemGroup>
</Project>
