<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The container rung of the events fixture: its build output inside the Functions host image,
      indexed by the host from the generated metadata provider, with the Service Bus emulator
      declaring the queue and the topic with its subscription. Every test here carries the
      Simulator trait the CI split reads, needs Docker and four images, and fails rather than
      skips without them.
    -->
    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Messaging.ServiceBus"/>
        <PackageReference Include="Testcontainers.Azurite"/>
        <PackageReference Include="Testcontainers.ServiceBus"/>
    </ItemGroup>

    <!-- The application is referenced so it is built first, for the reason the queue fixture gives. -->
    <ItemGroup>
        <ProjectReference Include="..\Hardened.IntegrationTests.AzureEvents.SUT\Hardened.IntegrationTests.AzureEvents.SUT.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\..\..\..\Functions\Hardened.Functions.Testing.Containers\Hardened.Functions.Testing.Containers.csproj"/>
    </ItemGroup>

    <!-- The emulator's namespace, queue, topic and subscription, mounted as its configuration file. -->
    <ItemGroup>
        <None Include="ServiceBusEmulator.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
