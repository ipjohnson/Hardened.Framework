<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The pipeline rung of the ladder. [WebTesting] alone: a request is built and run through the
      web pipeline, and nothing here names Azure - HttpFunctionTests.cs is the API Gateway fixture's
      test file unchanged. The rung above links the same file and adds [AzureFunctionsWebTesting].

      Beside the web tests are the ones that read what the Azure generator wrote into the
      application: that the verbs bound the HTTP adapter, and that the provider and the Worker
      SDK's build task describe the same function.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3.mtp-off"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.IntegrationTests.AzureHttp.SUT\Hardened.IntegrationTests.AzureHttp.SUT.csproj"/>
        <ProjectReference Include="..\..\..\..\..\Web\Hardened.Web.Testing\Hardened.Web.Testing.csproj"/>
        <ProjectReference Include="..\..\..\Hardened.Azure.Functions.Testing\Hardened.Azure.Functions.Testing.csproj"/>
        <ProjectReference Include="..\..\..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj"
                          Condition="Exists('..\..\..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj')"/>
        <PackageReference Include="DependencyModules.xUnit4"
                          Condition="!Exists('..\..\..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj')"/>
    </ItemGroup>

</Project>
