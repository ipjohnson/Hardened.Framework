<Project Sdk="Microsoft.NET.Sdk">

    <!--
      An HTTP function as an application would write one: web verbs on a controller and nothing
      that names Azure. The same handlers compile against Kestrel, inside ASP.NET Core and behind
      API Gateway, and the only thing that makes them run behind an HTTP trigger is which runtime
      package this project references - which is the portability claim the whole adapter map exists
      for, and this is the fixture that holds it on this provider.

      An executable with UseAppHost off, for the reason the queue fixture gives.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <UseAppHost>false</UseAppHost>
        <IsPackable>false</IsPackable>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Hardened.IntegrationTests.AzureHttp.SUT</RootNamespace>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <!-- The Worker SDK is the application's reference; see the queue fixture. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj"/>
        <ProjectReference Include="..\..\..\..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\..\..\Shared\Hardened.Shared.Runtime\Hardened.Shared.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\..\..\Web\Hardened.Web.Runtime\Hardened.Web.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\Hardened.Azure.Functions.Http\Hardened.Azure.Functions.Http.csproj"/>
        <ProjectReference Include="..\..\..\..\..\SourceGenerators\Hardened.Library.SourceGenerator\Hardened.Library.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\..\..\..\SourceGenerators\Hardened.Web.SourceGenerator\Hardened.Web.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\..\..\..\SourceGenerators\Hardened.Validation.SourceGenerator\Hardened.Validation.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\..\..\..\SourceGenerators\Hardened.DependencyModules.SourceGenerator\Hardened.DependencyModules.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\..\Hardened.Azure.Functions.SourceGenerator\Hardened.Azure.Functions.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!--
      Imported from the source tree rather than arriving with a package reference, for the reason
      the queue fixture gives. The verbs are declared by Hardened.Web.Runtime, which owns [Get] and
      the rest - a web project never references Hardened.Functions.Runtime - so the first import
      declares HardenedHttpModule, the second binds it to the HTTP adapter, which is also what tells
      the Azure generator to write the one HTTP function, and the third keeps the Worker SDK's empty
      generated provider and executor out of the worker.
    -->
    <Import Project="..\..\..\..\..\Web\Hardened.Web.Runtime\Package\Hardened.Web.Runtime.targets"/>
    <Import Project="..\..\..\Hardened.Azure.Functions.Http\Package\Hardened.Azure.Functions.Http.targets"/>
    <Import Project="..\..\..\Hardened.Azure.Functions.Runtime\Package\Hardened.Azure.Functions.Runtime.targets"/>

</Project>
