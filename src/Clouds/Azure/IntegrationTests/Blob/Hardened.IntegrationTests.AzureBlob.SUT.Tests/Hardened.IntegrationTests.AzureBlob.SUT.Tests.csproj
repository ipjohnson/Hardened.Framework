<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The pipeline rung of the ladder; see the queue fixture's test project for the arrangement.
      BlobTests.cs is the S3 fixture's test file with Storage's names for things, and the rung
      above links it.
    -->
    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DependencyModules.NSubstitute"/>
        <PackageReference Include="NSubstitute"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.IntegrationTests.AzureBlob.SUT\Hardened.IntegrationTests.AzureBlob.SUT.csproj"/>
        <ProjectReference Include="..\..\..\Hardened.Azure.Functions.Testing\Hardened.Azure.Functions.Testing.csproj"/>
        <ProjectReference Include="$(DependencyModulesRoot)\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj"
                          Condition="'$(UseLocalDependencyModules)' == 'true'"/>
        <PackageReference Include="DependencyModules.xUnit4"
                          Condition="'$(UseLocalDependencyModules)' != 'true'"/>
    </ItemGroup>

</Project>
