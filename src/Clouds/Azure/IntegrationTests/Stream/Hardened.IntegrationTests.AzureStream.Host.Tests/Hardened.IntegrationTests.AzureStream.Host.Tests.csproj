<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The container rung of the stream fixture: its build output inside the Functions host image,
      indexed by the host from the generated metadata provider and driven by the Event Hubs
      emulator through an event a test publishes. Every test here carries the Simulator trait the
      CI split reads, needs Docker and three images, and fails rather than skips without them.
    -->
    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Messaging.EventHubs"/>
        <PackageReference Include="Testcontainers.Azurite"/>
        <PackageReference Include="Testcontainers.EventHubs"/>
    </ItemGroup>

    <!-- The application is referenced so it is built first, for the reason the queue fixture gives. -->
    <ItemGroup>
        <ProjectReference Include="..\Hardened.IntegrationTests.AzureStream.SUT\Hardened.IntegrationTests.AzureStream.SUT.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\..\..\..\Functions\Hardened.Functions.Testing.Containers\Hardened.Functions.Testing.Containers.csproj"/>
    </ItemGroup>

</Project>
