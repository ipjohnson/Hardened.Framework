<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The worker rung of the ladder: the same QueueTests.cs as the pipeline rung, linked rather
      than copied, with [AzureFunctionsTesting] raising the delivery to the trigger data the
      isolated worker would bind, through the real invocation handler. A test that passes here and
      not in the rung below is a defect in the adapter or the fan-out; one that passes below and
      not here is a defect in what the worker hands over.
    -->
    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DependencyModules.NSubstitute"/>
        <PackageReference Include="NSubstitute"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Hardened.IntegrationTests.AzureQueue.SUT.Tests\QueueTests.cs" Link="QueueTests.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.IntegrationTests.AzureQueue.SUT\Hardened.IntegrationTests.AzureQueue.SUT.csproj"/>
        <ProjectReference Include="..\..\..\..\..\Functions\Hardened.Functions.Testing\Hardened.Functions.Testing.csproj"/>
        <ProjectReference Include="..\..\..\Hardened.Azure.Functions.Testing\Hardened.Azure.Functions.Testing.csproj"/>
        <ProjectReference Include="..\..\..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj"
                          Condition="Exists('..\..\..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj')"/>
        <PackageReference Include="DependencyModules.xUnit4"
                          Condition="!Exists('..\..\..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj')"/>
    </ItemGroup>

</Project>
