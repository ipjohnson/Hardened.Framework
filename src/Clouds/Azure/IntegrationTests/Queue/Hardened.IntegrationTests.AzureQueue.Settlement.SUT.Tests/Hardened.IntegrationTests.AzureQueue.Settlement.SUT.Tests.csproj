<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The settling half of the queue fixture's pair. One rung only: the tests hand the invocation
      handler the batch and a recording settlement channel directly, because what they assert is
      which messages the adapter completed and which it abandoned, by id, and that is visible
      nowhere else.
    -->
    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NSubstitute"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.IntegrationTests.AzureQueue.Settlement.SUT\Hardened.IntegrationTests.AzureQueue.Settlement.SUT.csproj"/>
        <ProjectReference Include="..\..\..\Hardened.Azure.Functions.Testing\Hardened.Azure.Functions.Testing.csproj"/>
        <ProjectReference Include="..\..\..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj"
                          Condition="Exists('..\..\..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj')"/>
        <PackageReference Include="DependencyModules.xUnit4"
                          Condition="!Exists('..\..\..\..\..\..\..\DependencyModules\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj')"/>
    </ItemGroup>

</Project>
