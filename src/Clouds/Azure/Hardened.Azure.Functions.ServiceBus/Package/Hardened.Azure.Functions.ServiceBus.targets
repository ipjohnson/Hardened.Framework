<Project>
    <!--
        Which module serves this package's trigger. One property, because one trigger is served by
        exactly one adapter package on a given provider - see Hardened.Aws.Lambda.Sqs's targets for
        the whole argument, which holds here unchanged.

        The property is declared by Hardened.Functions.Runtime's targets, which own the attribute
        that binds it. Hardened.Azure.Functions.SourceGenerator reads the same property to decide
        which shims to write, so setting it is what puts a [ServiceBusTrigger] function into the
        worker as well as what registers the adapter.

        Conditional, so a csproj can replace this binding and keep the rest.
    -->
    <PropertyGroup>
        <!-- One adapter, two triggers: a queue and a subscription deliver the same message. -->
        <HardenedQueueModule Condition="'$(HardenedQueueModule)' == ''">Hardened.Azure.Functions.ServiceBus.ServiceBusModule</HardenedQueueModule>
        <HardenedTopicModule Condition="'$(HardenedTopicModule)' == ''">Hardened.Azure.Functions.ServiceBus.ServiceBusModule</HardenedTopicModule>
    </PropertyGroup>

    <!-- Kept whole under Native AOT, for the reason Hardened.Azure.Functions.Runtime's targets give:
         the worker constructs the extension's converters by reflection. -->
    <ItemGroup Condition="'$(PublishAot)' == 'true' Or '$(PublishTrimmed)' == 'true'">
        <TrimmerRootAssembly Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" />
    </ItemGroup>
</Project>
