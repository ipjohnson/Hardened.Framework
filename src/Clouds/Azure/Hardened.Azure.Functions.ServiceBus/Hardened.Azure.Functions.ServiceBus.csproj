<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Description>Serves [Queue] handlers on Azure Functions from Service Bus, delivered as a batch against one queue.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>Hardened.Azure.Functions.ServiceBus</PackageId>
        <PackageTags>Hardened;Hardened.Framework;azure;functions;serverless;servicebus;queue</PackageTags>

        <!--
          One adapter family, so a function that is not triggered this way never has the Service
          Bus extension and its SDK in its deployment. Batched, so it brings BatchExecutionFilter
          with it. Per-message settlement is Phase 2; until then a failure abandons the batch.
        -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.Azure.Functions.Runtime\Hardened.Azure.Functions.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj"/>
        <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\SourceGenerators\Hardened.Library.SourceGenerator\Hardened.Library.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"/>
        <ProjectReference Include="..\..\..\SourceGenerators\Hardened.DependencyModules.SourceGenerator\Hardened.DependencyModules.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Hardened.Azure.Functions.Runtime.Tests"/>
    </ItemGroup>

    <!--
      buildTransitive/ rather than build/, for the reason Hardened.Aws.Lambda.Sqs gives. The
      targets bind HardenedQueueModule to this package's module; see the file.
    -->
    <ItemGroup>
        <Content Include="Package\Hardened.Azure.Functions.ServiceBus.targets">
            <Pack>true</Pack>
            <PackagePath>buildTransitive/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <!--
      The worker extension is what makes the generated shim's [ServiceBusTrigger] real: it carries
      the attribute, the converter that turns the host's AMQP bytes into ServiceBusReceivedMessage,
      and the assembly attribute the Sdk's build task reads to put the WebJobs Service Bus extension
      into the host's extensions.json. Azure.Messaging.ServiceBus arrives through it.

      No Microsoft.Extensions.Logging.Abstractions reference, unlike the SQS adapter: the extension
      requires it one patch above the repository's pin, and a direct reference at the pin is NU1605.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" />
        <PackageReference Include="DependencyModules.Runtime" />
        <PackageReference Include="DependencyModules.SourceGenerator" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Primitives" />
    </ItemGroup>

</Project>
