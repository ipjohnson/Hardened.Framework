<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Description>Serves a Hardened web application on Azure Functions from one anonymous HTTP trigger catching every method under every path, with Hardened's routing table doing the routing.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>Hardened.Azure.Functions.Http</PackageId>
        <PackageTags>Hardened;Hardened.Framework;azure;functions;serverless;http;web</PackageTags>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <!--
      No reference to Hardened.Web.Runtime, the same arrangement as Hardened.Aws.Lambda.Http:
      the adapter produces a web-shaped IExecutionRequest and the pipeline routes it through the
      table [HardenedWebModule] registered on the application. The invocation handler selects that
      table per invocation because the shim says it is the web function; nothing here names it.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Hardened.Azure.Functions.Runtime\Hardened.Azure.Functions.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj"/>
        <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\SourceGenerators\Hardened.Library.SourceGenerator\Hardened.Library.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"/>
        <ProjectReference Include="..\..\..\SourceGenerators\Hardened.DependencyModules.SourceGenerator\Hardened.DependencyModules.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Hardened.Azure.Functions.Runtime.Tests"/>
    </ItemGroup>

    <!-- buildTransitive/ rather than build/, for the reason Hardened.Aws.Lambda.Sqs gives. -->
    <ItemGroup>
        <Content Include="Package\Hardened.Azure.Functions.Http.targets">
            <Pack>true</Pack>
            <PackagePath>buildTransitive/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <!--
      The worker extension carries the attribute and the assembly attribute the Sdk's build task
      reads; HttpRequestData and HttpResponseData are the worker's own, in Core.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" />
        <PackageReference Include="DependencyModules.Runtime" />
        <PackageReference Include="DependencyModules.SourceGenerator" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Primitives" />
    </ItemGroup>

</Project>
