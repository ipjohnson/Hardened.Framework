<Project>
    <!--
        Which module serves this package's trigger. One property, because one trigger is served by
        exactly one adapter package on a given provider. The property is declared by
        Hardened.Functions.Runtime, which owns the attribute; see its targets for the rule.

        Conditional, so a csproj can replace this binding and keep the rest.
    -->
    <PropertyGroup>
        <HardenedTimerModule Condition="'$(HardenedTimerModule)' == ''">Hardened.Gcp.CloudRun.Scheduler.SchedulerModule</HardenedTimerModule>
    </PropertyGroup>
</Project>
