<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../SourceGenerators/CSharpAuthor.props"/>

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Description>Source generator for Hardened applications deployed as Google Cloud Functions 2nd gen: writes the FUNCTION_TARGET entry type into the application's own assembly, with the startup attribute that populates the application into the Functions Framework's container.</Description>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.Gcp.Functions.SourceGenerator</PackageId>
        <PackageTags>Hardened;Hardened.Framework;gcp;cloudfunctions;serverless;source-generator</PackageTags>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <!-- Off, against the Gcp Directory.Build.props, for the reason the Azure generator gives. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Primitives"/>
        <PackageReference Include="System.Memory"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

    <PropertyGroup>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>

    <!--
      Hardened.SourceGenerator compiled in from source, the way the Azure generator does it: a
      generator can take no assembly dependency, so the shared code is linked rather than
      referenced.

      A shorter list than the Azure generator's, because this one reads far less. All it needs of
      the application is the entry point's name and namespace, which is EntryPointSelector in
      Shared - so the handler model, the trigger table and the document writer are all absent.
      Shared does not stand alone, though: its models bind against Models and Module, and
      DependencyInjection is what the attribute and method models are read through.
    -->
    <ItemGroup>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Shared/**/*">
            <Link>Shared\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Models/**/*">
            <Link>Models\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Module/**/*">
            <Link>Module\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/DependencyInjection/**/*">
            <Link>DependencyInjection\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
    </ItemGroup>

    <Import Project="../../../SourceGenerators/ValidationModulesImpl.props"/>

    <PropertyGroup>
        <HardenedGenerationScope>Model</HardenedGenerationScope>
    </PropertyGroup>

    <Import Project="../../../SourceGenerators/Hardened.Generation.Shared/Hardened.Generation.Shared.props"/>

</Project>
