<Project>
    <!--
        Which module serves this package's trigger. The property is declared by
        Hardened.Functions.Runtime, which owns [Blob]; see its targets for the rule. Conditional,
        so a csproj can replace this binding and keep the rest.
    -->
    <PropertyGroup>
        <HardenedBlobModule Condition="'$(HardenedBlobModule)' == ''">Hardened.Gcp.CloudRun.Storage.StorageModule</HardenedBlobModule>
    </PropertyGroup>
</Project>
