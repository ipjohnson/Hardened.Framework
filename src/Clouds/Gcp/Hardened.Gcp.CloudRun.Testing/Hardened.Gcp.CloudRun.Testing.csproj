<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <!--
          Deliberately not IsAotCompatible. A test harness serializes whatever type a test hands it
          and builds clients over types it learns at run time, so the reflection is the feature
          rather than an oversight - and a testing package is referenced by test projects, which are
          never published ahead of time. Marking it would make the flag a claim about code no
          consumer will ever trim. See Hardened.Shared.Testing.csproj for the whole of it.
        -->
        <Description>Raises the fidelity of a Hardened function test on Google Cloud Run: delivers through the envelope Pub/Sub actually sends, in through the front door and the same dispatch a deployed service runs, on the pipeline host or over a Kestrel socket.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>Hardened.Gcp.CloudRun.Testing</PackageId>
        <PackageTags>Hardened;Hardened.Framework;gcp;cloudrun;serverless;testing</PackageTags>
    </PropertyGroup>

    <!--
      Optional. A project testing its own handlers needs only Hardened.Functions.Testing, whose
      delivery names no cloud; this is for a project that also wants the envelope its provider
      actually sends to be what the front door reads. It goes in through Hardened.Web.Testing's
      host seam, which is what lets the same test run on the pipeline and, with [KestrelTesting],
      over a socket without changing a line.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\Functions\Hardened.Functions.Testing\Hardened.Functions.Testing.csproj"/>
        <ProjectReference Include="..\..\..\Shared\Hardened.Shared.Testing\Hardened.Shared.Testing.csproj"/>
        <ProjectReference Include="..\..\..\Web\Hardened.Web.Testing\Hardened.Web.Testing.csproj"/>
        <ProjectReference Include="..\Hardened.Gcp.CloudRun.PubSub\Hardened.Gcp.CloudRun.PubSub.csproj"/>
    </ItemGroup>

</Project>
