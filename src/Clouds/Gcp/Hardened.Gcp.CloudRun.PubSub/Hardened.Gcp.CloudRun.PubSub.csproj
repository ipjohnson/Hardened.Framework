<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Description>Serves [Queue] handlers on Google Cloud Run from a Pub/Sub push subscription: the push envelope becomes the handler's message, its attributes become headers, and the subscription's name is the route.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>Hardened.Gcp.CloudRun.PubSub</PackageId>
        <PackageTags>Hardened;Hardened.Framework;gcp;cloudrun;serverless;pubsub;queue</PackageTags>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

        <!--
          One adapter family, so a service that is not triggered this way never has this assembly
          in its image. No Google SDK: a push arrives as JSON over HTTP and is read as such, which
          is what keeps the package small and trimmable.
        -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.Gcp.CloudRun.Runtime\Hardened.Gcp.CloudRun.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj"/>
        <ProjectReference Include="..\..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\SourceGenerators\Hardened.Library.SourceGenerator\Hardened.Library.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"/>
        <ProjectReference Include="..\..\..\SourceGenerators\Hardened.DependencyModules.SourceGenerator\Hardened.DependencyModules.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Hardened.Gcp.CloudRun.Runtime.Tests"/>
    </ItemGroup>

    <!--
      buildTransitive/ rather than build/. NuGet imports build/ for a direct reference only, and a
      meta package's whole job is to be referenced instead of this one - so in build/ the binding
      below would be missing exactly where it is needed, silently, and the handler would deploy and
      never be reached. buildTransitive/ covers the direct case too.

      Package\ rather than build\ in the source tree, because .gitignore ignores build/.
    -->
    <ItemGroup>
        <Content Include="Package\Hardened.Gcp.CloudRun.PubSub.targets">
            <Pack>true</Pack>
            <PackagePath>buildTransitive/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DependencyModules.Runtime" />
        <PackageReference Include="DependencyModules.SourceGenerator" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Primitives" />
    </ItemGroup>

</Project>
