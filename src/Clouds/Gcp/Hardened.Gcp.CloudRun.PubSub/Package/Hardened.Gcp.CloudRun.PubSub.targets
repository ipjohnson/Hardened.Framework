<Project>
    <!--
        Which module serves this package's trigger. One property, because one trigger is served by
        exactly one adapter package on a given provider - two packages setting the same property
        resolve first-import-wins, silently, on an import order nobody controls.

        The property is declared elsewhere, by whichever package owns the attribute that binds it:
        a generator sees an MSBuild property only if something declared it CompilerVisibleProperty,
        and the declaration has to be visible wherever the trigger can be written, which is not
        here. See Hardened.Functions.Runtime's targets.

        Only the queue. A [Topic] on Google is a Pub/Sub topic delivered through Eventarc as a
        CloudEvent, whose envelope this package does not read yet; leaving HardenedTopicModule
        unset makes a [Topic] handler fail the build with HRDF001 rather than compile and never be
        reached.

        Conditional, so a csproj can replace this binding and keep the rest. A csproj is evaluated
        before a package's targets, so a value set there survives and this only fills the gap:

            <HardenedQueueModule>MyCompany.SomeOtherModule</HardenedQueueModule>
    -->
    <PropertyGroup>
        <HardenedQueueModule Condition="'$(HardenedQueueModule)' == ''">Hardened.Gcp.CloudRun.PubSub.PubSubModule</HardenedQueueModule>
    </PropertyGroup>
</Project>
