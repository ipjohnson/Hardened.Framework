<Project>

    <!--
      Everything the rest of the repository sets, plus the package tags, which are true only here.
      Without this import a project under src/Clouds would see this file and none of the one at the
      root: MSBuild imports the nearest Directory.Build.props and stops.
    -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <PackageTags>Hardened;Hardened.Framework;aws;lambda;serverless</PackageTags>
    </PropertyGroup>

</Project>
