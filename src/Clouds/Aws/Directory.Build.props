<Project>

    <!--
      Everything the rest of the repository sets, plus the three things that are true only here.
      Without this import a project under src/Clouds/Aws would see this file and none of the one at
      the root: MSBuild imports the nearest Directory.Build.props and stops.
    -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <PackageTags>Hardened;Hardened.Framework;aws;lambda;serverless</PackageTags>
    </PropertyGroup>

    <!--
      Ship the XML documentation file.

      Until 2026-08-27 no project here set this, so every package contained lib/net8.0/<name>.dll
      and nothing else. That is the whole reason it is worth changing: the prose already exists.
      Forty three files carry <summary> blocks, and several of them are the only written record of
      why an API behaves the way it does - BaseBatchExecutionFilter on why a metric sink is per
      record rather than per batch, LambdaWebModule on what happens without the module attribute.
      None of it reached a consumer, because IntelliSense reads the .xml beside the .dll and there
      was no .xml.

      CS1591 (missing XML comment on a publicly visible type or member) is suppressed rather than
      fixed. Turning documentation generation on is what makes the warning appear at all, and it
      fires per public member rather than per type: 1,833 distinct sites as of that change. With
      ContinuousIntegrationBuild escalating warnings to errors, leaving it on would mean either a
      permanently red build or 1,833 placeholder summaries written to silence a compiler, which is
      how a codebase ends up with "Gets or sets the Value." on every property. Undocumented members
      are no worse off than they were; the documented ones are now visible. Drop this line if the
      public surface is ever fully documented and the gate is wanted to keep it that way.

      The framework's packages do not do this yet. When they do, this block moves to the root and
      this file loses it.

      SourceGenerator projects are excluded, for the same reason RS2008 is suppressed for them
      below. They set IncludeBuildOutput=false and pack their assembly by hand into
      analyzers/dotnet/cs, so there is no lib/ folder for an .xml to sit beside and nothing would
      ship even if it were generated. What it does produce is errors: Hardened.SourceGenerator and
      ValidationModules.SourceGenerator.Impl are compiled in as source, so their doc comments are
      analysed here - and they name types that are not compiled in (CS1574), and document some but
      not all parameters of a method (CS1573).
    -->
    <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests')) And !$(MSBuildProjectName.Contains('SourceGenerator'))">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!--
      RS2008 asks an analyzer project to keep an AnalyzerReleases.Shipped.md tracking file. It
      fires here for rules these projects do not own: Hardened.SourceGenerator's and
      ValidationModules.SourceGenerator.Impl's DiagnosticDescriptors are compiled into whichever
      generator project includes their source, and reported against it. Release tracking for those
      rules belongs where the rules are declared.
    -->
    <PropertyGroup Condition="$(MSBuildProjectName.Contains('SourceGenerator'))">
        <NoWarn>$(NoWarn);RS2008</NoWarn>
    </PropertyGroup>

</Project>
