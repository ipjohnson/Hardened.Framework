<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!--
      xunit.v3, not the xunit 2.9 two older projects here still use.

      Not a style choice: Hardened.Shared.Testing depends on DependencyModules.xUnit, which brings
      xunit.v3, and referencing it alongside xunit 2.9 makes every Fact and Assert ambiguous. Every
      *.Testing package in this repository builds on Hardened.Shared.Testing, so new test projects
      standardise on v3 rather than discovering the clash one at a time.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.Amz.Function.Lambda.Streaming\Hardened.Amz.Function.Lambda.Streaming.csproj"/>
    </ItemGroup>

</Project>
