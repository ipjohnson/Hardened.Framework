<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Description>In-process hosting for Hardened web applications on AWS Lambda: runs the Lambda pipeline behind an HTTP listener so a request can be driven end to end without deploying.</Description>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.Amz.Web.Lambda.Harness</PackageId>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Shared\Hardened.Amz.Shared.Lambda.Runtime\Hardened.Amz.Shared.Lambda.Runtime.csproj" />
      <ProjectReference Include="..\..\Shared\Hardened.Amz.Shared.Lambda.Testing\Hardened.Amz.Shared.Lambda.Testing.csproj" />
      <ProjectReference Include="..\Hardened.Amz.Web.Lambda.Runtime\Hardened.Amz.Web.Lambda.Runtime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0"/>
    </ItemGroup>

</Project>
