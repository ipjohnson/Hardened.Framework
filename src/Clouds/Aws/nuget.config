<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!--
      Both sources are declared here rather than inherited. This repository consumes Hardened.*
      from GitHub Packages, and that source used to come from whatever machine-level NuGet.Config
      happened to be present - so a restore's behaviour depended on the machine it ran on.
      Credentials still come from the machine or from NUGET_AUTH_TOKEN in CI; only the source
      definition is pinned here, and it is matched by key.
    -->
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="github-ipjohnson" value="https://nuget.pkg.github.com/ipjohnson/index.json" />
    </packageSources>

    <!--
      Required once central package management is on (NU1507), and worth having on its own: without
      a mapping, every source is asked for every package, so anyone who publishes a package named
      Hardened.Something to nuget.org is a candidate to resolve into this build. Hardened.* comes
      from the private feed and nothing else does.
    -->
    <packageSourceMapping>
        <packageSource key="github-ipjohnson">
            <package pattern="Hardened.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
