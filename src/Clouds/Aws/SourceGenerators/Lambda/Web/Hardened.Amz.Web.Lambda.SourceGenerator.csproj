<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Description>Source generator for Hardened web applications hosted on AWS Lambda and API Gateway.</Description>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.Amz.Web.Lambda.SourceGenerator</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Primitives" Version="8.0.0" />
        <PackageReference Include="System.Memory" Version="4.5.5" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
    </ItemGroup>

    <PropertyGroup>
        <PackageCSharpAuthorIncludeSource>true</PackageCSharpAuthorIncludeSource>
        <PackageHardenedIncludeSource>true</PackageHardenedIncludeSource>

        <!--
            Hardened.SourceGenerator ships source-only and is compiled in above. Its validation
            files build ValidatedTypeModel and emit validators, so they reference ValidationModules'
            generator internals - which have to be compiled in here too, or those files do not
            resolve. Hardened.Framework does the same thing through
            src/SourceGenerators/ValidationModulesImpl.props.
        -->
        <PackageValidationModulesIncludeSource>true</PackageValidationModulesIncludeSource>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CSharpAuthor" Version="1.1.1006">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Hardened.SourceGenerator" Version="1.0.0-preview*">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>

        <PackageReference Include="ValidationModules.SourceGenerator.Impl" Version="0.1.0-alpha.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

    <PropertyGroup>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- Build-only: consumers must not inherit it as a runtime dependency. -->
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Configuration/**/*">
            <Link>Configuration\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/DependencyInjection/**/*">
            <Link>DependencyInjection\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Models/**/*">
            <Link>Models\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Web/**/*">
            <Link>Web\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Requests/**/*">
            <Link>Requests\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Shared/**/*">
            <Link>Shared\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../../../SourceGenerators/Hardened.SourceGenerator/Templates/**/*">
            <Link>Templates\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="..\..\Hardened.SourceGenerator\Web\CreateControllerAndAssignToContextCodeGenerator.cs"/>
    </ItemGroup>

</Project>
