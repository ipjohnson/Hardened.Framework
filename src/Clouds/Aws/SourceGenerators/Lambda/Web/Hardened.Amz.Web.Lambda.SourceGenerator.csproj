<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Description>Source generator for Hardened web applications hosted on AWS Lambda and API Gateway.</Description>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.Amz.Web.Lambda.SourceGenerator</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Primitives" />
        <PackageReference Include="System.Memory" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

    <PropertyGroup>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- Build-only: consumers must not inherit it as a runtime dependency. -->
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>


    <Import Project="../../../../../SourceGenerators/CSharpAuthor.props"/>
    <Import Project="../../../../../SourceGenerators/ValidationModulesImpl.props"/>

    <!--
      Hardened.SourceGenerator compiled in from the checkout rather than restored as a package.

      It ships source rather than an assembly, because a Roslyn generator is loaded with no probing
      path of its own and a sibling DLL is a FileNotFoundException at initialization. The package's
      own targets glob src/**/*.cs into whichever project references it; this is the same glob
      against the project in this repository, which is what makes a change to it fail here instead
      of after a release.
    -->
    <ItemGroup>
        <Compile Include="../../../../../SourceGenerators/Hardened.SourceGenerator/**/*.cs"
                 Exclude="../../../../../SourceGenerators/Hardened.SourceGenerator/obj/**/*.cs;../../../../../SourceGenerators/Hardened.SourceGenerator/bin/**/*.cs"
                 Visible="false"/>
    </ItemGroup>


    <!--
      The shared generation model, compiled in the way every other generator here takes it. The
      Hardened.SourceGenerator package packs these files under its own src/ folder, so consuming
      that package brought them along; the local glob above reaches only the project's own files.

      Model rather than Full, matching Hardened.Web.SourceGenerator and
      Hardened.Function.SourceGenerator: this is code-first, so it builds an OperationModel in
      memory and never writes one out for a build task to read back.
    -->
    <PropertyGroup>
        <HardenedGenerationScope>Model</HardenedGenerationScope>
    </PropertyGroup>

    <Import Project="../../../../../SourceGenerators/Hardened.Generation.Shared/Hardened.Generation.Shared.props"/>

</Project>
