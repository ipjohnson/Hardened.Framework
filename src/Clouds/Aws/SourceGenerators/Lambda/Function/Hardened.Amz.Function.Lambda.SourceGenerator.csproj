<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Description>Source generator for Hardened AWS Lambda function projects: bootstrap and handler wiring.</Description>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.Amz.Function.Lambda.SourceGenerator</PackageId>
    </PropertyGroup>

    <ItemGroup>             
        <PackageReference Include="Microsoft.Extensions.Primitives" />
        <PackageReference Include="System.Memory" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <PropertyGroup>
        <PackageCSharpAuthorIncludeSource>true</PackageCSharpAuthorIncludeSource>        
    </PropertyGroup>
    <PropertyGroup>
        <PackageHardenedIncludeSource>true</PackageHardenedIncludeSource>

        <!--
            Hardened.SourceGenerator ships source-only and is compiled in above. Its validation
            files build ValidatedTypeModel and emit validators, so they reference ValidationModules'
            generator internals - which have to be compiled in here too, or those files do not
            resolve. Hardened.Framework does the same thing through
            src/SourceGenerators/ValidationModulesImpl.props.
        -->
        <PackageValidationModulesIncludeSource>true</PackageValidationModulesIncludeSource>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="CSharpAuthor">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Hardened.SourceGenerator">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>

        <PackageReference Include="ValidationModules.SourceGenerator.Impl">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

    <PropertyGroup>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- Build-only: consumers must not inherit it as a runtime dependency. -->
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>


</Project>
