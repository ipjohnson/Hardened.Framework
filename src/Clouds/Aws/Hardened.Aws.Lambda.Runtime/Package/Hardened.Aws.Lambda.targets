<Project>
    <!--
        Which module serves each trigger, on this runtime.

        A source generator sees an MSBuild property only if something declares it
        CompilerVisibleProperty - AnalyzerConfigOptionsProvider.GlobalOptions holds exactly the
        declared ones and nothing else. Hardened.Web.SourceGenerator learned that the expensive way:
        <HardenedAmbiguousRoutes> had no effect for months because the generator read it and the
        package shipped no build assets to declare it.

        One property per trigger rather than one delimited map, which is only possible because the
        trigger attributes are the framework's own. A generator registers its scans in Initialize,
        where ForAttributeWithMetadataName takes the attribute name, and no MSBuild property has
        been read at that point - AnalyzerConfigOptionsProvider is a pipeline value. So a property
        can never name an attribute to look for. It names the module that serves one, which is the
        only part a provider gets to decide.
    -->
    <ItemGroup>
        <CompilerVisibleProperty Include="HardenedHttpModule"/>
        <CompilerVisibleProperty Include="HardenedInvokeModule"/>
        <CompilerVisibleProperty Include="HardenedQueueModule"/>
        <CompilerVisibleProperty Include="HardenedTopicModule"/>
        <CompilerVisibleProperty Include="HardenedTimerModule"/>
        <CompilerVisibleProperty Include="HardenedEventModule"/>
    </ItemGroup>

    <!--
        Conditional, so a project can replace one binding and keep the rest. A csproj is evaluated
        before a package's targets, so a value set there survives and these only fill the gaps:

            <HardenedQueueModule>MyCompany.PollingQueueModule</HardenedQueueModule>

        Two runtimes referenced at once resolve first-import-wins, silently. That is the one thing
        the per-property shape gives up against a delimited map, and referencing two clouds in one
        function announces itself in other ways.
    -->
    <PropertyGroup>
        <HardenedHttpModule Condition="'$(HardenedHttpModule)' == ''">Hardened.Aws.Lambda.Runtime.Modules.ApiGatewayModule</HardenedHttpModule>
        <HardenedInvokeModule Condition="'$(HardenedInvokeModule)' == ''">Hardened.Aws.Lambda.Runtime.Modules.InvokeModule</HardenedInvokeModule>
        <HardenedQueueModule Condition="'$(HardenedQueueModule)' == ''">Hardened.Aws.Lambda.Runtime.Modules.SqsModule</HardenedQueueModule>
        <HardenedTopicModule Condition="'$(HardenedTopicModule)' == ''">Hardened.Aws.Lambda.Runtime.Modules.SnsModule</HardenedTopicModule>

        <!-- One adapter, two triggers: a schedule and a bus event share an envelope. -->
        <HardenedTimerModule Condition="'$(HardenedTimerModule)' == ''">Hardened.Aws.Lambda.Runtime.Modules.EventBridgeModule</HardenedTimerModule>
        <HardenedEventModule Condition="'$(HardenedEventModule)' == ''">Hardened.Aws.Lambda.Runtime.Modules.EventBridgeModule</HardenedEventModule>
    </PropertyGroup>
</Project>
