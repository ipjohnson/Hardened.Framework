<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <!--
      An HTTP function: web verbs on a controller and nothing that names AWS. The same handlers
      compile against Kestrel and inside ASP.NET Core, and the only thing that makes them run on
      Lambda is which runtime package this project references - which is the portability claim
      the whole adapter map exists for, and this is the fixture that holds it.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\Hardened.Aws.Lambda.Http\Hardened.Aws.Lambda.Http.csproj"/>
        <ProjectReference Include="..\..\..\..\..\SourceGenerators\Hardened.Library.SourceGenerator\Hardened.Library.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\..\..\..\Web\Hardened.Web.Runtime\Hardened.Web.Runtime.csproj"/>
        <ProjectReference Include="..\..\..\..\..\SourceGenerators\Hardened.Web.SourceGenerator\Hardened.Web.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\..\..\..\SourceGenerators\Hardened.Validation.SourceGenerator\Hardened.Validation.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\..\..\..\SourceGenerators\Hardened.DependencyModules.SourceGenerator\Hardened.DependencyModules.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!--
      Imported from the source tree rather than arriving with a package reference, because in this
      repository these are ProjectReferences and a project reference carries no build assets. A
      consuming application gets them from buildTransitive/ inside the packages; importing the same
      files here is what keeps the two from drifting.

      Two kinds of import, which is the shape the split produces. The first declares the trigger
      properties, from the package that owns the attributes. The rest each bind one property, one
      per adapter package.

      The verbs are declared by Hardened.Web.Runtime, which owns [Get] and the rest - a web
      project never references Hardened.Functions.Runtime, which is why the declarations follow the
      attribute rather than living in one place.
    -->
    <Import Project="..\..\..\..\..\Web\Hardened.Web.Runtime\Package\Hardened.Web.Runtime.targets"/>
    <Import Project="..\..\..\Hardened.Aws.Lambda.Http\Package\Hardened.Aws.Lambda.Http.targets"/>

</Project>
