<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DependencyModules.NSubstitute"/>
        <PackageReference Include="NSubstitute"/>
    </ItemGroup>

    <!--
      Its own project rather than another file in the SQS suite, because these tests set the
      environment variables the Lambda runtime client reads and that is process-wide. A separate
      test assembly is a separate process, which is the only isolation that actually holds.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\Sqs\Hardened.IntegrationTests.Sqs.SUT\Hardened.IntegrationTests.Sqs.SUT.csproj"/>
        <ProjectReference Include="..\..\LambdaHttp\Hardened.IntegrationTests.LambdaHttp.SUT\Hardened.IntegrationTests.LambdaHttp.SUT.csproj"/>
        <ProjectReference Include="..\..\..\..\..\Shared\Hardened.Shared.Testing\Hardened.Shared.Testing.csproj"/>
        <ProjectReference Include="$(DependencyModulesRoot)\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj"
                          Condition="'$(UseLocalDependencyModules)' == 'true'"/>
        <PackageReference Include="DependencyModules.xUnit4"
                          Condition="'$(UseLocalDependencyModules)' != 'true'"/>
    </ItemGroup>

</Project>
