<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <!--
      The approved files are read from the build output, not from the source tree.
      ContinuousIntegrationBuild=true turns on deterministic source paths, so [CallerFilePath]
      resolves to a placeholder like /_/src/... in CI - every one of these tests failed there with
      UnauthorizedAccessException on /_ while passing on a developer machine. Copying them here
      makes the comparison independent of where the source happened to be built.
    -->
    <ItemGroup>
        <None Include="Approved\*.approved.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Approved"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="PublicApiGenerator"/>
    </ItemGroup>

    <!--
      Every shipped net8.0 assembly. A package added to the repository and not listed here has no
      approved surface, which EveryReferencedShippedAssemblyIsCovered turns into a failing test.

      The two source generator packages on each side are absent for the same reason: they set
      IncludeBuildOutput=false and pack an analyzer into analyzers/dotnet/cs, so no consumer binds
      against them and there is no lib assembly to have a surface.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\Clients\Hardened.Kiota.Testing\Hardened.Kiota.Testing.csproj"/>
        <ProjectReference Include="..\..\Clouds\Azure\Hardened.Azure.Functions.Testing\Hardened.Azure.Functions.Testing.csproj"/>
        <ProjectReference Include="..\..\Clouds\Gcp\Hardened.Gcp.CloudRun.Testing\Hardened.Gcp.CloudRun.Testing.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Hardened.Aws.DynamoDbClient.Testing\Hardened.Aws.DynamoDbClient.Testing.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Hardened.Aws.Lambda.Testing\Hardened.Aws.Lambda.Testing.csproj"/>
        <ProjectReference Include="..\..\Clients\Hardened.Refit.Testing\Hardened.Refit.Testing.csproj"/>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Caching.Memory\Hardened.Requests.Caching.Memory.csproj"/>
        <ProjectReference Include="..\..\Requests\Serializers\Hardened.Requests.Serializers.MessagePack\Hardened.Requests.Serializers.MessagePack.csproj"/>
        <ProjectReference Include="..\..\Requests\Serializers\Hardened.Requests.Serializers.Newtonsoft\Hardened.Requests.Serializers.Newtonsoft.csproj"/>
        <ProjectReference Include="..\..\SourceGenerators\Hardened.SourceGeneration.Testing\Hardened.SourceGeneration.Testing.csproj"/>
        <ProjectReference Include="..\..\Templates\Hardened.Templates.RazorBlade\Hardened.Templates.RazorBlade.csproj"/>
        <ProjectReference Include="..\..\Web\Hardened.Web.AspNetCore.Testing\Hardened.Web.AspNetCore.Testing.csproj"/>
        <ProjectReference Include="..\..\Web\Hardened.Web.Kestrel.Testing\Hardened.Web.Kestrel.Testing.csproj"/>
        <ProjectReference Include="..\..\Web\Hardened.Web.StaticContent\Hardened.Web.StaticContent.csproj"/>
    </ItemGroup>

</Project>
