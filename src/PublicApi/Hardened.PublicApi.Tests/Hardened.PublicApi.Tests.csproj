<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!--
      The approved files are read from the build output, not from the source tree.
      ContinuousIntegrationBuild=true turns on deterministic source paths, so [CallerFilePath]
      resolves to a placeholder like /_/src/... in CI - every one of these tests failed there with
      UnauthorizedAccessException on /_ while passing on a developer machine. Copying them here
      makes the comparison independent of where the source happened to be built.
    -->
    <ItemGroup>
        <None Include="Approved\*.approved.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Approved"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="PublicApiGenerator"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3"/>
    </ItemGroup>

    <!--
      Every shipped net8.0 assembly. A package added to the repository and not listed here has no
      approved surface, which EveryReferencedShippedAssemblyIsCovered turns into a failing test.

      The two source generator packages on each side are absent for the same reason: they set
      IncludeBuildOutput=false and pack an analyzer into analyzers/dotnet/cs, so no consumer binds
      against them and there is no lib assembly to have a surface.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\Clients\Hardened.Kiota.Testing\Hardened.Kiota.Testing.csproj"/>
        <ProjectReference Include="..\..\Clients\Hardened.Refit.Testing\Hardened.Refit.Testing.csproj"/>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj"/>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Caching.Memory\Hardened.Requests.Caching.Memory.csproj"/>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj"/>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Testing\Hardened.Requests.Testing.csproj"/>
        <ProjectReference Include="..\..\Requests\Serializers\Hardened.Requests.Serializers.Newtonsoft\Hardened.Requests.Serializers.Newtonsoft.csproj"/>
        <ProjectReference Include="..\..\Shared\Hardened.Shared.Runtime\Hardened.Shared.Runtime.csproj"/>
        <ProjectReference Include="..\..\Shared\Hardened.Shared.Testing\Hardened.Shared.Testing.csproj"/>
        <ProjectReference Include="..\..\Shared\Hardened.Shared.Testing.NUnit\Hardened.Shared.Testing.NUnit.csproj"/>
        <ProjectReference Include="..\..\Shared\Hardened.Shared.Testing.xUnit\Hardened.Shared.Testing.xUnit.csproj"/>
        <ProjectReference Include="..\..\SourceGenerators\Hardened.SourceGeneration.Testing\Hardened.SourceGeneration.Testing.csproj"/>
        <ProjectReference Include="..\..\Templates\Hardened.Templates.RazorBlade\Hardened.Templates.RazorBlade.csproj"/>
        <ProjectReference Include="..\..\Web\Hardened.Web.AspNetCore.Runtime\Hardened.Web.AspNetCore.Runtime.csproj"/>
        <ProjectReference Include="..\..\Web\Hardened.Web.AspNetCore.Testing\Hardened.Web.AspNetCore.Testing.csproj"/>
        <ProjectReference Include="..\..\Web\Hardened.Web.Kestrel.Runtime\Hardened.Web.Kestrel.Runtime.csproj"/>
        <ProjectReference Include="..\..\Web\Hardened.Web.Kestrel.Testing\Hardened.Web.Kestrel.Testing.csproj"/>
        <ProjectReference Include="..\..\Web\Hardened.Web.Runtime\Hardened.Web.Runtime.csproj"/>
        <ProjectReference Include="..\..\Web\Hardened.Web.StaticContent\Hardened.Web.StaticContent.csproj"/>
        <ProjectReference Include="..\..\Web\Hardened.Web.Testing\Hardened.Web.Testing.csproj"/>
    </ItemGroup>

    <!--
      The AWS packages. They were another repository until 2026-09-06, so nothing checked their
      surface at all; a repository edge was doing the job this file does. Section 7 of the
      repository move is explicit that the edge is the weaker of the two.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\Clouds\Aws\Hardened.Amz.Cdk\Hardened.Amz.Cdk.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Clients\DynamoDb\Hardened.Amz.DynamoDbClient\Hardened.Amz.DynamoDbClient.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Clients\DynamoDb\Hardened.Amz.DynamoDbClient.Testing\Hardened.Amz.DynamoDbClient.Testing.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Lambda\DynamoDbStream\Hardened.Amz.Function.DDB.Runtime\Hardened.Amz.Function.DDB.Runtime.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Lambda\DynamoDbStream\Hardened.Amz.Function.DDB.Testing\Hardened.Amz.Function.DDB.Testing.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Lambda\Function\Hardened.Amz.Function.Lambda.Runtime\Hardened.Amz.Function.Lambda.Runtime.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Lambda\Function\Hardened.Amz.Function.Lambda.Testing\Hardened.Amz.Function.Lambda.Testing.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Lambda\Sqs\Hardened.Amz.Function.Sqs.Runtime\Hardened.Amz.Function.Sqs.Runtime.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Lambda\Sqs\Hardened.Amz.Function.Sqs.Testing\Hardened.Amz.Function.Sqs.Testing.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Lambda\Shared\Hardened.Amz.Shared.Lambda.Runtime\Hardened.Amz.Shared.Lambda.Runtime.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Lambda\Shared\Hardened.Amz.Shared.Lambda.Testing\Hardened.Amz.Shared.Lambda.Testing.csproj"/>
        <ProjectReference Include="..\..\Clouds\Aws\Lambda\Web\Hardened.Amz.Web.Lambda.Runtime\Hardened.Amz.Web.Lambda.Runtime.csproj"/>
    </ItemGroup>

</Project>
