        <ProjectReference Include="..\..\Clients\Hardened.Kiota.Testing\Hardened.Kiota.Testing.csproj"/>
        <ProjectReference Include="..\..\Clouds\Azure\Hardened.Azure.Functions.Blobs\Hardened.Azure.Functions.Blobs.csproj"/>
