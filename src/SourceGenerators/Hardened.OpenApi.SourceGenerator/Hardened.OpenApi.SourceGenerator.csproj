<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Description>Generates Hardened models, service interfaces, handlers and routing from an OpenAPI document at build time.</Description>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>

        <!--
            Unchanged, and it cannot change: NuGet only auto-imports build/$(PackageId).targets, so
            the package id and the targets file name are one decision. Every $(HardenedOpenApi*)
            property, @(HardenedOpenApiSpec), the HOAT/HOAG diagnostic codes and the
            .openapi-model.txt suffix are consumer-visible for the same reason and stay as they are.
        -->
        <PackageId>Hardened.OpenApi.SourceGenerator</PackageId>
        <IncludeBuildOutput>false</IncludeBuildOutput>

        <!--
            This package is now a front end: the OpenAPI reader, as an MSBuild task, plus the targets
            that run it. The Roslyn generator it used to carry moved to Hardened.Idl.SourceGenerator,
            which reads the normalised model this task writes and knows nothing about OpenAPI - so a
            second description language is a sibling of this package rather than something that has
            to inherit from it.

            The project therefore compiles no source of its own and produces an empty assembly that
            is not packed.
        -->
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>

    <!--
        The generator half, as a real dependency rather than a copy. Both this package and
        Hardened.Smithy.SourceGenerator depend on it, so a project using both gets exactly one
        analyzer - which packing the DLL into each front end would not give.

        Deliberately without ReferenceOutputAssembly="false", unlike the build task below. Pack
        builds its dependency group from project references where that attribute is not false, so
        setting it here does not merely skip an assembly reference - it drops the nuspec dependency
        entirely. This package carried it through 0.6.0-rc1000 and shipped to nuget.org with an
        empty <dependencies/> and no analyzers/ folder: the build task ran, wrote the normalised
        model, and nothing generated code from it. Nothing in the repository could notice, because
        every SUT references the generator as OutputItemType="Analyzer" directly.

        The reference costs an unused assembly reference on a project that compiles no source, and
        IncludeBuildOutput=false keeps it out of the package.

        PrivateAssets="none" for the other half of the same failure. PrivateAssets defaults to
        contentfiles;analyzers;build, and pack turns that into exclude="Build,Analyzers" on the
        nuspec dependency - so a consumer would restore Hardened.Idl.SourceGenerator and then
        suppress the only thing in it, an analyzers/dotnet/cs assembly. Restoring the generator and
        not running it fails exactly the way not restoring it does.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Hardened.Idl.SourceGenerator\Hardened.Idl.SourceGenerator.csproj"
                          PrivateAssets="none"/>
    </ItemGroup>

    <!--
        The build task is built before anything can consume it, and packed into tasks/ below.
        ReferenceOutputAssembly is false because nothing here binds against it: the task runs in
        MSBuild, the generator runs in Roslyn, and they share source rather than an assembly.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Hardened.OpenApi.BuildTask\Hardened.OpenApi.BuildTask.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"
                          SetTargetFramework="TargetFramework=net8.0"/>
    </ItemGroup>

    <!--
        PackagePath must use a forward slash. A trailing backslash packs to "build//" on Linux and
        macOS, and NuGet only auto-imports build/$(PackageId).targets - so at "build//" the file
        shipped and was never imported. That was survivable when this targets file only declared
        CompilerVisibleProperty entries; it is not now that it carries the build task that parses
        every spec.
    -->
    <ItemGroup>
        <Content Include="Package\Hardened.OpenApi.SourceGenerator.*">
            <Pack>true</Pack>
            <PackagePath>build/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>

        <!-- The document export's targets, imported by this package's own; see the web generator's
             csproj for why all three packages carry it. -->
        <Content Include="..\Hardened.OpenApiDocument.BuildTask\Package\Hardened.OpenApiDocument.targets">
            <Link>Package\Hardened.OpenApiDocument.targets</Link>
            <Pack>true</Pack>
            <PackagePath>build/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <!--
        The export task, beside this package's own task in tasks/. Only the files the sibling task
        does not already ship, because NuGet refuses a second copy of a file at one path and the two
        tasks share most of their .NET Framework dependencies.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Hardened.OpenApiDocument.BuildTask\Hardened.OpenApiDocument.BuildTask.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"
                          SetTargetFramework="TargetFramework=net8.0"/>
        <_HardenedOwnTaskFile Include="..\Hardened.OpenApi.BuildTask\bin\$(Configuration)\net472\**\*.dll"/>
        <None Include="..\Hardened.OpenApiDocument.BuildTask\bin\$(Configuration)\net472\**\*.dll"
              Exclude="@(_HardenedOwnTaskFile->'..\Hardened.OpenApiDocument.BuildTask\bin\$(Configuration)\net472\%(Filename)%(Extension)')"
              Pack="true" PackagePath="tasks/net472" Visible="false"/>
        <None Include="..\Hardened.OpenApiDocument.BuildTask\bin\$(Configuration)\net8.0\Hardened.OpenApiDocument.BuildTask.dll"
              Pack="true" PackagePath="tasks/net8.0" Visible="false"/>
    </ItemGroup>

    <!--
        Pack both task flavours. The targets file selects between them on $(MSBuildRuntimeType), so
        the same package serves Visual Studio's .NET Framework MSBuild and the CLI's .NET one.
    -->
    <ItemGroup>
        <None Include="..\Hardened.OpenApi.BuildTask\bin\$(Configuration)\net472\**\*.dll"
              Pack="true" PackagePath="tasks/net472" Visible="false"/>
        <None Include="..\Hardened.OpenApi.BuildTask\bin\$(Configuration)\net8.0\**\*.dll"
              Pack="true" PackagePath="tasks/net8.0" Visible="false"/>
    </ItemGroup>

</Project>
