<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../CSharpAuthor.props"/>

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Description>Source generator that produces Hardened models, service interfaces, handlers and routing from an OpenAPI document at build time.</Description>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.OpenApi.SourceGenerator</PackageId>
        <IncludeBuildOutput>false</IncludeBuildOutput>

        <!--
          Build-only. This does not stop the package flowing to consumers on its own - only
          PrivateAssets on the reference does that - but it is what makes `dotnet add package`
          write PrivateAssets for you, so the next reference starts out right.
        -->
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Hardened.OpenApi.SourceGenerator.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
        <PackageReference Include="Microsoft.Extensions.Primitives" Version="8.0.0" />
        <PackageReference Include="System.Memory" Version="4.5.5" />
    </ItemGroup>

    <!--
        The build task is built before anything can consume it, and packed into tasks/ below.
        ReferenceOutputAssembly is false because nothing here binds against it: the task runs in
        MSBuild, this runs in Roslyn, and they share source rather than an assembly.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Hardened.OpenApi.BuildTask\Hardened.OpenApi.BuildTask.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"
                          SetTargetFramework="TargetFramework=net8.0"/>
    </ItemGroup>

    <!--
        PackagePath must use a forward slash. A trailing backslash packs to "build//" on Linux and
        macOS, and NuGet only auto-imports build/$(PackageId).targets - so at "build//" the file
        shipped and was never imported. That was survivable when this targets file only declared
        CompilerVisibleProperty entries; it is not now that it carries the build task that parses
        every spec.
    -->
    <ItemGroup>
        <Content Include="Package\Hardened.OpenApi.SourceGenerator.*">
            <Pack>true</Pack>
            <PackagePath>build/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <!--
        The analyzer DLL, which now carries no dependencies of its own. Microsoft.OpenApi,
        Microsoft.OpenApi.Readers and SharpYaml used to be embedded here as resources and loaded
        through an AppDomain.AssemblyResolve hook, because Roslyn hosts do not reliably resolve
        co-located analyzer dependencies. All of that moved to the build task, where dependencies
        resolve normally.
    -->
    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

    <!--
        Pack both task flavours. The targets file selects between them on $(MSBuildRuntimeType), so
        the same package serves Visual Studio's .NET Framework MSBuild and the CLI's .NET one.
    -->
    <ItemGroup>
        <None Include="..\Hardened.OpenApi.BuildTask\bin\$(Configuration)\net472\**\*.dll"
              Pack="true" PackagePath="tasks/net472" Visible="false"/>
        <None Include="..\Hardened.OpenApi.BuildTask\bin\$(Configuration)\net8.0\**\*.dll"
              Pack="true" PackagePath="tasks/net8.0" Visible="false"/>
    </ItemGroup>

    <!-- Shared with the build task. See Hardened.Idl.Shared for why this is source and not a reference. -->
    <ItemGroup>
        <Compile Include="../Hardened.Idl.Shared/**/*.cs"
                 Exclude="../Hardened.Idl.Shared/obj/**/*;../Hardened.Idl.Shared/bin/**/*">
            <Link>Shared\Idl\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
    </ItemGroup>

    <!-- Link shared code from Hardened.SourceGenerator -->
    <ItemGroup>
        <Compile Include="../Hardened.SourceGenerator/Shared/**/*">
            <Link>Shared\%(RecursiveDir)/%(FileName)%(Extension)</Link>
        </Compile>
        <Compile Include="../Hardened.SourceGenerator/Links/**/*">
            <Link>Links\%(RecursiveDir)/%(FileName)%(Extension)</Link>
        </Compile>
        <Compile Include="../Hardened.SourceGenerator/Models/**/*">
            <Link>Models\Shared\%(RecursiveDir)/%(FileName)%(Extension)</Link>
        </Compile>
        <Compile Include="../Hardened.SourceGenerator/OpenApiDocument/**/*">
            <Link>OpenApiDocument\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
        <Compile Include="../Hardened.SourceGenerator/Requests/**/*">
            <Link>Requests\%(RecursiveDir)/%(FileName)%(Extension)</Link>
        </Compile>
        <Compile Include="../Hardened.SourceGenerator/Templates/**/*">
            <Link>Templates\%(RecursiveDir)/%(FileName)%(Extension)</Link>
        </Compile>
        <Compile Include="../Hardened.SourceGenerator/Web/Routing/**/*">
            <Link>Web\Routing\%(RecursiveDir)/%(FileName)%(Extension)</Link>
        </Compile>
        <Compile Include="../Hardened.SourceGenerator/Web/WebExecutionHandlerCodeGenerator.cs">
            <Link>Web\WebExecutionHandlerCodeGenerator.cs</Link>
        </Compile>
    </ItemGroup>


    <!--
        CSharpAuthor ships as source and is compiled in, so its files are analysed as if they were
        ours - and it predates nullable reference types. Under ContinuousIntegrationBuild every
        warning is an error, so its eight would fail the build. Scoped to the exact IDs rather than
        disabling nullable analysis, which would take our own code with it.
    -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);CS8603;CS8604;CS8765;CS8767</NoWarn>
    </PropertyGroup>

</Project>
