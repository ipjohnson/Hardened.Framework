<Project>
    <PropertyGroup>
        <ExcludeGeneratedCodeFromCoverage Condition="'$(ExcludeGeneratedCodeFromCoverage)' == ''">true</ExcludeGeneratedCodeFromCoverage>
        <!-- Write generated files to disk so IDEs that struggle with AdditionalText-only generators can index them -->
        <EmitCompilerGeneratedFiles Condition="'$(EmitCompilerGeneratedFiles)' == ''">true</EmitCompilerGeneratedFiles>
    </PropertyGroup>
    <ItemGroup>
        <CompilerVisibleProperty Include="ExcludeGeneratedCodeFromCoverage"/>
        <CompilerVisibleProperty Include="HardenedOpenApiNamespace"/>
    </ItemGroup>

    <!--
        The spec is parsed by an MSBuild task, before the compiler runs, and the generator reads the
        normalised model the task writes. MSBuild runs first, so a file it puts into @(Compile) or
        @(AdditionalFiles) is indistinguishable from one a human wrote - which is also what will let
        spec-driven patterns reach [GeneratedRegex], something a generator cannot emit for itself.
    -->
    <PropertyGroup>
        <_HardenedOpenApiTasksDir Condition="'$(MSBuildRuntimeType)' == 'Core'">$(MSBuildThisFileDirectory)../tasks/net8.0/</_HardenedOpenApiTasksDir>
        <_HardenedOpenApiTasksDir Condition="'$(MSBuildRuntimeType)' != 'Core'">$(MSBuildThisFileDirectory)../tasks/net472/</_HardenedOpenApiTasksDir>
        <HardenedOpenApiTaskAssembly Condition="'$(HardenedOpenApiTaskAssembly)' == ''">$(_HardenedOpenApiTasksDir)Hardened.OpenApi.BuildTask.dll</HardenedOpenApiTaskAssembly>

        <!--
            The .NET task host, which lets .NET Framework MSBuild run a task in a .NET process.
            MSBuild 18.0 ships with .NET SDK 10 and Visual Studio 2026; $(MSBuildVersion) is checked
            for emptiness first because the version comparison errors on an empty string.
        -->
        <HardenedOpenApiNetTaskAssembly Condition="'$(HardenedOpenApiNetTaskAssembly)' == ''">$(MSBuildThisFileDirectory)../tasks/net8.0/Hardened.OpenApi.BuildTask.dll</HardenedOpenApiNetTaskAssembly>
        <_HardenedOpenApiUseNetTaskHost>false</_HardenedOpenApiUseNetTaskHost>
        <_HardenedOpenApiUseNetTaskHost
            Condition="'$(MSBuildRuntimeType)' != 'Core' And '$(MSBuildVersion)' != '' And $([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))">true</_HardenedOpenApiUseNetTaskHost>
    </PropertyGroup>

    <!--
        Out of process, always.

        A task assembly is loaded into MSBuild itself, and on .NET Framework that means the default
        AppDomain, where assembly identity is global and the only binding redirects are the ones
        Microsoft.Build ships for its own dependencies. Visual Studio has already loaded a
        System.Text.Json by the time this runs; the OpenAPI reader wants its own. In process that is
        a FileLoadException at task execution, and nothing in this repository can fix it, because
        the config file that would is MSBuild's.

        A task host is a fresh process with none of that in it. The usual objection - a process per
        invocation - does not apply here: this task runs once per project and spends its time
        parsing megabytes of YAML, so the launch is not measurable against the work.

        It also fixes a second thing. The task assembly is built by the same build that consumes it
        in this repository's own integration tests, and an in-process task is held open afterwards,
        so an edited task is silently ignored until the MSBuild nodes die. That is what
        TaskHostFactory is recommended for.
    -->
    <UsingTask TaskName="Hardened.OpenApi.BuildTask.ExtractOpenApiSpec"
               Condition="'$(_HardenedOpenApiUseNetTaskHost)' == 'true'"
               Runtime="NET"
               AssemblyFile="$(HardenedOpenApiNetTaskAssembly)"/>

    <UsingTask TaskName="Hardened.OpenApi.BuildTask.ExtractOpenApiSpec"
               Condition="'$(_HardenedOpenApiUseNetTaskHost)' != 'true' And '$(HardenedOpenApiInProcessTask)' != 'true'"
               TaskFactory="TaskHostFactory"
               AssemblyFile="$(HardenedOpenApiTaskAssembly)"/>

    <!--
        In process, for the case the task host cannot serve: a build that produces the task assembly
        it is about to run. Set HardenedOpenApiInProcessTask=true to opt in, and expect the assembly
        to stay locked afterwards.
    -->
    <UsingTask TaskName="Hardened.OpenApi.BuildTask.ExtractOpenApiSpec"
               Condition="'$(_HardenedOpenApiUseNetTaskHost)' != 'true' And '$(HardenedOpenApiInProcessTask)' == 'true'"
               AssemblyFile="$(HardenedOpenApiTaskAssembly)"/>

    <!--
        The files the task will write are declared here, at the top level, and NOT inside the target
        that writes them.

        An IDE builds its project model out of MSBuild *evaluation*, not out of a build. Rider has no
        CompileDesignTime target at all, so a file that only becomes a @(Compile) item while some
        target is running is a file the editor never hears about: the spec-derived models and service
        interfaces resolve on the compiler command line and nowhere else, and every reference to them
        reddens in a project that builds clean. Same for @(AdditionalFiles) - the generator reading
        the model produces nothing in-editor if the model is not in view at evaluation. The source
        generator this replaced never had the problem, because Roslyn runs generators inside the
        IDE's own compilation.

        Top level is also what makes the paths resolvable. MSBuild evaluates every top-level ItemGroup
        in a pass that runs after every property and every import, so $(IntermediateOutputPath) is
        final here even though it is still empty at the point a csproj body imports this file - which
        is why these paths can be spelled here but not in a PropertyGroup beside them, and why
        HardenedOpenApiResolveModelDir below still has to be a target.

        Transforms of @(HardenedOpenApiSpec), not a glob of the output directory: on a clean tree the
        files do not exist yet, and a glob would come back empty on exactly the build that has to
        declare them. Deriving from the specs also means deleting a spec drops its generated code from
        the compilation, rather than leaving whatever an earlier build wrote to be picked up.
    -->
    <ItemGroup Condition="'@(HardenedOpenApiSpec)' != ''">
        <!--
            One document is routinely sliced differently by several projects, and can be sliced more
            than once within one - so the output is keyed on the slice as well as the file, or two
            slices of github.yaml would both write github.g.cs. Empty for an unsliced spec, which
            keeps every existing path exactly as it was.
        -->
        <HardenedOpenApiSpec Update="@(HardenedOpenApiSpec)">
            <SliceSuffix Condition="'%(HardenedOpenApiSpec.Slice)' != ''">.%(HardenedOpenApiSpec.Slice)</SliceSuffix>
        </HardenedOpenApiSpec>

        <_HardenedOpenApiModel Condition="'$(HardenedOpenApiModelDir)' == ''"
                               Include="@(HardenedOpenApiSpec->'$(IntermediateOutputPath)openapi/%(Filename)%(SliceSuffix).openapi-model.txt')"/>
        <_HardenedOpenApiModel Condition="'$(HardenedOpenApiModelDir)' != ''"
                               Include="@(HardenedOpenApiSpec->'$(HardenedOpenApiModelDir)%(Filename)%(SliceSuffix).openapi-model.txt')"/>

        <_HardenedOpenApiSource Condition="'$(HardenedOpenApiGeneratedDir)' == '' And '$(HardenedOpenApiModelDir)' == ''"
                                Include="@(HardenedOpenApiSpec->'$(IntermediateOutputPath)openapi/generated/%(Filename)%(SliceSuffix).g.cs')"/>
        <_HardenedOpenApiSource Condition="'$(HardenedOpenApiGeneratedDir)' == '' And '$(HardenedOpenApiModelDir)' != ''"
                                Include="@(HardenedOpenApiSpec->'$(HardenedOpenApiModelDir)generated/%(Filename)%(SliceSuffix).g.cs')"/>
        <_HardenedOpenApiSource Condition="'$(HardenedOpenApiGeneratedDir)' != ''"
                                Include="@(HardenedOpenApiSpec->'$(HardenedOpenApiGeneratedDir)%(Filename)%(SliceSuffix).g.cs')"/>

        <AdditionalFiles Include="@(_HardenedOpenApiModel)"/>
        <Compile Include="@(_HardenedOpenApiSource)" Visible="false"/>
    </ItemGroup>

    <!--
        The directories the task writes to repeat the defaults above because they have to be resolved
        inside a target. $(IntermediateOutputPath) is set by Microsoft.Common.CurrentVersion.targets,
        so at import time it is defined for a package - build/*.targets is imported last - and empty
        for anyone importing this file from the body of a csproj. Empty meant the models were written
        to ./openapi/ beside the project instead of into obj/, and because that directory then
        survived every clean, the Inputs/Outputs check reported the target up to date while the
        compiler saw no models at all.

        The repetition is guarded rather than eliminated: if the two ever disagree, the task writes
        somewhere the compilation is not looking, and HOAT004 below fails the build naming the file
        that is missing.
    -->
    <Target Name="HardenedOpenApiResolveModelDir">
        <PropertyGroup>
            <HardenedOpenApiModelDir Condition="'$(HardenedOpenApiModelDir)' == ''">$(IntermediateOutputPath)openapi/</HardenedOpenApiModelDir>
            <HardenedOpenApiGeneratedDir Condition="'$(HardenedOpenApiGeneratedDir)' == ''">$(HardenedOpenApiModelDir)generated/</HardenedOpenApiGeneratedDir>
            <HardenedOpenApiNamespace Condition="'$(HardenedOpenApiNamespace)' == ''">$(RootNamespace)</HardenedOpenApiNamespace>
            <HardenedOpenApiNamespace Condition="'$(HardenedOpenApiNamespace)' == ''">Generated</HardenedOpenApiNamespace>
        </PropertyGroup>
    </Target>

    <!--
        The task both emits C# and writes the normalised model, because it has the parsed spec in
        hand either way and parsing it twice is the one thing this design exists to avoid.

        Inputs/Outputs so an untouched spec does not re-run. The outputs are the same items the
        compilation was handed at evaluation, so the up-to-date check is made against exactly the
        files the compiler will open - MSBuild has to be able to list a target's outputs without
        running it, which is the whole reason the task emits one file per spec rather than one per
        type.
    -->
    <!--
        The filter is item metadata, so changing it does not touch the spec file, and the
        up-to-date check below would skip the target and leave the previous slice's output in place.
        Writing it to a stamp gives the check something whose timestamp moves when the filter
        changes - and only then, which is what WriteOnlyWhenDifferent is for.

        A dependency rather than a BeforeTargets, because a target's Inputs are read after its
        DependsOnTargets have run: the stamp has to exist before it is compared against.
    -->
    <Target Name="HardenedOpenApiFilterStamp" DependsOnTargets="HardenedOpenApiResolveModelDir">
        <MakeDir Directories="$(HardenedOpenApiModelDir)"/>

        <WriteLinesToFile
            File="$(HardenedOpenApiModelDir)filters.stamp"
            Lines="@(HardenedOpenApiSpec->'%(Identity)|%(Slice)|%(IncludePaths)|%(ExcludePaths)|%(Tags)')"
            Overwrite="true"
            WriteOnlyWhenDifferent="true"/>
    </Target>

    <Target Name="HardenedOpenApiExtractSpecs"
            DependsOnTargets="HardenedOpenApiResolveModelDir;HardenedOpenApiFilterStamp"
            BeforeTargets="CoreCompile"
            Condition="'@(HardenedOpenApiSpec)' != ''"
            Inputs="@(HardenedOpenApiSpec);$(HardenedOpenApiModelDir)filters.stamp"
            Outputs="@(_HardenedOpenApiModel);@(_HardenedOpenApiSource)">

        <ExtractOpenApiSpec Specs="@(HardenedOpenApiSpec)"
                            OutputDirectory="$(HardenedOpenApiModelDir)"
                            GeneratedSourceDirectory="$(HardenedOpenApiGeneratedDir)"
                            Namespace="$(HardenedOpenApiNamespace)"
                            ExcludeFromCoverage="$(ExcludeGeneratedCodeFromCoverage)"
                            ApplyServerBasePath="$(HardenedOpenApiApplyServerBasePath)"
                            EmbedDocument="$(HardenedOpenApiEmbedDocument)"
                            GroupUntaggedByPath="$(HardenedOpenApiGroupUntaggedByPath)"
                            LoadExternalRefs="$(HardenedOpenApiLoadExternalRefs)"
                            EmitUnreferencedSchemas="$(HardenedOpenApiEmitUnreferencedSchemas)">
            <Output TaskParameter="ModelFiles" ItemName="_HardenedOpenApiModelWritten"/>
            <Output TaskParameter="GeneratedSources" ItemName="_HardenedOpenApiSourceWritten"/>
        </ExtractOpenApiSpec>
    </Target>

    <!--
        Runs even when the target above is skipped as up to date, because that is the case worth
        catching: a spec whose model or generated source is not on disk means the up-to-date check
        was made against files that are not there, or that the task wrote them somewhere other than
        where evaluation said they would be. Either way the compiler is about to open a file that
        does not exist. Silence would surface as an empty generator run and a project full of
        missing types.
    -->
    <Target Name="HardenedOpenApiVerifyModels"
            DependsOnTargets="HardenedOpenApiExtractSpecs"
            BeforeTargets="CoreCompile"
            Condition="'@(HardenedOpenApiSpec)' != ''">

        <!--
            Specs at build time but nothing declared at evaluation means this file was imported above
            the @(HardenedOpenApiSpec) declaration: top-level item groups are evaluated in document
            order, so the ItemGroup up top saw an empty list and put nothing into @(Compile). The
            build would still succeed - HardenedOpenApiExtractSpecs writes the files either way - and
            every spec-derived type would be missing from the compilation. Fail here instead.
        -->
        <Error Condition="'@(_HardenedOpenApiSource)' == ''"
               Code="HOAT005"
               Text="Hardened.OpenApi.SourceGenerator.targets was imported before these specs were declared: @(HardenedOpenApiSpec). No generated source reached the compilation. Move the &lt;Import&gt; below the &lt;HardenedOpenApiSpec&gt; item group."/>

        <Error Condition="!Exists('%(_HardenedOpenApiModel.FullPath)')"
               Code="HOAT004"
               Text="The OpenAPI model '%(_HardenedOpenApiModel.Identity)' was not written. Delete $(HardenedOpenApiModelDir) and rebuild."/>

        <Error Condition="!Exists('%(_HardenedOpenApiSource.FullPath)')"
               Code="HOAT004"
               Text="The generated OpenAPI source '%(_HardenedOpenApiSource.Identity)' was not written. Delete $(HardenedOpenApiModelDir) and rebuild."/>
    </Target>

    <!--
        Specs used to be declared as AdditionalFiles and parsed inside the generator. That silently
        generates nothing now, so say so rather than leaving the author to find an empty obj folder.
    -->
    <Target Name="HardenedOpenApiWarnOnLegacySpecItems" BeforeTargets="HardenedOpenApiExtractSpecs">
        <Error Condition="'@(HardenedOpenApiSpec)' == '' And '@(AdditionalFiles)' != '' And '%(AdditionalFiles.Extension)' == '.yaml'"
               Code="HOAT003"
               Text="OpenAPI specs are declared with &lt;HardenedOpenApiSpec Include=&quot;%(AdditionalFiles.Identity)&quot; /&gt; rather than &lt;AdditionalFiles&gt;. The generator no longer reads yaml directly - a build task parses it first."/>
    </Target>
</Project>
