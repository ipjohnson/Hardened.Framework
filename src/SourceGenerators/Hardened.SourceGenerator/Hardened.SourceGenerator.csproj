<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../CSharpAuthor.props"/>

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Description>Shared source library compiled into the Hardened source generators. Not referenced directly by application projects.</Description>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>

        <!--
          Build-only. This does not stop the package flowing to consumers on its own - only
          PrivateAssets on the reference does that - but it is what makes `dotnet add package`
          write PrivateAssets for you, so the next reference starts out right.
        -->
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>

    
    
    <!--
        A diagnostic descriptor is built per call rather than held in a static field, because RS2008
        looks for the field and these projects set EnforceExtendedAnalyzerRules - so a test that
        wants to assert a message or a severity has to call the builder, and the builders are
        internal. The generator projects that compile these files in as source see them already;
        this one is referenced rather than linked, so it needs saying.

        Same arrangement Hardened.Idl.SourceGenerator and Hardened.OpenApi.BuildTask already use.
        An MSBuild item rather than source, so it does not travel with the .cs files this package
        ships.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="Hardened.SourceGenerator.Tests"/>
    </ItemGroup>

    <!--
        Both directions embed a document and both compress it the same way, but this assembly and
        Hardened.Idl.Emit share no project - so the source is linked in, which is the arrangement
        already used in the other direction for OpenApiDocument/**.
    -->
    <!--
        The description model and the helpers that read it. Linked here rather than referenced
        because this project is the spine both generator wrappers compile in, and the bridge from
        an OperationModel to a RequestHandlerModel has to reach both: the described front-ends
        have always used it, and code-first is moving onto it.

        One list, feeding both <Compile> and <Content>, because they have to agree and twice they
        have not. This package ships as source, and the <Content Include="**\*.cs"> glob below
        matches relative to this project directory - so a file linked in from Hardened.Idl.Shared
        compiles here and is absent from the package unless it is packed by name. That is invisible
        in this repository, where the project reference makes it resolve either way, and it fails
        in the consumer that compiles the shipped source:

          hardened.sourcegenerator/<v>/src/Hardened.SourceGenerator/SpecBridge/SpecHandlerModelBuilder.cs(2,20):
            error CS0234: The type or namespace name 'Models' does not exist in the namespace 'Hardened.Idl'

        GZipLiteral.cs was packed by name after Hardened.Amz 0.8.0-rc1000 hit it. The Models/ files
        and the helpers beside them were added later and were not, so Hardened.Amz hit the same
        thing again. Deriving both item lists from this one is what stops a third time: a file added
        here is compiled and packed by construction, and cannot be added to one and not the other.

        LinkDir is the directory the file takes inside this project, and PackagePath below puts it
        at the same place inside the package - so the shipped source finds it exactly where the
        `using` written against the linked layout expects.
    -->
    <ItemGroup>
        <HardenedIdlModelSource Include="../Hardened.Idl.Shared/Models/**/*.cs"/>

        <HardenedIdlHelperSource Include="../Hardened.Idl.Shared/TypeMapper.cs"/>
        <HardenedIdlHelperSource Include="../Hardened.Idl.Shared/NamingHelper.cs"/>
        <HardenedIdlHelperSource Include="../Hardened.Idl.Shared/DefaultLiteral.cs"/>
        <HardenedIdlHelperSource Include="../Hardened.Idl.Shared/SchemaShape.cs"/>
        <HardenedIdlHelperSource Include="../Hardened.Idl.Shared/EnumWireForm.cs"/>
        <HardenedIdlHelperSource Include="../Hardened.Idl.Shared/DefaultErrorBody.cs"/>

        <HardenedIdlSharedDirSource Include="../Hardened.Idl.Shared/GZipLiteral.cs"/>
    </ItemGroup>

    <!--
        PackagePath is a literal per group rather than item metadata. %(LinkDir)-style metadata does
        not expand inside PackagePath - NuGet reads it as a plain string - and the files land flat in
        the package root, where they are one same-named file away from colliding with this project's
        own. Three groups is the price of that being checkable by reading it.
    -->
    <ItemGroup>
        <Compile Include="@(HardenedIdlModelSource)">
            <Link>Idl/Models/%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
        <Content Include="@(HardenedIdlModelSource)" Pack="true"
                 PackagePath="src\Hardened.SourceGenerator\Idl\Models\" PackageCopyToOutput="true"/>

        <Compile Include="@(HardenedIdlHelperSource)">
            <Link>Idl/%(FileName)%(Extension)</Link>
        </Compile>
        <Content Include="@(HardenedIdlHelperSource)" Pack="true"
                 PackagePath="src\Hardened.SourceGenerator\Idl\" PackageCopyToOutput="true"/>

        <Compile Include="@(HardenedIdlSharedDirSource)">
            <Link>Shared/%(FileName)%(Extension)</Link>
        </Compile>
        <Content Include="@(HardenedIdlSharedDirSource)" Pack="true"
                 PackagePath="src\Hardened.SourceGenerator\Shared\" PackageCopyToOutput="true"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Primitives" Version="8.0.0" />
        <PackageReference Include="System.Memory" Version="4.5.5" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Package\HardenedSourceGenerator*" />
        <Content Include="Package\Hardened.SourceGenerator.*">
            <Pack>true</Pack>
            <PackagePath>build\</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
        <Content Include="**\*.cs" Exclude="**\obj\**;**\bin\**" Visible="true">
            <Pack>true</Pack>
            <PackagePath>src\Hardened.SourceGenerator\</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>

        <!--
            GZipLiteral.cs and the rest of the linked Hardened.Idl.Shared source are packed with the
            <Compile> entries that pull them in, above - the glob here matches relative to this
            project directory and cannot reach outside it.
        -->
    </ItemGroup>

    <!--
        Validation/ builds a ValidationModules model and drives its emitter, so this project needs
        the same sources the generators that compile Validation/ in do - it compiles its own files
        to prove they build, and it ships them as source.
    -->
    <Import Project="../ValidationModulesImpl.props"/>

</Project>
