<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../CSharpAuthor.props"/>

    <!--
        The passes and emitters that turn a ServiceSpecModel into C#, sharing the spine's
        arrangement: consumers compile these files in via linked Compile items rather than
        referencing the assembly, because the build task runs in MSBuild and the source generator
        runs in Roslyn and neither can reference the other.

        Separate from Hardened.Generation.Shared rather than folded into it, because the two answer
        different questions. The spine is what a description means - models, naming, type mapping,
        the serialized form. This is what C# is written from it. A front end for a second
        description language needs both; a consumer that only reads the model needs one.

        Nothing here may reference Microsoft.OpenApi, and nothing here may know that references are
        spelled as JSON pointers - TypeMapper.MakeRef owns that. Those are the two ways this stops
        being reusable, and both compile fine inside the OpenAPI task, which is why the project
        exists on its own: the reference it does not have is the point.
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- The spine these operate on, compiled in for the same reason the consumers compile both. -->
    <!--
        CSharpAuthor ships as source and is compiled in, so its files are analysed as if they were
        ours - and it predates nullable reference types. Under ContinuousIntegrationBuild every
        warning is an error, so its eight would fail the build. Scoped to the exact IDs rather than
        disabling nullable analysis, which would take our own code with it.
    -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);CS8603;CS8604;CS8765;CS8767</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <HardenedGenerationScope>Full</HardenedGenerationScope>
    </PropertyGroup>

    <Import Project="../Hardened.Generation.Shared/Hardened.Generation.Shared.props"/>

</Project>
