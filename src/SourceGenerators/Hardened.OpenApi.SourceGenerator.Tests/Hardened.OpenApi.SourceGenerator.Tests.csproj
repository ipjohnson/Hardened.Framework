<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="Microsoft.OpenApi" Version="3.10.0"/>
        <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.10.0"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          Hardened.OpenApi.SourceGenerator is referenced as a normal assembly rather than an
          analyzer so a GeneratorDriver can drive it directly.

          Hardened.SourceGenerator is deliberately NOT referenced. It is compiled into
          Hardened.OpenApi.SourceGenerator via linked Compile items, so referencing both puts
          two copies of RequestHandlerModel, RouteTreeNode<T> and friends in scope and every
          use becomes ambiguous (CS0433).

          The four runtime projects are here as reference anchors: the code the generator
          emits binds against them, so GeneratorTestHarness cannot compile its output without
          them loaded.
        -->
        <!--
            The generator types used to resolve without a using, because this namespace was nested
            under theirs. They are neutral now and live in Hardened.Idl.SourceGenerator, so the
            tests say so once here rather than in every file.
        -->
        <Using Include="Hardened.Idl.SourceGenerator"/>

        <!--
            The generator half, which is where ServiceSpecModel and the routing table now live.
            Hardened.OpenApi.SourceGenerator is not referenced: it compiles no source of its own -
            it is the OpenAPI task plus its targets - and this project compiles the parser in
            directly below.
        -->
        <ProjectReference Include="..\Hardened.Idl.SourceGenerator\Hardened.Idl.SourceGenerator.csproj" />

        <!--
            The parser is compiled in rather than referenced from Hardened.OpenApi.BuildTask.
            Referencing that assembly would put a second copy of OpenApiSpecModel and friends in
            scope - it links the same Hardened.OpenApi.Shared sources - and every use would become
            ambiguous, the same CS0433 the note above describes for Hardened.SourceGenerator.
            Compiled in, the parser binds against the generator's copy of those types through
            InternalsVisibleTo, so there is exactly one.
        -->
        <Compile Include="..\Hardened.OpenApi.BuildTask\Parsing\**\*.cs" Link="Parsing\%(FileName)%(Extension)" />

        <!--
            The emitters, for the same reason. These tests assert on what a project ends up
            compiling, and that is the task's output and the generator's together - a handler binds
            against a record the task wrote, so a harness holding only the generator's half produces
            code that cannot compile and failures that point nowhere. The emitters' own behaviour is
            tested in Hardened.OpenApi.BuildTask.Tests.
        -->
        <Compile Include="..\Hardened.Idl.Emit\**\*.cs" Link="Emit\%(RecursiveDir)%(FileName)%(Extension)" Exclude="..\Hardened.Idl.Emit\obj\**\*;..\Hardened.Idl.Emit\bin\**\*;..\Hardened.Idl.Emit\IsExternalInit.cs" />

        <!--
            The spec front-end, for the same reason: these tests assert on what a project ends up
            compiling, and the parameter interfaces and their constraint attributes are half of that
            now.

            No ValidationModules sources here. The task writes plain attributes and stops - the IR
            and the emitters live behind Hardened.Validation.SourceGenerator, which reads those
            attributes back out of the compilation like any other. Compiling Impl in here bound this
            project to a Roslyn-free/Roslyn-coupled split it does not need and cannot police.
        -->
        <ProjectReference Include="..\Hardened.SourceGeneration.Testing\Hardened.SourceGeneration.Testing.csproj" />
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj" />
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj" />
        <ProjectReference Include="..\..\Shared\Hardened.Shared.Runtime\Hardened.Shared.Runtime.csproj" />
        <ProjectReference Include="..\..\Web\Hardened.Web.Runtime\Hardened.Web.Runtime.csproj" />
    </ItemGroup>

    <!--
        An explicit Include rather than Update over the default glob: an Update pattern's
        %(RecursiveDir) is computed from the Update glob on current SDKs, which flattens the copied
        tree, so the yaml landed beside the dll instead of under Fixtures/ and every test reading a
        fixture failed. A fresh Include keeps the relative path as the target path on every SDK.
    -->
    <ItemGroup>
        <Compile Remove="Fixtures/**/*.cs"/>
        <None Remove="Fixtures/**/*"/>
        <None Include="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
