<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
            The task only, and for the same reason its OpenAPI counterpart references only that one:
            every front end links the same Hardened.Idl.Shared sources, so referencing two would put
            two copies of ServiceSpecModel in scope and every use would be ambiguous.
        -->
        <ProjectReference Include="..\Hardened.Smithy.BuildTask\Hardened.Smithy.BuildTask.csproj"
                          SetTargetFramework="TargetFramework=net8.0"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Framework" Version="17.8.43"/>
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.8.43"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="Fixtures\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!--
        Both front ends' targets files, copied in so TargetsWiringTests can compare what they pass
        against what the shared task shell declares. Linked from their real locations rather than
        copied into this folder: a copy is a second thing to keep in step, and it would go stale in
        exactly the case the test exists to catch.

        The OpenAPI one is here rather than in its own test project because the shell is shared -
        a property added to ExtractSpecTask has to reach both, and splitting the check across two
        projects makes the second half easy to forget.
    -->
    <ItemGroup>
        <None Include="..\Hardened.Smithy.SourceGenerator\Package\Hardened.Smithy.SourceGenerator.targets"
              Link="Targets\Hardened.Smithy.SourceGenerator.targets"
              CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\Hardened.OpenApi.SourceGenerator\Package\Hardened.OpenApi.SourceGenerator.targets"
              Link="Targets\Hardened.OpenApi.SourceGenerator.targets"
              CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
