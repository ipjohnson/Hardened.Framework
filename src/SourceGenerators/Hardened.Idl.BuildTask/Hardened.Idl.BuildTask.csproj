<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../CSharpAuthor.props"/>
    <Import Project="../BuildTask.props"/>

    <PropertyGroup>
        <!--
            Nothing binds against this assembly's output. It exists so the shared task shell compiles
            standalone, which is what catches a dependency creeping in that a front end would then
            fail to load at task execution - the same guard Hardened.Generation.Shared provides for the IR.
        -->
        <IsPackable>false</IsPackable>

        <ExcludeAssets>runtime</ExcludeAssets>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="IsExternalInit.cs"/>
        <Compile Include="IsExternalInit.cs" Condition="'$(TargetFramework)' == 'net472'"/>
    </ItemGroup>

    <!--
        CSharpAuthor is compiled in from source and its ClassDefinition references System.Net.Http,
        which .NET Framework does not reference by default. This is the leg that runs under Visual
        Studio's MSBuild, and it is the first thing this project caught that a front end would
        otherwise have hit later and noisier.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
        <Reference Include="System.Net.Http"/>
    </ItemGroup>

    <!--
        Linked, not referenced. ServiceSpecModel is internal, so every front end compiles its own
        copy of the IR into its own assembly - which is what lets the shell name it in an abstract
        member without the model becoming public surface on a shipped MSBuild task.
    -->
    <ItemGroup>
        <Compile Include="../Hardened.Idl.Emit/**/*.cs"
                 Exclude="../Hardened.Idl.Emit/obj/**/*;../Hardened.Idl.Emit/bin/**/*;../Hardened.Idl.Emit/IsExternalInit.cs">
            <Link>Emit\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
    </ItemGroup>

    <!-- CSharpAuthor ships as source and predates nullable reference types. -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);CS8603;CS8604;CS8765;CS8767</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <HardenedGenerationScope>Full</HardenedGenerationScope>
    </PropertyGroup>

    <Import Project="../Hardened.Generation.Shared/Hardened.Generation.Shared.props"/>

</Project>
