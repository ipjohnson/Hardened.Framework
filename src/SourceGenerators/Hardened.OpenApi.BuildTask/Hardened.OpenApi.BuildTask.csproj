<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../CSharpAuthor.props"/>

    <PropertyGroup>
        <!--
            Two TFMs because MSBuild has two hosts: Visual Studio runs on .NET Framework, the dotnet
            CLI and Rider run on .NET. The targets file picks between them on $(MSBuildRuntimeType).
            A single netstandard2.0 assembly would load in both but would bind against whichever
            Microsoft.Build.* the host supplies, which is the arrangement that produces
            "could not load file or assembly" at task execution rather than at build.
        -->
        <TargetFrameworks>net472;net8.0</TargetFrameworks>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!-- Packed by Hardened.OpenApi.SourceGenerator into tasks/; this project ships nothing itself. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>

        <!--
            The task assembly is loaded by MSBuild, which supplies Microsoft.Build.* itself. Copying
            our own copies next to the task shadows the host's and produces type-identity failures
            that look like a missing method on ITaskItem.
        -->
        <ExcludeAssets>runtime</ExcludeAssets>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Hardened.OpenApi.BuildTask.Tests"/>

        <!--
            So the code-first round trip can close: that project emits an OpenAPI document from
            attribute routes and feeds it straight back through this parser, which is the only way
            to assert that operation ids and tags survive into the service interfaces a
            specification-first build produces rather than merely look as though they would.
        -->
        <InternalsVisibleTo Include="Hardened.Web.SourceGenerator.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <!--
            Pinned to the 17.8 line, which is the MSBuild that ships with the .NET 8 SDK this repo
            targets: the reference version is the minimum host the task can load into. The patch
            level matters separately - 17.8.3 carries GHSA-w3q9-fxm7-j8fq, and NuGet audit fails the
            CI build over it.

            ExcludeAssets=runtime because MSBuild supplies these itself. Shipping our own copies
            beside the task shadows the host's and produces type-identity failures that read as a
            missing method on ITaskItem.
        -->
        <PackageReference Include="Microsoft.Build.Framework" Version="17.8.43" ExcludeAssets="runtime" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.8.43" ExcludeAssets="runtime" PrivateAssets="all"/>

        <!--
            Referenced normally rather than embedded as resources. A task is an ordinary assembly
            loaded by MSBuild, so its dependencies resolve the ordinary way - the whole reason the
            spec read moves here.
        -->
        <!--
            3.x for OpenAPI 3.1, which the 1.6 line rejects outright with
            OpenApiUnsupportedSpecVersionException - and which is what OpenAI, Train Travel and a
            growing share of published descriptions are now written in. One object model reads 2.0,
            3.0, 3.1 and 3.2.

            Microsoft.OpenApi.Readers is gone: the reader moved into the main package at 2.0, and
            the separate package stops at 2.0.0-preview9. SharpYaml goes with it - the reader parses
            YAML itself and nothing here ever called into SharpYaml directly.

            The task runs out of process (see the targets file), which is what makes this safe on
            .NET Framework MSBuild: 3.x brings System.Text.Json, and resolving that inside Visual
            Studio's own MSBuild is the conflict a task host exists to avoid.
        -->
        <PackageReference Include="Microsoft.OpenApi" Version="3.10.0"/>

        <!--
            YAML is a separate package from 2.0 onward - the core package reads JSON and nothing
            else, and its reader has to be registered before a YAML document will parse. Every spec
            this was built against except two is YAML, so this is not optional.
        -->
        <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.10.0"/>
    </ItemGroup>

    <!-- TypeMapper, which the emitters use, returns CSharpAuthor type definitions. -->
    <ItemGroup>
        <Compile Remove="IsExternalInit.cs"/>
        <Compile Include="IsExternalInit.cs" Condition="'$(TargetFramework)' == 'net472'"/>
    </ItemGroup>

    <!--
        Microsoft.OpenApi 3.x keys an operation by System.Net.Http.HttpMethod, which .NET Framework
        does not reference by default. This is the leg that runs under Visual Studio's MSBuild.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
        <Reference Include="System.Net.Http"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../Hardened.Idl.Emit/**/*.cs"
                 Exclude="../Hardened.Idl.Emit/obj/**/*;../Hardened.Idl.Emit/bin/**/*;../Hardened.Idl.Emit/IsExternalInit.cs">
            <Link>Emit\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
    </ItemGroup>

    <!-- Shared with the generator. See Hardened.Idl.Shared for why this is source and not a reference. -->
    <ItemGroup>
        <Compile Include="../Hardened.Idl.Shared/**/*.cs"
                 Exclude="../Hardened.Idl.Shared/obj/**/*;../Hardened.Idl.Shared/bin/**/*">
            <Link>Shared\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
    </ItemGroup>

    <!--
        CSharpAuthor ships as source and is compiled in, so its files are analysed as if they were
        ours - and it predates nullable reference types. Under ContinuousIntegrationBuild every
        warning is an error, so its eight would fail the build. Scoped to the exact IDs rather than
        disabling nullable analysis, which would take our own code with it.
    -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);CS8603;CS8604;CS8765;CS8767</NoWarn>
    </PropertyGroup>

</Project>
