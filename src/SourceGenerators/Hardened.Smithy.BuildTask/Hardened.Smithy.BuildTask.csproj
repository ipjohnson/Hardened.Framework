<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../CSharpAuthor.props"/>
    <Import Project="../BuildTask.props"/>

    <PropertyGroup>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>

        <ExcludeAssets>runtime</ExcludeAssets>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Hardened.Smithy.BuildTask.Tests"/>
    </ItemGroup>

    <!--
        The AST is JSON and nothing else, so this front end needs no document reader at all - the
        whole of Microsoft.OpenApi and its YAML reader have no equivalent here. net8.0 has
        System.Text.Json in the box; .NET Framework does not.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
        <PackageReference Include="System.Text.Json"/>
        <Reference Include="System.Net.Http"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="IsExternalInit.cs"/>
        <Compile Include="IsExternalInit.cs" Condition="'$(TargetFramework)' == 'net472'"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../Hardened.Idl.Emit/**/*.cs"
                 Exclude="../Hardened.Idl.Emit/obj/**/*;../Hardened.Idl.Emit/bin/**/*;../Hardened.Idl.Emit/IsExternalInit.cs">
            <Link>Emit\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
    </ItemGroup>

    <!-- The task shell. Its own files only - not its links, which are the two above. -->
    <ItemGroup>
        <Compile Include="../Hardened.Idl.BuildTask/*.cs"
                 Exclude="../Hardened.Idl.BuildTask/IsExternalInit.cs">
            <Link>Task\%(FileName)%(Extension)</Link>
        </Compile>
    </ItemGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);CS8603;CS8604;CS8765;CS8767</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <HardenedGenerationScope>Full</HardenedGenerationScope>
    </PropertyGroup>

    <Import Project="../Hardened.Generation.Shared/Hardened.Generation.Shared.props"/>

</Project>
