<Project>
    <PropertyGroup>
        <ExcludeGeneratedCodeFromCoverage Condition="'$(ExcludeGeneratedCodeFromCoverage)' == ''">true</ExcludeGeneratedCodeFromCoverage>
        <!-- Write generated files to disk so IDEs that struggle with AdditionalText-only generators can index them -->
        <EmitCompilerGeneratedFiles Condition="'$(EmitCompilerGeneratedFiles)' == ''">true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <!--
        The generator that reads the model this task writes is Hardened.Idl.SourceGenerator, shared
        with every other front end, and it is told the namespace through the neutral property. Set
        from $(HardenedSmithyNamespace) below so a project only ever spells the Smithy one.
    -->
    <ItemGroup>
        <CompilerVisibleProperty Include="ExcludeGeneratedCodeFromCoverage"/>
        <CompilerVisibleProperty Include="HardenedIdlNamespace"/>
    </ItemGroup>

    <!--
        This task ingests a Smithy JSON AST, never a .smithy file. Given a .json on disk nothing is
        resolved, downloaded or executed, so the build is hermetic and works offline - which is why
        running the Smithy CLI's ast command with its flatten option, redirecting stdout to a file
        and committing the result, is a supported way to use this rather than a workaround.

        The Smithy CLI writes the AST to stdout and creates no file, and writes nothing at all when
        validation fails. A target that runs it therefore has to redirect stdout into a file itself
        and must not treat a zero-byte result as an empty model; the task reports that case rather
        than parsing it.
    -->
    <PropertyGroup>
        <_HardenedSmithyTasksDir Condition="'$(MSBuildRuntimeType)' == 'Core'">$(MSBuildThisFileDirectory)../tasks/net8.0/</_HardenedSmithyTasksDir>
        <_HardenedSmithyTasksDir Condition="'$(MSBuildRuntimeType)' != 'Core'">$(MSBuildThisFileDirectory)../tasks/net472/</_HardenedSmithyTasksDir>
        <HardenedSmithyTaskAssembly Condition="'$(HardenedSmithyTaskAssembly)' == ''">$(_HardenedSmithyTasksDir)Hardened.Smithy.BuildTask.dll</HardenedSmithyTaskAssembly>

        <HardenedSmithyNetTaskAssembly Condition="'$(HardenedSmithyNetTaskAssembly)' == ''">$(MSBuildThisFileDirectory)../tasks/net8.0/Hardened.Smithy.BuildTask.dll</HardenedSmithyNetTaskAssembly>
        <_HardenedSmithyUseNetTaskHost>false</_HardenedSmithyUseNetTaskHost>
        <_HardenedSmithyUseNetTaskHost
            Condition="'$(MSBuildRuntimeType)' != 'Core' And '$(MSBuildVersion)' != '' And $([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))">true</_HardenedSmithyUseNetTaskHost>
    </PropertyGroup>

    <!--
        Out of process, always, for the same reason the OpenAPI task is: a task assembly loads into
        MSBuild itself, and on .NET Framework that is the default AppDomain where assembly identity
        is global. Visual Studio has already loaded a System.Text.Json by the time this runs and this
        task wants its own, which in process is a FileLoadException at task execution. A task host is
        a fresh process with none of that in it, and the launch is not measurable against parsing an
        AST.
    -->
    <UsingTask TaskName="Hardened.Smithy.BuildTask.ExtractSmithySpec"
               Condition="'$(_HardenedSmithyUseNetTaskHost)' == 'true'"
               Runtime="NET"
               AssemblyFile="$(HardenedSmithyNetTaskAssembly)"/>

    <UsingTask TaskName="Hardened.Smithy.BuildTask.ExtractSmithySpec"
               Condition="'$(_HardenedSmithyUseNetTaskHost)' != 'true' And '$(HardenedSmithyInProcessTask)' != 'true'"
               TaskFactory="TaskHostFactory"
               AssemblyFile="$(HardenedSmithyTaskAssembly)"/>

    <!--
        In process, for the case the task host cannot serve: a build that produces the task assembly
        it is about to run. Expect the assembly to stay locked afterwards.
    -->
    <UsingTask TaskName="Hardened.Smithy.BuildTask.ExtractSmithySpec"
               Condition="'$(_HardenedSmithyUseNetTaskHost)' != 'true' And '$(HardenedSmithyInProcessTask)' == 'true'"
               AssemblyFile="$(HardenedSmithyTaskAssembly)"/>

    <UsingTask TaskName="Hardened.Smithy.BuildTask.GenerateSmithyAst"
               Condition="'$(_HardenedSmithyUseNetTaskHost)' == 'true'"
               Runtime="NET"
               AssemblyFile="$(HardenedSmithyNetTaskAssembly)"/>

    <UsingTask TaskName="Hardened.Smithy.BuildTask.GenerateSmithyAst"
               Condition="'$(_HardenedSmithyUseNetTaskHost)' != 'true' And '$(HardenedSmithyInProcessTask)' != 'true'"
               TaskFactory="TaskHostFactory"
               AssemblyFile="$(HardenedSmithyTaskAssembly)"/>

    <UsingTask TaskName="Hardened.Smithy.BuildTask.GenerateSmithyAst"
               Condition="'$(_HardenedSmithyUseNetTaskHost)' != 'true' And '$(HardenedSmithyInProcessTask)' == 'true'"
               AssemblyFile="$(HardenedSmithyTaskAssembly)"/>

    <!--
        Committing .smithy rather than a generated AST.
        =============================================

        @(HardenedSmithyModel) is the model's own source. The CLI turns it into an AST under obj/,
        which then joins @(HardenedSmithyAst) below and is read exactly like a committed one - so
        everything downstream is unchanged and a project can use either input, or both.

        What this buys is that the AST stops being a reviewed artifact that can silently disagree
        with the model it came from. What it costs is a Smithy CLI on the build machine, which is
        why $(HardenedSmithyAst) remains supported and hermetic.

        All @(HardenedSmithyModel) items form ONE model in one CLI invocation, because a Smithy model
        is routinely several files that only resolve together. A project needing two independent
        models generates them separately and points @(HardenedSmithyAst) at the results.
    -->
    <PropertyGroup>
        <!-- Names the generated AST, and therefore the model file and the generated source. -->
        <HardenedSmithyModelName Condition="'$(HardenedSmithyModelName)' == ''">$(MSBuildProjectName)</HardenedSmithyModelName>

        <!--
            The version this build is pinned to. Empty accepts whatever is installed, which is not
            what a shared build wants: a different CLI can produce a different AST, and therefore
            different generated code, from identical sources. Set it, and upgrading becomes a
            deliberate one-line change rather than whatever the machine happens to have.
        -->
        <HardenedSmithyCliVersion Condition="'$(HardenedSmithyCliVersion)' == ''">1.73.0</HardenedSmithyCliVersion>

        <!--
            Whether a mismatch fails the build, or only warns.

            Pinned where it matters and advisory where it does not. A developer pulls the repo and
            builds with the CLI they have; the build that publishes uses exactly the pinned one. The
            reproducibility argument is untouched - what ships is still produced by one version - and
            the cost it was imposing was that nobody could build at all without chasing a version
            first, which is not a trade worth making on a machine that publishes nothing.

            Defaults to $(ContinuousIntegrationBuild), which CI already sets and a local build does
            not. Set it explicitly to pin locally too.
        -->
        <HardenedSmithyPinCliVersion Condition="'$(HardenedSmithyPinCliVersion)' == ''">$(ContinuousIntegrationBuild)</HardenedSmithyPinCliVersion>
        <HardenedSmithyPinCliVersion Condition="'$(HardenedSmithyPinCliVersion)' == ''">false</HardenedSmithyPinCliVersion>
    </PropertyGroup>

    <!--
        Declared at evaluation, and as an ordinary @(HardenedSmithyAst) entry, so the model file and
        generated source paths below derive from it without knowing it did not exist yet. The IDE
        therefore sees the generated types before anything has run, which is the same reason every
        other output here is declared at the top level.
    -->
    <ItemGroup Condition="'@(HardenedSmithyModel)' != ''">
        <HardenedSmithyAst Include="$(IntermediateOutputPath)smithy/ast/$(HardenedSmithyModelName).json"/>
    </ItemGroup>

    <!--
        Declared at the top level and NOT inside the target that writes them, because an IDE builds
        its project model out of MSBuild evaluation rather than out of a build. A file that only
        becomes a @(Compile) item while a target is running is a file the editor never hears about,
        so every reference to a generated type reddens in a project that builds clean.

        The model files keep the .openapi-model.txt suffix on purpose. The file holds a
        ServiceSpecModel rather than any particular description, and Hardened.Idl.SourceGenerator
        matches that one suffix - so sharing it is what lets this front end reuse the whole generator
        half for no code. The name lies; changing it in three agreeing places to fix that costs more
        than it buys.
    -->
    <ItemGroup Condition="'@(HardenedSmithyAst)' != ''">
        <HardenedSmithyAst Update="@(HardenedSmithyAst)">
            <SliceSuffix Condition="'%(HardenedSmithyAst.Slice)' != ''">.%(HardenedSmithyAst.Slice)</SliceSuffix>
        </HardenedSmithyAst>

        <_HardenedSmithyModel Condition="'$(HardenedSmithyModelDir)' == ''"
                              Include="@(HardenedSmithyAst->'$(IntermediateOutputPath)smithy/%(Filename)%(SliceSuffix).openapi-model.txt')"/>
        <_HardenedSmithyModel Condition="'$(HardenedSmithyModelDir)' != ''"
                              Include="@(HardenedSmithyAst->'$(HardenedSmithyModelDir)%(Filename)%(SliceSuffix).openapi-model.txt')"/>

        <_HardenedSmithySource Condition="'$(HardenedSmithyGeneratedDir)' == '' And '$(HardenedSmithyModelDir)' == ''"
                               Include="@(HardenedSmithyAst->'$(IntermediateOutputPath)smithy/generated/%(Filename)%(SliceSuffix).g.cs')"/>
        <_HardenedSmithySource Condition="'$(HardenedSmithyGeneratedDir)' == '' And '$(HardenedSmithyModelDir)' != ''"
                               Include="@(HardenedSmithyAst->'$(HardenedSmithyModelDir)generated/%(Filename)%(SliceSuffix).g.cs')"/>
        <_HardenedSmithySource Condition="'$(HardenedSmithyGeneratedDir)' != ''"
                               Include="@(HardenedSmithyAst->'$(HardenedSmithyGeneratedDir)%(Filename)%(SliceSuffix).g.cs')"/>

        <AdditionalFiles Include="@(_HardenedSmithyModel)"/>
        <Compile Include="@(_HardenedSmithySource)" Visible="false"/>
    </ItemGroup>

    <!--
        Resolved inside a target because $(IntermediateOutputPath) is empty at the point a csproj
        body imports this file. Empty meant the models were written beside the project instead of
        into obj/, and because that directory survived every clean the Inputs/Outputs check reported
        the target up to date while the compiler saw no models at all.
    -->
    <Target Name="HardenedSmithyResolveModelDir">
        <PropertyGroup>
            <HardenedSmithyModelDir Condition="'$(HardenedSmithyModelDir)' == ''">$(IntermediateOutputPath)smithy/</HardenedSmithyModelDir>
            <HardenedSmithyGeneratedDir Condition="'$(HardenedSmithyGeneratedDir)' == ''">$(HardenedSmithyModelDir)generated/</HardenedSmithyGeneratedDir>
            <HardenedSmithyNamespace Condition="'$(HardenedSmithyNamespace)' == ''">$(RootNamespace)</HardenedSmithyNamespace>
            <HardenedSmithyNamespace Condition="'$(HardenedSmithyNamespace)' == ''">Generated</HardenedSmithyNamespace>
        </PropertyGroup>
    </Target>

    <!--
        The neutral property the shared generator reads. Set at evaluation rather than in the target
        above, because CompilerVisibleProperty is resolved for the compilation before any target
        runs - a value assigned inside a target arrives too late for the generator to see it.
    -->
    <PropertyGroup>
        <HardenedIdlNamespace Condition="'$(HardenedIdlNamespace)' == '' And '$(HardenedSmithyNamespace)' != ''">$(HardenedSmithyNamespace)</HardenedIdlNamespace>
    </PropertyGroup>

    <!--
        The filter is item metadata, so changing it does not touch the AST file and the up-to-date
        check below would skip the target and leave the previous slice's output in place. A stamp
        gives the check something whose timestamp moves when the filter changes, and only then.
    -->
    <!--
        Runs the CLI over @(HardenedSmithyModel) and writes the AST the extract task reads.
        =================================================================================

        Outputs a stamp rather than the AST itself, and that is deliberate. The task replaces the AST
        only when its content actually changed, so editing a comment in a .smithy file leaves the
        file - and therefore everything downstream of it - untouched. Were the AST this target's
        declared output, an edit that did not change it would leave Inputs newer than Outputs and the
        CLI would run again on every subsequent build, forever. The stamp moves every time; the AST
        moves only when it means something.
    -->
    <Target Name="HardenedSmithyGenerateAst"
            Condition="'@(HardenedSmithyModel)' != ''"
            DependsOnTargets="HardenedSmithyResolveModelDir"
            Inputs="@(HardenedSmithyModel)"
            Outputs="$(IntermediateOutputPath)smithy/ast/$(HardenedSmithyModelName).stamp">

        <GenerateSmithyAst Models="@(HardenedSmithyModel)"
                           OutputPath="$(IntermediateOutputPath)smithy/ast/$(HardenedSmithyModelName).json"
                           ToolPath="$(HardenedSmithyCliPath)"
                           ExpectedVersion="$(HardenedSmithyCliVersion)"
                           PinVersion="$(HardenedSmithyPinCliVersion)"/>

        <Touch Files="$(IntermediateOutputPath)smithy/ast/$(HardenedSmithyModelName).stamp"
               AlwaysCreate="true"/>
    </Target>

    <Target Name="HardenedSmithyFilterStamp" DependsOnTargets="HardenedSmithyResolveModelDir">
        <MakeDir Directories="$(HardenedSmithyModelDir)"/>

        <WriteLinesToFile
            File="$(HardenedSmithyModelDir)filters.stamp"
            Lines="@(HardenedSmithyAst->'%(Identity)|%(Slice)|%(IncludePaths)|%(ExcludePaths)|%(Tags)|%(PublishUrl)|%(UiUrl)|%(EmbedDocument)');$(HardenedSmithyServiceShapeId)"
            Overwrite="true"
            WriteOnlyWhenDifferent="true"/>
    </Target>

    <Target Name="HardenedSmithyExtractModels"
            DependsOnTargets="HardenedSmithyResolveModelDir;HardenedSmithyGenerateAst;HardenedSmithyFilterStamp"
            BeforeTargets="CoreCompile"
            Condition="'@(HardenedSmithyAst)' != ''"
            Inputs="@(HardenedSmithyAst);$(HardenedSmithyModelDir)filters.stamp"
            Outputs="@(_HardenedSmithyModel);@(_HardenedSmithySource)">

        <ExtractSmithySpec Specs="@(HardenedSmithyAst)"
                           OutputDirectory="$(HardenedSmithyModelDir)"
                           GeneratedSourceDirectory="$(HardenedSmithyGeneratedDir)"
                           Namespace="$(HardenedSmithyNamespace)"
                           ExcludeFromCoverage="$(ExcludeGeneratedCodeFromCoverage)"
                           EmbedDocument="$(HardenedSmithyEmbedDocument)"
                           EmitUnreferencedSchemas="$(HardenedSmithyEmitUnreferencedSchemas)"
                           ServiceShapeId="$(HardenedSmithyServiceShapeId)">
            <Output TaskParameter="ModelFiles" ItemName="_HardenedSmithyModelWritten"/>
            <Output TaskParameter="GeneratedSources" ItemName="_HardenedSmithySourceWritten"/>
        </ExtractSmithySpec>
    </Target>

    <!--
        Runs even when the target above is skipped as up to date, because that is the case worth
        catching: a model or generated source that is not on disk means the up-to-date check was
        made against files that are not there. Either way the compiler is about to open a file that
        does not exist, and silence would surface as a project full of missing types.
    -->
    <Target Name="HardenedSmithyVerifyModels"
            DependsOnTargets="HardenedSmithyExtractModels"
            BeforeTargets="CoreCompile"
            Condition="'@(HardenedSmithyAst)' != ''">

        <Error Condition="'@(_HardenedSmithySource)' == ''"
               Code="HSMT005"
               Text="Hardened.Smithy.SourceGenerator.targets was imported before these models were declared: @(HardenedSmithyAst). No generated source reached the compilation. Move the &lt;Import&gt; below the &lt;HardenedSmithyAst&gt; item group."/>

        <Error Condition="!Exists('%(_HardenedSmithyModel.FullPath)')"
               Code="HSMT004"
               Text="The Smithy model '%(_HardenedSmithyModel.Identity)' was not written. Delete $(HardenedSmithyModelDir) and rebuild."/>

        <Error Condition="!Exists('%(_HardenedSmithySource.FullPath)')"
               Code="HSMT004"
               Text="The generated Smithy source '%(_HardenedSmithySource.Identity)' was not written. Delete $(HardenedSmithyModelDir) and rebuild."/>
    </Target>

    <!--
        A .smithy file is not what this reads. Said out loud rather than left as an empty obj folder,
        because the mistake is an easy one and the symptom is silence.
    -->
    <Target Name="HardenedSmithyWarnOnIdlItems" BeforeTargets="HardenedSmithyExtractModels">
        <Error Condition="'@(HardenedSmithyAst)' != '' And '%(HardenedSmithyAst.Extension)' == '.smithy'"
               Code="HSMT003"
               Text="@(HardenedSmithyAst) is a Smithy IDL file, and that item takes a JSON AST. Declare it as &lt;HardenedSmithyModel Include=&quot;...&quot; /&gt; to have the build run the Smithy CLI for you, or convert it yourself and point HardenedSmithyAst at the .json."/>
    </Target>
</Project>
