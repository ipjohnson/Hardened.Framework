<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="SimpleFixture.NSubstitute"/>
        <PackageReference Include="SimpleFixture.xUnit"/>

        <!--
            Referenced directly rather than relied on transitively, which is the same thing every
            consuming application has to do. RazorBlade ships no buildTransitive/ folder, so the
            .props that globs **/*.cshtml into the RazorBlade item group does not flow through
            Hardened.Templates.RazorBlade - without this line the .cshtml files below compile to
            nothing and every test here fails on a missing type.
        -->
        <PackageReference Include="RazorBlade"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj" />
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj" />
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Testing\Hardened.Requests.Testing.csproj" />
        <ProjectReference Include="..\Hardened.Templates.RazorBlade\Hardened.Templates.RazorBlade.csproj" />
    </ItemGroup>

</Project>
