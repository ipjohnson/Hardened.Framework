<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NSubstitute"/>

        <!--
            Referenced directly rather than relied on transitively, which is the same thing every
            consuming application has to do. RazorBlade ships no buildTransitive/ folder, so the
            .props that globs **/*.cshtml into the RazorBlade item group does not flow through
            Hardened.Templates.RazorBlade - without this line the .cshtml files below compile to
            nothing and every test here fails on a missing type.
        -->
        <PackageReference Include="RazorBlade"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Testing\Hardened.Requests.Testing.csproj" />
        <ProjectReference Include="..\Hardened.Templates.RazorBlade\Hardened.Templates.RazorBlade.csproj" />
    </ItemGroup>

</Project>
