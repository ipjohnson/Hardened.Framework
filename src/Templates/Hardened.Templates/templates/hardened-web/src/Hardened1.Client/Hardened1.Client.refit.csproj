<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The generated client. There is no hand-written code in this project: Refitter writes a Refit
    interface and its models from src/Hardened1/openapi/Hardened1.json - the document the library's
    build wrote from what the server implements - into obj/, on every build that needs it, and this
    project compiles that output. Nothing generated is committed; the document is.

    What Refitter writes is set in .refitter beside this file: every operation returns an
    IApiResponse, the envelope that carries the status and the headers back beside the body, and
    the models go to Hardened1.Client.Models. Refit implements the interface with its own source
    generator, which runs in this project because the interface is declared here.

    Ten lines of MSBuild rather than a Hardened package around Refitter, so the generator is yours
    to swap: another one is a different package reference, a different tool pin and a different
    command in the target below. Scaffolding with the client option set to none leaves this project out.
  -->
  <PropertyGroup>
    <!--
      net8.0 whatever the rest of the solution targets. Nothing here references the library, so a
      union-model library on net11.0 needs no negotiation with this project, and the package this
      produces can be consumed by anything on the 8.0 line.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Hardened1.Client</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      Packable, so a service can hand other teams Hardened1.Client.nupkg: `dotnet pack
      src/Hardened1.Client -p:PackageVersion=1.2.0`. Its only dependency is Refit, which is what
      makes it worth shipping. Nothing here pushes it anywhere.
    -->
    <IsPackable>true</IsPackable>
    <PackageId>Hardened1.Client</PackageId>
    <Description>The Refit client for Hardened1, generated by Refitter from the document the service serves.</Description>

    <RefitterSettings>.refitter</RefitterSettings>
    <RefitterSpec>../Hardened1/openapi/Hardened1.json</RefitterSpec>

    <!--
      Under obj/, and spelled with BaseIntermediateOutputPath rather than IntermediateOutputPath:
      the latter is set by the SDK's targets, which are imported after this file, so it is still
      empty here and the client would land beside the csproj. Output in the project folder is
      also the wrong place for another reason - the SDK's **/*.cs glob is evaluated before any
      target runs, so files a target writes into the folder are missed on the first build and
      compiled twice on the second. IncludeClient below adds them inside a target instead.
    -->
    <RefitterOutput>$(BaseIntermediateOutputPath)refitter/</RefitterOutput>
  </PropertyGroup>

<!--#if (messagePack) -->
  <!--
    The Liquid templates are inputs to the generation below. Editing one changes what Refitter
    writes and touches neither the document nor the settings file, so without this the up-to-date
    check finds every input unmoved and leaves the previous output in place.

    @(RefitterTemplate) is named in that target's Inputs unconditionally. An item group that is not
    in the file expands to nothing, which is exactly what a project with no templates wants - and
    naming it once is worth more than a second copy of the attribute behind a condition.
  -->
  <ItemGroup>
    <RefitterTemplate Include="templates/*.liquid" />
  </ItemGroup>
<!--#endif -->

  <ItemGroup>

    <!-- Version from Directory.Packages.props, beside the tool's pin. -->
    <PackageReference Include="Refit" />
<!--#if (messagePack) -->

    <!--
      MessagePack, because the two Liquid templates in templates/ put [MessagePackObject] and
      [Key] on every generated contract. The package also carries the source generator that writes
      a formatter for each of them, which is what makes the client able to read a MessagePack
      response without a reflection fallback.
    -->
    <PackageReference Include="MessagePack" />
<!--#endif -->

    <!--
      Ordering only: the library writes the document this project reads, so it has to build first.
      ReferenceOutputAssembly="false" keeps the server, and the host with it, out of the client, and
      SkipGetTargetFrameworkProperties lets a library on another framework be built first without
      being negotiated with.
    -->
    <ProjectReference Include="../Hardened1/Hardened1.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!--
    The tool is restored inside the build, which is what lets a fresh clone build with no
    instruction beyond `dotnet build`. It is idempotent and fast once the package is cached; the
    first restore on a machine needs network, and .config/dotnet-tools.json holds the pin.
  -->
  <Target Name="RestoreRefitter" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet tool restore"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="low"
          ContinueOnError="true"
          EnvironmentVariables="DOTNET_NOLOGO=1">
      <Output TaskParameter="ExitCode" PropertyName="_RefitterRestoreExitCode" />
    </Exec>

    <Error Condition="'$(_RefitterRestoreExitCode)' != '0'"
           Code="HTPL004"
           Text="The Refitter tool could not be restored, so the client cannot be generated. The pin is refitter in .config/dotnet-tools.json; a fresh machine needs network for the first restore, and `dotnet tool restore` in the solution folder shows what NuGet said." />
  </Target>

  <!--
    The generated file is the up-to-date stamp: an unchanged document, settings file and pin skip
    this, and a change to any of them runs it. The output folder is emptied first because it is
    nobody's but Refitter's. The no-logging switch keeps Refitter from reporting telemetry, which
    it does by default; the settings file names the document, so the command names only where to
    write.
  -->
  <Target Name="GenerateClient"
          DependsOnTargets="RestoreRefitter"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(RefitterSpec);$(RefitterSettings);@(RefitterTemplate);$(MSBuildProjectDirectory)/../../.config/dotnet-tools.json"
          Outputs="$(RefitterOutput)TemplateModuleNameClient.cs">
    <RemoveDir Directories="$(RefitterOutput)" />
    <!-- The interface is named in the safe-identifier form the module class uses, through the
         settings file, so a dotted project name - Acme.Sample - gives IAcmeSampleClient rather
         than an identifier with a dot in it. -->
    <Exec Command="dotnet refitter --settings-file $(RefitterSettings) --output &quot;$(RefitterOutput)TemplateModuleNameClient.cs&quot; --no-banner --no-logging"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="DOTNET_NOLOGO=1" />
  </Target>

  <!--
    Inside a target, after the client is generated, and never as a static item. A static glob is
    evaluated before any target runs, so on a clean tree it matches nothing; evaluated here, the
    list is the client as it is now, the same way the Kiota project includes its output.
  -->
  <Target Name="IncludeClient" AfterTargets="GenerateClient" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(RefitterOutput)**/*.cs" />
    </ItemGroup>
  </Target>

  <Target Name="CleanClient" AfterTargets="CoreClean">
    <RemoveDir Directories="$(RefitterOutput)" />
  </Target>

</Project>
