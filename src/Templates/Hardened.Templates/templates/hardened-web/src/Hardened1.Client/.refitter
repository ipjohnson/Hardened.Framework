{
  "openApiPath": "../Hardened1/openapi/Hardened1.json",
  "namespace": "Hardened1.Client",
  "contractsNamespace": "Hardened1.Client.Models",
  "naming": {
    "useOpenApiTitle": false,
    "interfaceName": "TemplateModuleNameClient"
  },
  "returnIApiResponse": true,
  "useCancellationTokens": true,
  "generateXmlDocCodeComments": true,
  "generateStatusCodeComments": true,
  //#if (messagePack)
  // Two Liquid files in templates/, and nothing else about the generated contracts changes.
  // NJsonSchema looks for <name>.liquid in each directory of this list and falls back to its own
  // embedded template for every name it does not find, and the two it finds here - the class and
  // property annotation hooks - ship empty. So this adds attributes and overrides no generator.
  "customTemplateDirectory": "templates",
  // NJsonSchema gives every contract an AdditionalProperties catch-all for JSON extension data,
  // and renders it outside the loop the property template hooks into - so it is a member of a
  // [MessagePackObject] type that no template can key, which is MsgPack004 at build. A
  // MessagePack payload has no extension-data concept for it to carry anyway.
  "generateDefaultAdditionalProperties": false,
  //#endif
  "addAutoGeneratedHeader": true
}
