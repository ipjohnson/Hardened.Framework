<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- One place to bump. The generated code and the runtime it targets ship together,
         so every Hardened package moves as a set. -->
    <HardenedVersion>0.0.0-HARDENED-VERSION</HardenedVersion>
    <!-- The DependencyModules line the testing packages are on, stamped at pack the way
         HardenedVersion is. Hardened.Shared.Testing depends on DependencyModules.Testing at this
         version, and the mock package below has to be the same line. -->
    <DependencyModulesVersion>0.0.0-DEPENDENCYMODULES-VERSION</DependencyModulesVersion>
<!--#if (kiotaClient) -->
    <!--
      The Kiota runtime the generated client compiles against. Pinned beside the tool that
      generates it - microsoft.openapi.kiota in .config/dotnet-tools.json - and the two move
      together: the generated code and the runtime come from matching Kiota releases, and the
      client project fails with HTPL003 naming both when they disagree. They follow Kiota's
      release line rather than Hardened's, which is why neither is $(HardenedVersion).
    -->
    <KiotaBundleVersion>2.0.0</KiotaBundleVersion>
<!--#endif -->
  </PropertyGroup>

  <ItemGroup Label="Hardened">
    <PackageVersion Include="Hardened.Shared.Runtime" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Web.Runtime" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Web.Kestrel.Runtime" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Web.AspNetCore.Runtime" Version="$(HardenedVersion)" />
    <!-- The store [CacheResponse] needs. Listed rather than referenced, so adding the reference is
         one line in a csproj and not two files. -->
    <PackageVersion Include="Hardened.Requests.Caching.Memory" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Shared.Testing" Version="$(HardenedVersion)" />
<!--#if (xunit) -->
    <PackageVersion Include="Hardened.Shared.Testing.xUnit" Version="$(HardenedVersion)" />
<!--#endif -->
<!--#if (nunit) -->
    <PackageVersion Include="Hardened.Shared.Testing.NUnit" Version="$(HardenedVersion)" />
<!--#endif -->
<!--#if (unionMode) -->
    <!--
      Named directly because on net11.0 nothing else resolves it consistently. Hardened.Shared.Testing
      floors Microsoft.Extensions.DependencyInjection at 8.0.1 and the runner integration the runner
      package brings - DependencyModules.xUnit or DependencyModules.NUnit - floors it at 10.0.0; on
      net8.0 the graph settles on 8.0.1 and the two never meet, and on net11.0 NuGet
      sees a downgrade and fails restore with NU1605. Selecting the higher version here is the
      resolution NU1605 itself names, and it is scoped to the framework that needs it.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
<!--#endif -->
    <PackageVersion Include="Hardened.Web.Testing" Version="$(HardenedVersion)" />
<!--#if (kestrel || cloudRun) -->
    <PackageVersion Include="Hardened.Web.Kestrel.Testing" Version="$(HardenedVersion)" />
<!--#endif -->
<!--#if (aspnet) -->
    <PackageVersion Include="Hardened.Web.AspNetCore.Testing" Version="$(HardenedVersion)" />
<!--#endif -->
  </ItemGroup>
<!--#if (kiotaClient) -->

  <ItemGroup Label="Client">
    <PackageVersion Include="Microsoft.Kiota.Bundle" Version="$(KiotaBundleVersion)" />
    <!-- The test side of the client: builds it over the pipeline and asserts through it. A
         Hardened package, so it moves with the framework rather than with Kiota. -->
    <PackageVersion Include="Hardened.Kiota.Testing" Version="$(HardenedVersion)" />
  </ItemGroup>
<!--#endif -->
<!--#if (refitClient) -->

  <ItemGroup Label="Client">
    <!--
      The Refit runtime the generated interface compiles against. Refitter - the tool pinned in
      .config/dotnet-tools.json that writes the interface - targets Refit's current major, and the
      two are bumped together by hand: unlike Kiota, Refitter does not report the version it
      writes for, so nothing checks this pair at build. They follow Refit's release line rather
      than Hardened's.
    -->
    <PackageVersion Include="Refit" Version="8.0.0" />
    <!-- The test side of the client: builds it over the pipeline and asserts through it. A
         Hardened package, so it moves with the framework rather than with Refit. -->
    <PackageVersion Include="Hardened.Refit.Testing" Version="$(HardenedVersion)" />
  </ItemGroup>
<!--#endif -->

  <ItemGroup Label="AWS Lambda">
    <!--
      On $(HardenedVersion) with everything else. The AWS line is part of the framework repository
      now, so it moves with it rather than being pinned to a release of its own - which is what the
      old Hardened.Amz pin was, and what let this template combine a framework from one release
      with a generator from another.
    -->
    <PackageVersion Include="Hardened.Aws.Lambda.Runtime" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Aws.Lambda.ApiGateway" Version="$(HardenedVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <!--
      The logging provider the Lambda entry point installs instead, on AWS's own line rather than
      Hardened's. Program.cs says why a function logs through this and not through the console.
    -->
    <PackageVersion Include="Amazon.Lambda.Logging.AspNetCore" Version="5.0.1" />
  </ItemGroup>

  <ItemGroup Label="Google Cloud Run">
    <!-- The Cloud Run host composes the Kestrel one: Kestrel on PORT, a SIGTERM drain, and the
         front door that serves triggers beside the routes. -->
    <PackageVersion Include="Hardened.Gcp.CloudRun.Runtime" Version="$(HardenedVersion)" />
  </ItemGroup>

  <ItemGroup Label="Azure Functions">
    <!--
      The Worker SDK is the host project's reference rather than the runtime package's: it is
      what marks the project as a function app, scans the function the generator wrote into
      functions.metadata, builds the host's extensions and writes worker.config.json. It follows
      the worker's release line rather than Hardened's, which is why it is not $(HardenedVersion).
    -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageVersion Include="Hardened.Azure.Functions.Runtime" Version="$(HardenedVersion)" />
    <!-- The one adapter web routes need: one anonymous HTTP trigger catching every method under
         every path, with Hardened's routing table doing the routing. -->
    <PackageVersion Include="Hardened.Azure.Functions.Http" Version="$(HardenedVersion)" />
    <!-- The generator that writes that trigger: the function, the metadata the host indexes and
         the executor it invokes through. -->
    <PackageVersion Include="Hardened.Azure.Functions.SourceGenerator" Version="$(HardenedVersion)" />
    <!-- [AzureFunctionsWebTesting], the host that sends a test's request through the worker's
         own request and response types. -->
    <PackageVersion Include="Hardened.Azure.Functions.Testing" Version="$(HardenedVersion)" />
  </ItemGroup>

  <ItemGroup Label="Hardened source generators">
    <!-- Not optional. The runtime packages carry no analyzers, so without these the module's
         generated half never exists and PopulateServiceCollection does not compile. -->
    <PackageVersion Include="Hardened.Library.SourceGenerator" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Web.SourceGenerator" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.OpenApi.SourceGenerator" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Smithy.SourceGenerator" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Idl.SourceGenerator" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Validation.SourceGenerator" Version="$(HardenedVersion)" />
  </ItemGroup>

  <ItemGroup Label="Testing">
<!--#if (xunit) -->
    <!-- xUnit v3. Hardened.Shared.Testing.xUnit builds on xunit.v3.extensibility.core, so a test
         project on xunit 2.x fails with CS0433 on Assert. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
<!--#endif -->
<!--#if (nunit) -->
    <!-- NUnit 4. Hardened.Shared.Testing.NUnit takes NUnit as [4.2.2, 5.0.0): the runner reads
         TestContext and TestExecutionContext from the framework package itself, and a major version
         is where those are free to change shape. -->
    <PackageVersion Include="NUnit" Version="4.2.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
<!--#endif -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- The mock library behind [Mock]. The attribute is DependencyModules.Testing's and builds
         nothing itself: this package carries the support attribute Bootstrap.cs declares, and
         brings the library with it. -->
<!--#if (nsubstitute) -->
    <PackageVersion Include="DependencyModules.NSubstitute" Version="$(DependencyModulesVersion)" />
<!--#endif -->
<!--#if (moq) -->
    <PackageVersion Include="DependencyModules.Moq" Version="$(DependencyModulesVersion)" />
<!--#endif -->
<!--#if (fakeiteasy) -->
    <PackageVersion Include="DependencyModules.FakeItEasy" Version="$(DependencyModulesVersion)" />
<!--#endif -->
  </ItemGroup>
</Project>
