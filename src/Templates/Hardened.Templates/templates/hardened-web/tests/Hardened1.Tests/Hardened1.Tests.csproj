<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
<!--#if (xunit) -->
    <!-- xUnit v3 test projects are self-executing. -->
    <OutputType>Exe</OutputType>
<!--#endif -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardened.Shared.Testing" />
<!--#if (xunit) -->
    <!-- The runner: [HardenedTest] for xUnit. Hardened.Shared.Testing.NUnit is the other one. -->
    <PackageReference Include="Hardened.Shared.Testing.xUnit" />
<!--#endif -->
<!--#if (nunit) -->
    <!-- The runner: [HardenedTest] for NUnit. Hardened.Shared.Testing.xUnit is the other one. -->
    <PackageReference Include="Hardened.Shared.Testing.NUnit" />
<!--#endif -->
    <!-- The mock library behind [Mock]: the support attribute Bootstrap.cs declares, and the
         library itself. -->
<!--#if (nsubstitute) -->
    <PackageReference Include="DependencyModules.NSubstitute" />
<!--#endif -->
<!--#if (moq) -->
    <PackageReference Include="DependencyModules.Moq" />
<!--#endif -->
<!--#if (fakeiteasy) -->
    <PackageReference Include="DependencyModules.FakeItEasy" />
<!--#endif -->
<!--#if (unionMode) -->
    <!-- See Directory.Packages.props: the two testing packages floor this differently, and only on
         net11.0 does the difference become a downgrade rather than a resolution. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
<!--#endif -->
    <PackageReference Include="Hardened.Web.Testing" />
<!--#if (kestrel) -->
    <!-- The host Hardened1SocketTests runs the application on: a package, not the host project. -->
    <PackageReference Include="Hardened.Web.Kestrel.Testing" />
<!--#endif -->
<!--#if (aspnet) -->
    <!-- The host Hardened1SocketTests runs the application on: a package, not the host project. -->
    <PackageReference Include="Hardened.Web.AspNetCore.Testing" />
<!--#endif -->
<!--#if (kiotaClient) -->
    <!-- Builds the generated client for a test parameter; see Bootstrap.cs and TodoTests.cs. -->
    <PackageReference Include="Hardened.Kiota.Testing" />
<!--#endif -->
<!--#if (refitClient) -->
    <!-- Builds the generated client for a test parameter; see Bootstrap.cs and TodoTests.cs. -->
    <PackageReference Include="Hardened.Refit.Testing" />
<!--#endif -->
<!--#if (xunit) -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
<!--#endif -->
<!--#if (nunit) -->
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
<!--#endif -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library, not the host. ITestWebApp drives the real pipeline without one, so a test
         suite that named the host would be coupled to a deployment target for no reason. -->
    <ProjectReference Include="..\..\src\Hardened1\Hardened1.csproj" />
<!--#if (hasClient) -->
    <!-- The generated client, which TodoTests drives through the pipeline. -->
    <ProjectReference Include="..\..\src\Hardened1.Client\Hardened1.Client.csproj" />
<!--#endif -->
  </ItemGroup>

</Project>
