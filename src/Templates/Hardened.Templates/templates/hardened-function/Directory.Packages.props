<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- One place to bump. The generated code and the runtime it targets ship together,
         so every Hardened package moves as a set. -->
    <HardenedVersion>0.0.0-HARDENED-VERSION</HardenedVersion>
    <!-- The DependencyModules line the testing packages are on, stamped at pack the way
         HardenedVersion is. Hardened.Shared.Testing depends on DependencyModules.Testing at this
         version, and the mock package below has to be the same line. -->
    <DependencyModulesVersion>0.0.0-DEPENDENCYMODULES-VERSION</DependencyModulesVersion>
  </PropertyGroup>

  <ItemGroup Label="Hardened">
    <PackageVersion Include="Hardened.Shared.Runtime" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Requests.Runtime" Version="$(HardenedVersion)" />
    <!-- The store [CacheResponse] needs. ByPayload is the strategy for a function handler, which
         is the one place a URL key cannot be the whole input. -->
    <PackageVersion Include="Hardened.Requests.Caching.Memory" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Functions.Runtime" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Functions.Testing" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Shared.Testing" Version="$(HardenedVersion)" />
<!--#if (xunit) -->
    <PackageVersion Include="Hardened.Shared.Testing.xUnit" Version="$(HardenedVersion)" />
<!--#endif -->
<!--#if (nunit) -->
    <PackageVersion Include="Hardened.Shared.Testing.NUnit" Version="$(HardenedVersion)" />
<!--#endif -->
  </ItemGroup>

  <!--
    The host, on $(HardenedVersion) with everything else. The AWS line is part of this repository
    now, so it moves with the framework rather than being pinned to a release of its own - which is
    what the old Hardened.Amz pin was, and what made a template combining the two able to name a
    generator that no longer matched the interface it emitted against.
  -->
  <ItemGroup Label="Logging">
    <!-- The console logger the entry point installs. A deployed function writes to CloudWatch
         through stdout, so this is what makes a log line reach it. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Label="AWS Lambda">
    <PackageVersion Include="Hardened.Aws.Lambda.Runtime" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Aws.Lambda.Invoke" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Aws.Lambda.Sqs" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Aws.Lambda.Sns" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Aws.Lambda.EventBridge" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Aws.Lambda.DynamoDb" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Aws.Lambda.Kinesis" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Aws.Lambda.S3" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Aws.Lambda.Testing" Version="$(HardenedVersion)" />
  </ItemGroup>

  <ItemGroup Label="Hardened source generators">
    <!-- Not optional. The runtime packages carry no analyzers, so without these the module's
         generated half never exists and PopulateServiceCollection does not compile. -->
    <PackageVersion Include="Hardened.Library.SourceGenerator" Version="$(HardenedVersion)" />
    <PackageVersion Include="Hardened.Function.SourceGenerator" Version="$(HardenedVersion)" />
  </ItemGroup>

  <ItemGroup Label="Testing">
<!--#if (xunit) -->
    <!-- xUnit v3. Hardened.Shared.Testing.xUnit builds on xunit.v3.extensibility.core, so a test
         project on xunit 2.x fails with CS0433 on Assert. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
<!--#endif -->
<!--#if (nunit) -->
    <!-- NUnit 4. Hardened.Shared.Testing.NUnit takes NUnit as [4.2.2, 5.0.0): the runner reads
         TestContext and TestExecutionContext from the framework package itself, and a major version
         is where those are free to change shape. -->
    <PackageVersion Include="NUnit" Version="4.2.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
<!--#endif -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- The mock library behind [Mock]. The attribute is DependencyModules.Testing's and builds
         nothing itself: this package carries the support attribute Bootstrap.cs declares, and
         brings the library with it. -->
<!--#if (nsubstitute) -->
    <PackageVersion Include="DependencyModules.NSubstitute" Version="$(DependencyModulesVersion)" />
<!--#endif -->
<!--#if (moq) -->
    <PackageVersion Include="DependencyModules.Moq" Version="$(DependencyModulesVersion)" />
<!--#endif -->
<!--#if (fakeiteasy) -->
    <PackageVersion Include="DependencyModules.FakeItEasy" Version="$(DependencyModulesVersion)" />
<!--#endif -->
  </ItemGroup>
</Project>
