<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The function. There is no separate host project: on Lambda the deployed artifact is this
    assembly, and the generator writes the entry point the runtime calls. An executable, because
    the handler Hardened.Amz.Cdk deploys is the assembly name alone and the managed runtime starts
    that only when the assembly has an entry point.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardened.Shared.Runtime" />
    <PackageReference Include="Hardened.Requests.Runtime" />
    <PackageReference Include="Hardened.Amz.Shared.Lambda.Runtime" />
    <PackageReference Include="Hardened.Amz.Function.Lambda.Runtime" />
<!--#if (sqs) -->
    <PackageReference Include="Hardened.Amz.Function.Sqs.Runtime" />
<!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardened.Library.SourceGenerator" />
    <!--
      PrivateAssets="all" on the generators so they stop at this project's boundary. They are
      build-time only, and nothing that references this assembly should inherit them.
    -->
    <PackageReference Include="Hardened.Function.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Hardened.Amz.Function.Lambda.SourceGenerator" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Running this project locally starts the AWS Lambda Test Tool, the dotnet tool pinned in
    .config/dotnet-tools.json. It is restored inside the build, so F5 on a fresh clone needs no instruction
    beyond `dotnet build`; the first restore on a machine needs network. A failed restore is a
    warning here and a message at run time naming the manifest, not a broken build: the deployed
    artifact does not need the tool.
  -->
  <Target Name="RestoreLambdaTestTool" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet tool restore"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="low"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_LambdaTestToolRestoreExitCode" />
    </Exec>
    <Warning Condition="'$(_LambdaTestToolRestoreExitCode)' != '0'"
             Text="The AWS Lambda Test Tool could not be restored, so running this project locally will not start it. The pin is amazon.lambda.testtool in .config/dotnet-tools.json; `dotnet tool restore` there shows what NuGet said." />
  </Target>

</Project>
