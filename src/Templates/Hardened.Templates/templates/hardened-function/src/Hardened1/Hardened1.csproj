<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The function. There is no separate host project: the deployed artifact is this assembly, and
    Program.cs is the entry point the runtime starts. An executable, because a deployed handler is
    the assembly name alone and the runtime starts that only when the assembly has one.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardened.Shared.Runtime" />
    <PackageReference Include="Hardened.Requests.Runtime" />
    <PackageReference Include="Hardened.Functions.Runtime" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
<!--#if (aws) -->
    <!--
      The host, and one adapter for the trigger the handler declares. The adapter is a package
      rather than a flag so a function carries only the event models it can reach: a queue function
      never has the API Gateway or stream models in its deployment bundle.
    -->
    <PackageReference Include="Hardened.Aws.Lambda.Runtime" />
<!--#if (invoke) -->
    <PackageReference Include="Hardened.Aws.Lambda.Invoke" />
<!--#endif -->
<!--#if (queue) -->
    <PackageReference Include="Hardened.Aws.Lambda.Sqs" />
<!--#endif -->
<!--#if (topic) -->
    <PackageReference Include="Hardened.Aws.Lambda.Sns" />
<!--#endif -->
<!--#if (timer) -->
    <PackageReference Include="Hardened.Aws.Lambda.EventBridge" />
<!--#endif -->
<!--#if (change) -->
    <PackageReference Include="Hardened.Aws.Lambda.DynamoDb" />
<!--#endif -->
<!--#if (stream) -->
    <PackageReference Include="Hardened.Aws.Lambda.Kinesis" />
<!--#endif -->
<!--#if (blob) -->
    <PackageReference Include="Hardened.Aws.Lambda.S3" />
<!--#endif -->
<!--#endif -->
<!--#if (gcp) -->
    <!--
      The host, and one adapter for the trigger the handler declares. On Cloud Run every source
      arrives as an HTTP request, so the host is Kestrel on PORT with a front door ahead of
      routing, and an adapter is what teaches the front door one envelope: a queue service never
      carries the Scheduler or Firestore code.
    -->
    <PackageReference Include="Hardened.Gcp.CloudRun.Runtime" />
<!--#if (invoke) -->
    <PackageReference Include="Hardened.Gcp.CloudRun.Invoke" />
<!--#endif -->
<!--#if (queue || topic) -->
    <PackageReference Include="Hardened.Gcp.CloudRun.PubSub" />
<!--#endif -->
<!--#if (timer) -->
    <PackageReference Include="Hardened.Gcp.CloudRun.Scheduler" />
<!--#endif -->
<!--#if (change) -->
    <PackageReference Include="Hardened.Gcp.CloudRun.Firestore" />
<!--#endif -->
<!--#if (blob) -->
    <PackageReference Include="Hardened.Gcp.CloudRun.Storage" />
<!--#endif -->
<!--#endif -->
<!--#if (azure) -->
    <!--
      The Worker SDK, the runtime, and one adapter for the trigger the handler declares. The SDK
      is what makes this project a function app: it scans the function the generator wrote into
      functions.metadata, builds the host's extensions and writes worker.config.json. The adapter
      is a package rather than a flag so a function app carries only the extension it can reach:
      a queue app never has the Event Hubs or Cosmos DB extension in its deployment.
    -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
    <PackageReference Include="Hardened.Azure.Functions.Runtime" />
<!--#if (queue || topic) -->
    <PackageReference Include="Hardened.Azure.Functions.ServiceBus" />
<!--#endif -->
<!--#if (timer) -->
    <PackageReference Include="Hardened.Azure.Functions.Timer" />
<!--#endif -->
<!--#if (change) -->
    <PackageReference Include="Hardened.Azure.Functions.CosmosDb" />
<!--#endif -->
<!--#if (stream) -->
    <PackageReference Include="Hardened.Azure.Functions.EventHubs" />
<!--#endif -->
<!--#if (blob) -->
    <PackageReference Include="Hardened.Azure.Functions.Blobs" />
<!--#endif -->
<!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardened.Library.SourceGenerator" />
    <!--
      PrivateAssets="all" on the generators so they stop at this project's boundary. They are
      build-time only, and nothing that references this assembly should inherit them.
    -->
    <PackageReference Include="Hardened.Function.SourceGenerator" PrivateAssets="all" />
<!--#if (azure) -->
    <!--
      The host's view of the handlers: one function per source, with the binding attribute the
      Worker SDK scans, the metadata provider the host indexes from and the executor it invokes
      through. Read it in obj/ beside the other generated files.
    -->
    <PackageReference Include="Hardened.Azure.Functions.SourceGenerator" PrivateAssets="all" />
<!--#endif -->
  </ItemGroup>
<!--#if (azure) -->

  <!--
    The host's configuration beside the worker, and the settings `func start` reads. The local
    settings never reach a deployment: a deployed function app reads its settings from the
    environment the portal or `az functionapp config appsettings set` wrote.
  -->
  <ItemGroup>
    <None Update="host.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="local.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
<!--#endif -->

<!--#if (aws) -->
  <!--
    Running this project locally starts the AWS Lambda Test Tool, the dotnet tool pinned in
    .config/dotnet-tools.json. It is restored inside the build, so F5 on a fresh clone needs no instruction
    beyond `dotnet build`; the first restore on a machine needs network. A failed restore is a
    warning here and a message at run time naming the manifest, not a broken build: the deployed
    artifact does not need the tool.
  -->
  <Target Name="RestoreLambdaTestTool" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet tool restore"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="low"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_LambdaTestToolRestoreExitCode" />
    </Exec>
    <Warning Condition="'$(_LambdaTestToolRestoreExitCode)' != '0'"
             Text="The AWS Lambda Test Tool could not be restored, so running this project locally will not start it. The pin is amazon.lambda.testtool in .config/dotnet-tools.json; `dotnet tool restore` there shows what NuGet said." />
  </Target>
<!--#endif -->

</Project>
