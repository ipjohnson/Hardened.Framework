                          Condition="Exists('..\..\..\..\DependencyModules\src\DependencyModules.NSubstitute\DependencyModules.NSubstitute.csproj')"/>
        <PackageReference Include="DependencyModules.NSubstitute"
                          Condition="!Exists('..\..\..\..\DependencyModules\src\DependencyModules.NSubstitute\DependencyModules.NSubstitute.csproj')"/>
    </ItemGroup>

</Project>
