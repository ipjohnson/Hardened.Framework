<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.Shared.Testing\Hardened.Shared.Testing.csproj"/>
          <!-- [ModuleTest] and the running-test seam, for xunit.v3 4.x. -->
      <ProjectReference Include="$(DependencyModulesRoot)\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj"
                        Condition="'$(UseLocalDependencyModules)' == 'true'"/>
      <PackageReference Include="DependencyModules.xUnit4"
                        Condition="'$(UseLocalDependencyModules)' != 'true'"/>
        <!-- The mock library behind [Mock]: [NSubstituteSupport] in Bootstrap.cs, and NSubstitute with it. -->
        <ProjectReference Include="$(DependencyModulesRoot)\src\DependencyModules.NSubstitute\DependencyModules.NSubstitute.csproj"
                          Condition="'$(UseLocalDependencyModules)' == 'true'"/>
        <PackageReference Include="DependencyModules.NSubstitute"
                          Condition="'$(UseLocalDependencyModules)' != 'true'"/>
    </ItemGroup>

</Project>
