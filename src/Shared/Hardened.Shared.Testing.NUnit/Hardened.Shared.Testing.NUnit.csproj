<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Description>The NUnit runner for Hardened tests: [HardenedTest], the logger that writes to a test's output, and the running-test seam Hardened.Shared.Testing reads. A test project references this beside Hardened.Shared.Testing, or Hardened.Shared.Testing.xUnit instead of it.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.Shared.Testing.NUnit</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
        <!--
             The same bound DependencyModules.NUnit carries: NUnit ships no extensibility package,
             so the types used here - TestContext, TestExecutionContext - come from the framework
             package itself, and a major version is where they are free to change shape.
        -->
        <PackageReference Include="NUnit" Version="[4.2.2,5.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.Shared.Testing\Hardened.Shared.Testing.csproj"/>
        <ProjectReference Include="..\..\..\..\DependencyModules\src\DependencyModules.NUnit\DependencyModules.NUnit.csproj"
                          Condition="Exists('..\..\..\..\DependencyModules\src\DependencyModules.NUnit\DependencyModules.NUnit.csproj')"/>
        <PackageReference Include="DependencyModules.NUnit" Version="$(DependencyModulesVersion)"
                          Condition="!Exists('..\..\..\..\DependencyModules\src\DependencyModules.NUnit\DependencyModules.NUnit.csproj')"/>
    </ItemGroup>

</Project>
