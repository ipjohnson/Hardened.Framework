<Project>
    <!--
        A test project that references this package and no DependencyModules test package.

        [ModuleTest] is not here. This package holds the entry point attribute and ITestContext;
        the attribute a test framework discovers ships in DependencyModules.xUnit (xunit.v3 3.x),
        DependencyModules.xUnit4 (xunit.v3 4.x) or DependencyModules.NUnit, and a project without
        one gets one CS0246 per test method, none of them saying which package to add.

        A warning rather than an error, because referencing this package without writing a
        [ModuleTest] is legitimate: a project may want ITestContext or the entry point attribute and
        drive its tests some other way. NoWarn silences it for those.

        Read off @(PackageReference) rather than the resolved graph, because the test package is
        the test project's own choice and is always a direct reference - the framework's testing
        packages deliberately depend on none of them, so that one on xUnit does not pull in NUnit.
    -->
    <Target Name="HardenedTestingRunnerReference"
            BeforeTargets="CoreCompile"
            Condition="'$(IsTestProject)' == 'true'">
        <ItemGroup>
            <_HardenedTestRunner Include="@(PackageReference)"
                                 Condition="'%(Identity)' == 'DependencyModules.xUnit' Or
                                            '%(Identity)' == 'DependencyModules.xUnit4' Or
                                            '%(Identity)' == 'DependencyModules.NUnit'" />
        </ItemGroup>

        <Warning Condition="'@(_HardenedTestRunner)' == ''"
                 Code="HRDT001"
                 Text="$(MSBuildProjectName) references Hardened.Shared.Testing and no DependencyModules test package, so [ModuleTest] is not defined and every test method carrying it is CS0246. Add a PackageReference to DependencyModules.xUnit for xunit.v3 3.x, DependencyModules.xUnit4 for xunit.v3 4.x, or DependencyModules.NUnit." />
    </Target>
</Project>
