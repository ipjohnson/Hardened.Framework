<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <!--
          Deliberately not IsAotCompatible, and the same goes for every other Hardened.*.Testing
          package.

          Every shipped runtime package carries the flag and passes the analyzers clean. These
          cannot, and the reason is what they are for: a harness takes an object a test wrote and
          serializes it, which is JsonSerializer.Serialize<TValue> over a type nobody knew at
          compile time; a client builder closes a generic over a Type it was handed. Source
          generation cannot answer either, because the input is not known until the test runs.

          Nor would passing be worth much. IsAotCompatible turns on analyzers over an assembly's own
          code so that a consumer publishing native gets a truthful signal, and a testing package is
          never in that graph. Marking these would trade a true statement for 156 suppressions.
        -->
        <Description>Test support for Hardened applications: the entry point attribute that builds a test's container from the real module graph, ITestContext, and the running-test seam a runner package fills. Reference Hardened.Shared.Testing.xUnit or Hardened.Shared.Testing.NUnit beside it for [HardenedTest], and DependencyModules.NSubstitute, DependencyModules.Moq or DependencyModules.FakeItEasy for [Mock].</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.Shared.Testing</PackageId>
    </PropertyGroup>

    <!--
      Raises HRDT001 on a test project that takes this package and neither runner package. The
      attribute a runner discovers lives in those, and its absence used to arrive as one CS0246 per
      test method. buildTransitive/ and Package\, for the reason Hardened.Requests.Abstract gives.
    -->
    <ItemGroup>
        <Content Include="Package\Hardened.Shared.Testing.targets">
            <Pack>true</Pack>
            <PackagePath>buildTransitive/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
        <PackageReference Include="Microsoft.Extensions.Primitives"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.Shared.Runtime\Hardened.Shared.Runtime.csproj"/>
        <!--
             No runner here. The attributes talk to DependencyModules.Testing's interfaces, which
             both of its runner integrations call the same way; the runner arrives with
             Hardened.Shared.Testing.xUnit or Hardened.Shared.Testing.NUnit, which is what carries
             [HardenedTest].

             No mock library either. [Mock] is DependencyModules.Testing's, and it asks the
             IMockSupportAttribute in scope for the double - [NSubstituteSupport], [MoqSupport] or
             [FakeItEasySupport], from the DependencyModules package of the same name. The test
             project chooses that package, so this one does not pull NSubstitute into a Moq project.
        -->
        <ProjectReference Include="..\..\..\..\DependencyModules\src\DependencyModules.Testing\DependencyModules.Testing.csproj"
                          Condition="Exists('..\..\..\..\DependencyModules\src\DependencyModules.Testing\DependencyModules.Testing.csproj')"/>
        <PackageReference Include="DependencyModules.Testing"
                          Condition="!Exists('..\..\..\..\DependencyModules\src\DependencyModules.Testing\DependencyModules.Testing.csproj')"/>
    </ItemGroup>

</Project>
