<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <HardenedTestRunner>NUnit</HardenedTestRunner>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <!--
        An NUnit test project: what Hardened.Shared.Testing promises is that a [ModuleTest] from
        DependencyModules.NUnit reads the same as one from DependencyModules.xUnit4, and only NUnit
        can hold it to that. xUnit's analyzers are not here because xUnit is not.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="NUnit"/>
        <PackageReference Include="NUnit3TestAdapter"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.Shared.Runtime\Hardened.Shared.Runtime.csproj"/>
        <ProjectReference Include="..\Hardened.Shared.Testing\Hardened.Shared.Testing.csproj"/>
        <ProjectReference Include="..\..\..\..\DependencyModules\src\DependencyModules.NUnit\DependencyModules.NUnit.csproj"
                          Condition="Exists('..\..\..\..\DependencyModules\src\DependencyModules.NUnit\DependencyModules.NUnit.csproj')"/>
        <PackageReference Include="DependencyModules.NUnit"
                          Condition="!Exists('..\..\..\..\DependencyModules\src\DependencyModules.NUnit\DependencyModules.NUnit.csproj')"/>
        <!-- The mock library behind [Mock]: [NSubstituteSupport] in Bootstrap.cs, and NSubstitute with it. -->
        <ProjectReference Include="..\..\..\..\DependencyModules\src\DependencyModules.NSubstitute\DependencyModules.NSubstitute.csproj"
                          Condition="Exists('..\..\..\..\DependencyModules\src\DependencyModules.NSubstitute\DependencyModules.NSubstitute.csproj')"/>
        <PackageReference Include="DependencyModules.NSubstitute"
                          Condition="!Exists('..\..\..\..\DependencyModules\src\DependencyModules.NSubstitute\DependencyModules.NSubstitute.csproj')"/>
    </ItemGroup>

</Project>
