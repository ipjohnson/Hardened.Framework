<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Description>Test-time access to the triggers a Hardened function declares: send to a queue, publish to a topic or fire a timer by name, with the payload type the handler binds.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>Hardened.Functions.Testing</PackageId>
        <PackageTags>Hardened;Hardened.Framework;serverless;functions;testing</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!--
      Names no cloud, for the same reason the trigger attributes do not - and unlike the runtime,
      it does not need to. Delivering a test message means building a request and running the
      pipeline, and both are the framework's, so there is one implementation rather than one per
      provider and an application's tests do not change when its host does.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj"/>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj"/>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Testing\Hardened.Requests.Testing.csproj"/>
    </ItemGroup>

</Project>
