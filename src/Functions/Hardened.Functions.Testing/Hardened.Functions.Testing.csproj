<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <!--
          Deliberately not IsAotCompatible. A test harness serializes whatever type a test hands it
          and builds clients over types it learns at run time, so the reflection is the feature
          rather than an oversight - and a testing package is referenced by test projects, which are
          never published ahead of time. Marking it would make the flag a claim about code no
          consumer will ever trim. See Hardened.Shared.Testing.csproj for the whole of it.
        -->
        <Description>Test-time access to the triggers a Hardened function declares: send to a queue, publish to a topic or fire a timer by name, with the payload type the handler binds.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>Hardened.Functions.Testing</PackageId>
        <PackageTags>Hardened;Hardened.Framework;serverless;functions;testing</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!--
      Names no cloud, for the same reason the trigger attributes do not - and unlike the runtime,
      it does not need to. Delivering a test message means building a request and running the
      pipeline, and both are the framework's, so there is one implementation rather than one per
      provider and an application's tests do not change when its host does.
    -->
    <!--
      The same conditional pair Hardened.Shared.Testing uses: the source tree beside this one when
      it is checked out, the package otherwise. No runner here - the attribute talks to
      DependencyModules.Testing's interfaces and the test project supplies the rest.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\DependencyModules\src\DependencyModules.Testing\DependencyModules.Testing.csproj"
                          Condition="Exists('..\..\..\..\DependencyModules\src\DependencyModules.Testing\DependencyModules.Testing.csproj')"/>
        <PackageReference Include="DependencyModules.Testing"
                          Condition="!Exists('..\..\..\..\DependencyModules\src\DependencyModules.Testing\DependencyModules.Testing.csproj')"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj"/>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj"/>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Testing\Hardened.Requests.Testing.csproj"/>
    </ItemGroup>

</Project>
