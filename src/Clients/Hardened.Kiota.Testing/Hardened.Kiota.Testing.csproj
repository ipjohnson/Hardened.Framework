<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <!--
          Deliberately not IsAotCompatible. A test harness serializes whatever type a test hands it
          and builds clients over types it learns at run time, so the reflection is the feature
          rather than an oversight - and a testing package is referenced by test projects, which are
          never published ahead of time. Marking it would make the flag a claim about code no
          consumer will ever trim. See Hardened.Shared.Testing.csproj for the whole of it.
        -->
        <Description>Assert through a Kiota-generated client in a Hardened test: [assembly: KiotaTesting] builds every Kiota client over the pipeline for a test parameter, and reads what a call answered for Returns&lt;T&gt;().</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.Kiota.Testing</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <!--
             The two Kiota packages a client needs to be driven, and not Microsoft.Kiota.Bundle:
             the bundle exists to bring the serializers, and a generated client registers those
             itself in its own constructor. Adding it here would put a second copy of that
             decision in every test project.
        -->
        <PackageReference Include="Microsoft.Kiota.Abstractions"/>
        <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Hardened.Kiota.Testing.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj"/>
        <ProjectReference Include="..\..\Web\Hardened.Web.Testing\Hardened.Web.Testing.csproj"/>
    </ItemGroup>

</Project>
