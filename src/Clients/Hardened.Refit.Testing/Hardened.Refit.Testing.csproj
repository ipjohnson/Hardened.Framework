<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <!--
          Deliberately not IsAotCompatible. A test harness serializes whatever type a test hands it
          and builds clients over types it learns at run time, so the reflection is the feature
          rather than an oversight - and a testing package is referenced by test projects, which are
          never published ahead of time. Marking it would make the flag a claim about code no
          consumer will ever trim. See Hardened.Shared.Testing.csproj for the whole of it.
        -->
        <Description>Assert through a Refit client in a Hardened test: [assembly: RefitTesting] builds every Refit interface over the pipeline for a test parameter, and reads what a call answered for Returns&lt;T&gt;().</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.Refit.Testing</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <!--
             PrivateAssets="none" so Refit's analyzer reaches the test project too. Refit implements
             an interface with a source generator that runs in the project declaring it, and
             RestService.For finds that implementation by name - so a test project that took Refit
             only through this package, with the analyzer withheld, would build and then fail on the
             first call saying the generator did not run.
        -->
        <PackageReference Include="Refit" PrivateAssets="none"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Hardened.Refit.Testing.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj"/>
        <ProjectReference Include="..\..\Web\Hardened.Web.Testing\Hardened.Web.Testing.csproj"/>
    </ItemGroup>

</Project>
