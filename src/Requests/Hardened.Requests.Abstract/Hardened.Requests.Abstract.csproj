<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Description>Transport-agnostic request and response abstractions for the Hardened execution pipeline: IExecutionContext, IExecutionRequest, IExecutionResponse and IExecutionFilter.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.Requests.Abstract</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Primitives"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Shared\Hardened.Shared.Runtime\Hardened.Shared.Runtime.csproj"/>
    </ItemGroup>

    <!--
      Declares HardenedInvokeModule, because this package owns [HardenedFunction]. See
      Hardened.Functions.Runtime's targets for why the declaration follows the attribute rather than
      the runtime, and for why the path is buildTransitive/ and Package\.
    -->
    <ItemGroup>
        <Content Include="Package\Hardened.Requests.Abstract.targets">
            <Pack>true</Pack>
            <PackagePath>buildTransitive/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

</Project>
