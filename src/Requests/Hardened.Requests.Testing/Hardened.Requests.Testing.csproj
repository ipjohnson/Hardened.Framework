<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <!--
          Deliberately not IsAotCompatible. A test harness serializes whatever type a test hands it
          and builds clients over types it learns at run time, so the reflection is the feature
          rather than an oversight - and a testing package is referenced by test projects, which are
          never published ahead of time. Marking it would make the flag a claim about code no
          consumer will ever trim. See Hardened.Shared.Testing.csproj for the whole of it.
        -->
        <Description>Test doubles for the Hardened execution pipeline, and the shared transport conformance suite every IExecutionRequest implementation is held to.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.Requests.Testing</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Primitives"/>
        <!-- Referenced directly rather than relied on transitively through
             Hardened.Shared.Testing, because the Conformance suite exposes xUnit types
             (Fact, Assert) as part of this package's public surface.

             The extensibility surface only: this is a shipped library that other people's test
             projects reference, not a test project itself, and xunit.v3 pulls in
             xunit.v3.core.mtp-v1, whose targets hard-error unless the project is an executable
             test project. Microsoft.NET.Test.Sdk went with it for the same reason. -->
        <PackageReference Include="xunit.v3.extensibility.core"/>
        <!-- Assert is not part of the extensibility surface; the Conformance suite asserts. -->
        <PackageReference Include="xunit.v3.assert"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Shared\Hardened.Shared.Runtime\Hardened.Shared.Runtime.csproj"/>
        <ProjectReference Include="..\..\Shared\Hardened.Shared.Testing\Hardened.Shared.Testing.csproj"/>
        <ProjectReference Include="..\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj"/>
        <ProjectReference Include="..\Hardened.Requests.Runtime\Hardened.Requests.Runtime.csproj"/>
    </ItemGroup>

</Project>
