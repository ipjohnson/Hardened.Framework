<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../SourceGenerators/BuildTask.props"/>

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <!-- A task assembly is loaded into MSBuild, which supplies its own copies of these. -->
        <NoWarn>$(NoWarn);NU1701</NoWarn>
    </PropertyGroup>

    <!-- init-only properties on records need this on the older framework, and only there. -->
    <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
        <Compile Remove="IsExternalInit.cs"/>
    </ItemGroup>

</Project>
