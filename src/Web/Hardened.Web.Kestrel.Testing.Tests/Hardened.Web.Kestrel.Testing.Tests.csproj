<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <!-- The running-test seam, installed by RunnerSeam.cs: these tests drive the host directly and declare no [ModuleTest]. -->
        <ProjectReference Include="$(DependencyModulesRoot)\src\DependencyModules.xUnit4\DependencyModules.xUnit4.csproj"
                          Condition="'$(UseLocalDependencyModules)' == 'true'"/>
        <PackageReference Include="DependencyModules.xUnit4"
                          Condition="'$(UseLocalDependencyModules)' != 'true'"/>
        <ProjectReference Include="..\Hardened.Web.Kestrel.Testing\Hardened.Web.Kestrel.Testing.csproj"/>
    </ItemGroup>

</Project>
