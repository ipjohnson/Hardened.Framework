<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Description>[KestrelHost] for a Hardened test: runs the test's application on Kestrel, over the test's own container, on a loopback port the kernel picks, with ITestWebApp and every client the harness hands out sending to that socket.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>Hardened.Web.Kestrel.Testing</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Hardened.Web.Kestrel.Testing.Tests"/>
    </ItemGroup>

    <!--
      Its own package rather than part of Hardened.Web.Testing, because the Kestrel host brings the
      ASP.NET Core shared framework with it and a test project that stays on the pipeline must not
      be forced onto it - the arrangement Hardened.Kiota.Testing has for the same reason.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\Requests\Hardened.Requests.Abstract\Hardened.Requests.Abstract.csproj"/>
        <ProjectReference Include="..\..\Shared\Hardened.Shared.Runtime\Hardened.Shared.Runtime.csproj"/>
        <ProjectReference Include="..\Hardened.Web.Kestrel.Runtime\Hardened.Web.Kestrel.Runtime.csproj"/>
        <ProjectReference Include="..\Hardened.Web.Testing\Hardened.Web.Testing.csproj"/>
    </ItemGroup>

</Project>
