<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(HardenedTargetFramework)</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <!-- To compile what the emitter writes, which is the only way to know it compiles. -->
        <!-- Ahead of the 4.10.0 every generator in the repository compiles against. Left where it was
             rather than moved either way: what the generators emit depends on the Roslyn they are
             built with, and this is a test project rather than one of them. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.11.0"/>
        <!-- To stand a task up with a recording build engine, which is the only way to see what it
             logs. ExcludeAssets="runtime" is what the task project does; here the assemblies are
             wanted at run time too. -->
        <PackageReference Include="Microsoft.Build.Framework"/>
        <PackageReference Include="Microsoft.Build.Utilities.Core"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.Web.StaticContent.BuildTask\Hardened.Web.StaticContent.BuildTask.csproj" SetTargetFramework="TargetFramework=net8.0"/>
        <!-- Referenced so the emitted manifest has something to compile against. -->
        <ProjectReference Include="..\Hardened.Web.StaticContent\Hardened.Web.StaticContent.csproj"/>
    </ItemGroup>

</Project>
