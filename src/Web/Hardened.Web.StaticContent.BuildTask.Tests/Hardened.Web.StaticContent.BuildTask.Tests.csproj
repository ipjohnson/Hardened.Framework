<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <!-- To compile what the emitter writes, which is the only way to know it compiles. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
        <!-- To stand a task up with a recording build engine, which is the only way to see what it
             logs. ExcludeAssets="runtime" is what the task project does; here the assemblies are
             wanted at run time too. -->
        <PackageReference Include="Microsoft.Build.Framework" Version="17.8.43" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.8.43" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hardened.Web.StaticContent.BuildTask\Hardened.Web.StaticContent.BuildTask.csproj" SetTargetFramework="TargetFramework=net8.0"/>
        <!-- Referenced so the emitted manifest has something to compile against. -->
        <ProjectReference Include="..\Hardened.Web.StaticContent\Hardened.Web.StaticContent.csproj"/>
    </ItemGroup>

</Project>
