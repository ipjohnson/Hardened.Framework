# report CS1001. They are formatted to match the rest of the repository, by hand, and nothing
# checks that they stay that way. Match the surrounding style when you edit them.
# Revisit when CSharpier picks up a Roslyn that knows the syntax.
src/IntegrationTests/Union/Hardened.IntegrationTests.Union.SUT/TodoController.cs
src/Templates/Hardened.Templates/templates/hardened-web/src/Hardened1/TodoController.cs

