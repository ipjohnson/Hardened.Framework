<?xml version="1.0" encoding="utf-8"?>
<!--
    nuget.org only.

    GitHub Packages was configured here for one reason: ValidationModules was published only there.
    It is on nuget.org from 0.1.0-alpha.1, and everything else this solution restores always was.

    An authenticated source is not free to keep around. NuGet treats an unreachable source as fatal,
    so the feed answering 401 failed the whole restore - including for packages it does not serve -
    and the credential it needed was easy to have present when the config was written and gone by
    the time restore ran.

    Publishing is unaffected: the workflow's push step names its feed and its key on the command
    line, and reads neither from here.
-->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>
